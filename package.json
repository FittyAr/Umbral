{
  "name": "umbral",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "description": "Umbral — self-hosted portal to internal apps behind a VPN. Editable from a simple admin panel. No database.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "prebuild": "npm run gen:icons",
    "predev": "npm run gen:icons",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test:icon-packs": "node --test --experimental-strip-types tests/icon-packs.test.ts",
    "test:theme": "node --test --experimental-strip-types tests/theme.test.ts",
    "test:i18n": "node --test --experimental-strip-types tests/i18n.test.ts",
    "test:markdown": "node --test --experimental-strip-types tests/markdown.test.ts",
    "test:layout": "node --test --experimental-strip-types tests/layout.test.ts",
    "test:cards": "node --test --experimental-strip-types tests/cards.test.ts",
    "test:card-span": "node --test --experimental-strip-types tests/card-span.test.ts",
    "test:icon-url": "node --test --experimental-strip-types tests/icon-url.test.ts",
    "test:sortable-guard": "node --test --experimental-strip-types tests/sortable-guard.test.ts",
    "test:auth-session": "node --test --experimental-strip-types tests/auth-session.test.ts",
    "test:offline": "node --test --experimental-strip-types tests/offline.test.ts",
    "test:client-config": "node --test --experimental-strip-types tests/client-config.test.ts",
    "test:animations": "node --test --experimental-strip-types tests/animations.test.ts",
    "test:admin-alpine": "node --test --experimental-strip-types tests/admin-alpine.test.ts",
    "test:config-gating": "node --test --experimental-strip-types tests/config-gating.test.ts",
    "test:lib-shared": "node --test --experimental-strip-types tests/lib-shared.test.ts",
    "test:astro": "vitest run",
    "test": "npm run test:astro && npm run test:client-config && npm run test:admin-alpine && npm run test:config-gating && npm run test:lib-shared && npm run test:offline && npm run test:animations && npm run test:icon-packs && npm run test:theme && npm run test:layout && npm run test:cards && npm run test:card-span && npm run test:icon-url && npm run test:sortable-guard && npm run test:auth-session && npm run test:i18n && npm run test:markdown",
    "astro": "astro"
  },
  "dependencies": {
    "@astroanimate/core": "^0.1.2",
    "@astrojs/node": "^11.1.0",
    "adm-zip": "^0.6.0",
    "alpinejs": "^3.14.9",
    "astro": "^7.2.0",
    "bcryptjs": "^2.4.3",
    "dompurify": "^3.2.4",
    "file-type": "^22.0.1",
    "jsdom": "^26.1.0",
    "marked": "^14.1.3",
    "otpauth": "^9.3.6",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "sortablejs": "^1.15.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/adm-zip": "^0.5.8",
    "@types/alpinejs": "^3.13.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.8",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "//": "Security overrides: forzar versiones parcheadas en transitive deps (alerts Dependabot). El override de @astroanimate/core es distinto: su peerDependency llega hasta astro 6 y el proyecto esta en 7, y sus componentes no tocan APIs internas de Astro, asi que se fuerza el peer al astro del proyecto en vez de instalar con --legacy-peer-deps, que dejaria el lockfile sin resolver.",
  "overrides": {
    "nanoid": "^3.3.18",
    "@astroanimate/core": {
      "astro": "$astro"
    }
  }
}
