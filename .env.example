# Copy to .env and customize. Used by docker-compose.

# External port (host): container port 4321
PORT=3000

# SESSION_SECRET is required (min 32 chars). docker compose refuses to start without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Initial admin password. Hashed and stored on first boot.
# Leave empty to fall back to default "admin" (warning logged).
INITIAL_PASSWORD=

# Full base URL (optional). When set with https://, cookies get Secure flag.
# BASE_URL=https://home.example.internal
