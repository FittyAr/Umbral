---
import '~/styles/global.css';
import '~/styles/admin.css';
import '~/styles/admin-theme.css';
import '~/styles/admin-layout.css';
import '~/styles/admin-cards.css';
import ThemeScript from '~/components/ThemeScript.astro';
import { getConfig } from '~/lib/config';
import { isFeatureEnabled } from '~/lib/features';
import { buildBootData } from '~/lib/client-config';
import JsonData from '~/components/JsonData.astro';
import { ThemeSchema } from '~/lib/schema';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';

interface Props {
  title: string;
  csrfToken: string | null;
  isAuthed: boolean;
  showNav?: boolean;
}
const { title, csrfToken, isAuthed, showNav = true } = Astro.props;

// `base` viene de Astro (process.env.ASTRO_BASE / config base). En producción
// con deploy en subpath se setea vía env. En demo estática (GitHub Pages)
// suele ser "/" o el subpath del repo. Lo exponemos en window.__BASE_URL__
// para que el client lo use al construir URLs de fetch (ej: /api/...).
const base = import.meta.env.BASE_URL || '/';

// Modo demo: cuando UMBRAL_DEMO=true (build estático de GitHub Pages), el
// dashboard se renderiza siempre "logueado" y se carga el demo-runtime.js
// (un interceptor de window.fetch que simula el backend en localStorage).
// La página de login NO entra en demo (así el visitante puede ver el form).
const isDemoBuild = import.meta.env.UMBRAL_DEMO === 'true' || import.meta.env.UMBRAL_DEMO === '1';
// Si la prop `isAuthed` viene como true pero estamos en el form de login
// (showNav=false), respetamos la prop. Si showNav=true y la prop es false,
// en demo build forzamos isAuthed=true para que se vea el dashboard.
const effectiveAuthed = isDemoBuild && showNav ? true : isAuthed;

// i18n: resolvemos el locale para este admin render. El admin también
// se traduce — si el admin está navegando en inglés, todo el panel se
// ve en inglés. Si la feature está apagada, queda en español.
const config = await getConfig();
const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = t(locale);

const bootData = buildBootData({ base, isDemoBuild, config, portalId: Astro.locals.portal?.id });

// Tema fijo del panel; ThemeSchema completa el resto de los campos con sus
// defaults (ThemeScript espera un Theme entero).
const theme = ThemeSchema.parse({
  colorMode: 'auto',
  accentColor: '#60a5fa',
  textColor: '#f1f5f9',
  fontFamily: 'Inter',
  fontUrl: '',
  background: { type: 'color', value: '#0b1220', blur: 0, overlay: 0, overlayColor: '#000' },
  cardStyle: 'flat',
});
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Admin</title>
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-body" data-csrf={csrfToken ?? ''} data-authed={effectiveAuthed ? '1' : '0'} data-demo={isDemoBuild ? '1' : '0'}>
    {showNav && effectiveAuthed ? (
      <div class="admin-shell" x-data="adminApp" x-init="init()">
        <nav class="admin-nav">
          <a href={base} class="nav-home" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            {useI18n ? trf('admin.nav.home') : 'Ver portada'}
          </a>
          <span class="nav-divider"></span>
          <span class="nav-title">{useI18n ? trf('admin.nav.title') : 'Admin'}</span>
          <div class="nav-actions">
            <span x-show="dirty" class="dirty-badge" x-cloak x-text="dirtyLabel()">● Cambios sin guardar</span>
            <button type="button" class="btn btn-sm btn-ghost" @click="reloadConfig()" :disabled="busy" x-text="reloadLabel()">Recargar</button>
            <button type="button" class="btn btn-sm btn-primary" @click="saveAll()" :disabled="busy || !dirty">
              <span x-show="!busy" x-text="saveLabel()">Guardar cambios</span>
              <span x-show="busy" x-cloak x-text="savingLabel()">Guardando…</span>
            </button>
            <span class="nav-divider"></span>
            <button
              data-action="toggle-mode"
              class="mode-toggle-admin"
              aria-label={useI18n ? trf('admin.nav.modeToggle') : 'Cambiar modo claro/oscuro'}
              title={useI18n ? trf('admin.nav.modeToggle') : 'Cambiar modo claro/oscuro'}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
              </svg>
            </button>
            <button data-action="logout" class="btn btn-sm btn-ghost">{useI18n ? trf('admin.nav.logout') : 'Cerrar sesión'}</button>
          </div>
        </nav>
        <main class="admin-main">
          <slot />
        </main>
      </div>
    ) : (
      <slot />
    )}

    {/* Apply the same light/dark toggle the public pages use, so the admin
        follows the user's preference and stays coherent across the platform.
        Pasamos config + request para que el toggle use el locale correcto. */}
    <ThemeScript theme={theme} config={config} request={Astro.request} />

    {/* Datos de boot (JSON, no se ejecuta) + boot.js, que los vuelca a
        window. En builds de demo (GitHub Pages), también cargamos
        demo-runtime.js, que intercepta window.fetch y simula el backend.
        Ninguno es inline: la CSP no necesita 'unsafe-inline' en script-src. */}
    <JsonData id="umbral-boot" data={bootData} />
    <script is:inline src={`${base}js/boot.js`}></script>
    {isDemoBuild && <script is:inline src={`${base}demo-runtime.js`}></script>}

    {/* Helpers globales del admin (fetch wrapper, toast, trap de foco). */}
    <script>
      import '~/scripts/admin/client';
    </script>
  </body>
</html>

