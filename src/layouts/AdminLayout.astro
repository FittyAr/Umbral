---
import '~/styles/global.css';
import '~/styles/admin.css';
import ThemeScript from '~/components/ThemeScript.astro';
import { getConfig } from '~/lib/config';
import { isFeatureEnabled } from '~/lib/features';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';

interface Props {
  title: string;
  csrfToken: string | null;
  isAuthed: boolean;
  showNav?: boolean;
}
const { title, csrfToken, isAuthed, showNav = true } = Astro.props;

// i18n: resolvemos el locale para este admin render. El admin también
// se traduce — si el admin está navegando en inglés, todo el panel se
// ve en inglés. Si la feature está apagada, queda en español.
const config = await getConfig();
const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = t(locale);

const theme = {
  colorMode: 'auto' as 'light' | 'dark' | 'auto',
  accentColor: '#60a5fa',
  textColor: '#f1f5f9',
  fontFamily: 'Inter',
  fontUrl: null as string | null,
  background: { type: 'color' as const, value: '#0b1220', blur: 0, overlay: 0, overlayColor: '#000' },
  cardStyle: 'flat' as 'flat' | 'glass' | 'outlined',
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Admin</title>
    <link rel="icon" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-body" data-csrf={csrfToken ?? ''} data-authed={isAuthed ? '1' : '0'}>
    {showNav && isAuthed ? (
      <div class="admin-shell" x-data="adminApp" x-init="init()">
        <nav class="admin-nav">
          <a href="/" class="nav-home" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            {useI18n ? trf('admin.nav.home') : 'Ver portada'}
          </a>
          <span class="nav-divider"></span>
          <span class="nav-title">{useI18n ? trf('admin.nav.title') : 'Admin'}</span>
          <div class="nav-actions">
            <span x-show="dirty" class="dirty-badge" x-cloak x-text="dirtyLabel()">● Cambios sin guardar</span>
            <button type="button" class="btn btn-sm btn-ghost" @click="reloadConfig()" :disabled="busy" x-text="reloadLabel()">Recargar</button>
            <button type="button" class="btn btn-sm btn-primary" @click="saveAll()" :disabled="busy || !dirty">
              <span x-show="!busy" x-text="saveLabel()">Guardar cambios</span>
              <span x-show="busy" x-cloak x-text="savingLabel()">Guardando…</span>
            </button>
            <span class="nav-divider"></span>
            <button
              data-action="toggle-mode"
              class="mode-toggle-admin"
              aria-label={useI18n ? trf('admin.nav.modeToggle') : 'Cambiar modo claro/oscuro'}
              title={useI18n ? trf('admin.nav.modeToggle') : 'Cambiar modo claro/oscuro'}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
              </svg>
            </button>
            <button data-action="logout" class="btn btn-sm btn-ghost">{useI18n ? trf('admin.nav.logout') : 'Cerrar sesión'}</button>
          </div>
        </nav>
        <slot />
      </div>
    ) : (
      <slot />
    )}

    {/* Apply the same light/dark toggle the public pages use, so the admin
        follows the user's preference and stays coherent across the platform.
        Pasamos config + request para que el toggle use el locale correcto. */}
    <ThemeScript theme={theme} config={config} request={Astro.request} />

    {/* Global admin helpers (Alpine.js, fetch wrapper, toast) */}
    <script is:inline>
      // Define window.umbralAdmin BEFORE any module scripts run.
      // Using is:inline so Vite doesn't bundle/move this — guarantees it executes
      // synchronously during HTML parsing, before the page's module script imports.
      window.umbralAdmin = {
        csrf: document.body.dataset.csrf || '',
        authed: document.body.dataset.authed === '1',
        async api(method, url, body) {
          const csrf = this.csrf;
          const headers = { 'content-type': 'application/json', 'x-csrf-token': csrf };
          const res = await fetch(url, {
            method,
            headers,
            body: body ? JSON.stringify(body) : undefined,
          });
          if (res.status === 401) { window.location.href = '/admin'; return null; }
          if (res.status === 204) return null;
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
          return data;
        },
        toast(message, type = 'info') {
          let host = document.getElementById('toast-host');
          if (!host) {
            host = document.createElement('div');
            host.id = 'toast-host';
            document.body.appendChild(host);
          }
          const t = document.createElement('div');
          t.className = `toast toast-${type}`;
          t.textContent = message;
          host.appendChild(t);
          setTimeout(() => t.classList.add('show'), 10);
          setTimeout(() => {
            t.classList.remove('show');
            setTimeout(() => t.remove(), 300);
          }, 3500);
        },
      };
      // Wire logout
      document.addEventListener('click', async (e) => {
        const target = e.target;
        if (target && target instanceof Element && target.closest('[data-action="logout"]')) {
          await fetch('/api/logout', { method: 'POST', headers: { 'x-csrf-token': window.umbralAdmin.csrf } });
          window.location.href = '/admin';
        }
      });
    </script>
  </body>
</html>
