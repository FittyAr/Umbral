---
import type { Config } from '~/lib/schema';
import { resolveIconUrl } from '~/lib/icons';
import ThemeScript from '~/components/ThemeScript.astro';
import { isFeatureEnabled } from '~/lib/features';
import { t as tr, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';
import '~/styles/global.css';

interface Props {
  config: Config;
  title?: string;
}
const { config, title } = Astro.props;
const t = config.theme;
const l = config.layout;
const base = import.meta.env.BASE_URL || '/';
const logoUrl = resolveIconUrl(config.branding.logo);
const faviconUrl = resolveIconUrl(config.branding.favicon);

const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = tr(locale);

const themeVars = [
  `--accent:${t.accentColor}`,
  `--text:${t.textColor}`,
  `--font:'${t.fontFamily}', system-ui, -apple-system, 'Segoe UI', sans-serif`,
].join(';');

const gridStyle = `--cols-mobile:${l.columnsMobile};--cols-tablet:${l.columnsTablet};--cols-desktop:${l.columnsDesktop};`;

const fullTitle = title || config.branding.companyName;
const metaDescription = useI18n
  ? trf('home.meta.description', { companyName: config.branding.companyName })
  : `Inicio rápido — ${config.branding.companyName}`;
const ogDescription = useI18n ? trf('home.meta.ogDescription') : 'Panel de accesos internos';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content={t.accentColor} />

    {faviconUrl && <link rel="icon" href={faviconUrl} />}
    <link rel="manifest" href={`${base}manifest.webmanifest`} />

    {/* Open Graph / Twitter */}
    <meta property="og:title" content={config.branding.companyName} />
    <meta property="og:description" content={ogDescription} />
    {logoUrl && <meta property="og:image" content={logoUrl} />}
    <meta name="twitter:card" content="summary" />

    {t.fontUrl && <link rel="stylesheet" href={t.fontUrl} />}

    <style is:inline set:html={`:root{${themeVars}}`}></style>
    <style is:inline set:html={`.page-wrap{${gridStyle}}`}></style>
  </head>
  <body>
    <slot />

    <div class="bg-layer" style={t.background.type === 'image' ? `background-image:url('${t.background.value}');${t.background.blur > 0 ? `filter:blur(${t.background.blur}px);` : ''}` : `background:${t.background.value};${t.background.blur > 0 ? `filter:blur(${t.background.blur}px);` : ''}`}></div>
    {t.background.overlay > 0 && (
      <div class="bg-overlay" style={`background:${t.background.overlayColor};opacity:${t.background.overlay};`}></div>
    )}

    <ThemeScript theme={t} config={config} request={Astro.request} />
    <script is:inline set:html={`window.__BASE_URL__ = ${JSON.stringify(base)}; window.__INITIAL_DEMO_CONFIG__ = ${JSON.stringify(config)};`}></script>
    <script is:inline src={`${base}demo-runtime.js`}></script>
  </body>
</html>
