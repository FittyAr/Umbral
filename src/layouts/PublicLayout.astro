---
import type { Config } from '~/lib/schema';
import { resolveIconUrl } from '~/lib/icons';
import ThemeScript from '~/components/ThemeScript.astro';
import { isFeatureEnabled } from '~/lib/features';
import { computeThemeCssBlocks, computeBackgroundStyle, resolveBackground } from '~/lib/theme-tokens';
import { t as tr, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';
import '~/styles/global.css';

interface Props {
  config: Config;
  title?: string;
}
const { config, title } = Astro.props;
const t = config.theme;
const l = config.layout;
const logoUrl = resolveIconUrl(config.branding.logo);
const faviconUrl = resolveIconUrl(config.branding.favicon);

// `base` respeta el subpath del deploy (ej: /umbral/) y se expone en el
// cliente como window.__BASE_URL__. En el demo de GitHub Pages base = '/'.
const base = import.meta.env.BASE_URL || '/';

// UMBRAL_DEMO=true → build de GitHub Pages. En ese caso, cargamos
// demo-runtime.js (interceptor de fetch que simula el backend en
// localStorage) y exponemos la config inicial en window.__INITIAL_DEMO_CONFIG__.
// En producción real, este flag queda en false y no se carga el runtime.
const isDemoBuild = import.meta.env.UMBRAL_DEMO === 'true' || import.meta.env.UMBRAL_DEMO === '1';

// Feature i18n: si está activa, resolvemos el locale para este request.
// Si está apagada, todo el UI permanece en español (locale histórico).
const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = tr(locale);

// Theme variables injected as inline style
const cssBlocks = computeThemeCssBlocks(t);
const bgDarkStyle = computeBackgroundStyle(t.background);
const bgLightStyle = computeBackgroundStyle(resolveBackground(t, 'light'));
const bgLightResolved = resolveBackground(t, 'light');

function overlayStyle(bg: typeof t.background): string {
  if (bg.overlay <= 0) return 'opacity:0;display:none;pointer-events:none;';
  return `background:${bg.overlayColor};opacity:${bg.overlay};`;
}
const sharedStyle = [
  cssBlocks.shared,
  t.headerOpacity < 1 ? `--header-opacity:${t.headerOpacity}` : '',
  t.footerOpacity < 1 ? `--footer-opacity:${t.footerOpacity}` : '',
  t.tokens?.shared?.cardBlur !== undefined ? `--card-blur:${t.tokens.shared.cardBlur}px` : '',
  t.tokens?.shared?.cardBorderWidth !== undefined ? `--card-border-width:${t.tokens.shared.cardBorderWidth}px` : '',
].filter(Boolean).join(';');

const gridStyle = [
  `--cols-mobile:${l.columnsMobile}`,
  `--cols-tablet:${l.columnsTablet}`,
  `--cols-desktop:${l.columnsDesktop}`,
  `--grid-gap:${l.gap}rem`,
  `--content-max-width:${l.maxWidth}px`,
  `--card-radius:${l.cardRadius}px`,
].join(';');

const fullTitle = title || config.branding.companyName;
const metaDescription = useI18n
  ? trf('home.meta.description', { companyName: config.branding.companyName })
  : `Inicio rápido — ${config.branding.companyName}`;
const ogDescription = useI18n ? trf('home.meta.ogDescription') : 'Panel de accesos internos';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content={t.accentColor} />

    {faviconUrl && <link rel="icon" href={faviconUrl} />}
    <link rel="manifest" href={`${base}manifest.webmanifest`} />

    {/* Open Graph / Twitter */}
    <meta property="og:title" content={config.branding.companyName} />
    <meta property="og:description" content={ogDescription} />
    {logoUrl && <meta property="og:image" content={logoUrl} />}
    <meta name="twitter:card" content="summary" />

    {t.fontUrl && <link rel="stylesheet" href={t.fontUrl} />}

    <style is:inline set:html={`:root{${cssBlocks.root}${sharedStyle ? ';' + sharedStyle : ''}}`}></style>
    {cssBlocks.light && <style is:inline set:html={`html[data-mode="light"]{${cssBlocks.light}}`}></style>}
    <style is:inline set:html={`.page-wrap{${gridStyle}}`}></style>
    {t.fontWeight && t.fontWeight !== '400' && (
      <style is:inline set:html={`body{font-weight:${t.fontWeight}}`}></style>
    )}
  </head>
  <body data-demo={isDemoBuild ? '1' : '0'}>
    <slot />

    {/* Background as last child so it sits behind everything via fixed positioning */}
    <div class="bg-layer" data-bg-mode="dark" style={bgDarkStyle}></div>
    <div class="bg-layer" data-bg-mode="light" style={bgLightStyle}></div>
    <div class="bg-overlay" data-bg-mode="dark" style={overlayStyle(t.background)}></div>
    <div class="bg-overlay" data-bg-mode="light" style={overlayStyle(bgLightResolved)}></div>

    {/* Inline JS: color mode, search, keyboard shortcuts */}
    <ThemeScript theme={t} config={config} request={Astro.request} />

    {/* Demo runtime: sólo en builds de GitHub Pages (UMBRAL_DEMO=true).
        Intercepta window.fetch y simula el backend con localStorage. */}
    <script is:inline set:html={`window.__BASE_URL__ = ${JSON.stringify(base)}; window.__INITIAL_DEMO_CONFIG__ = ${JSON.stringify(config)}; window.__UMBRAL_DEMO__ = ${isDemoBuild ? 'true' : 'false'};`}></script>
    {isDemoBuild && <script is:inline src={`${base}demo-runtime.js`}></script>}
  </body>
</html>
