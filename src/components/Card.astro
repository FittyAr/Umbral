---
import type { Card } from '~/lib/schema';
import type { Layout, Theme } from '~/lib/schema';
import { resolveCardIconUrl } from '~/lib/icon-url';
import { renderMarkdown } from '~/lib/markdown';
import { isFeatureEnabled } from '~/lib/features';
import { getConfig } from '~/lib/config';

interface Props {
  card: Card;
  layout: Layout;
  cardStyle?: Theme['cardStyle'];
  /** Si la card está en una maintenance window activa, razón para el badge.
   *  String vacío = no está en mantenimiento. */
  maintenanceReason?: string;
  /** Si la feature features.qr está activa y la card es de tipo link. */
  qrEnabled?: boolean;
  /** Label i18n del badge "Nota" (kind=note). */
  noteBadge?: string;
  /** Tinte de íconos del tema. Si no viene, se resuelve del config. */
  iconTint?: string;
  /** ¿Está activa la feature markdown? Si no viene, se resuelve del config. */
  markdownEnabled?: boolean;
}
const {
  card,
  layout,
  cardStyle = 'glass',
  maintenanceReason = '',
  qrEnabled = false,
  noteBadge = '',
  iconTint: iconTintProp,
  markdownEnabled: markdownEnabledProp,
} = Astro.props;
const base = import.meta.env.BASE_URL || '/';
// El componente pedía el config dos veces por tarjeta (acá y en
// renderDescription). Está cacheado, pero con 40 tarjetas eran 80 idas al
// cache por render. Las páginas ya tienen el config, así que se lo pasan; el
// fallback queda para los callers que renderizan una tarjeta sola.
const needsConfig = iconTintProp === undefined || markdownEnabledProp === undefined;
const cfg = needsConfig ? await getConfig() : null;
const iconTint = iconTintProp ?? cfg!.theme.iconTint ?? 'original';
const markdownEnabled = markdownEnabledProp ?? isFeatureEnabled(cfg!, 'markdown');
const qrBase = base.endsWith('/') ? base : `${base}/`;
const qrUrl = `${qrBase}api/qr/${encodeURIComponent(card.id)}.png?size=240`;
const rawIconUrl = resolveCardIconUrl(card);
const iconUrl = rawIconUrl
  ? (rawIconUrl.startsWith('/') ? `${base.endsWith('/') ? base.slice(0, -1) : base}${rawIconUrl}` : rawIconUrl)
  : null;
const iconTintActive = iconTint !== 'original' && iconUrl;
const iconWrapStyle = iconTintActive ? `--icon-url:url('${iconUrl}');` : '';
const isNote = card.kind === 'note';

// Markdown rendering: si descriptionFormat === 'markdown' y la feature
// está activa, parseamos con marked y sanitizamos con DOMPurify antes de
// inyectar el HTML. Si la feature está apagada o el format es 'plain',
// el render es plain text (escapeado por Astro).
//
// DOMPurify necesita un window-like. Usamos jsdom (ya en deps) para
// crearlo en el server. El window está cacheado por proceso para no pagar
// el costo de JSDOM en cada render de card.
/** Render seguro de la descripción: HTML sanitizado para markdown, o el
 *  string plano (que Astro escapa) para plain. */
function renderDescription(desc: string, format: 'plain' | 'markdown' | undefined): string {
  if (!desc) return '';
  if (format === 'markdown' && markdownEnabled) return renderMarkdown(desc);
  return desc;
}

// Para notas: no target/rel (no es link), no href. Se renderiza como un div.
// Para links: target/rel según openInNewTab, href = card.url.
const styleOverride = card.color
  ? `--accent:${card.color};`
  : '';
const baseClass = isNote ? 'card card-note' : 'card';
// Sólo lo emitimos cuando pide más de una columna: PublicLayout genera las
// reglas `.grid>[data-span="N"]` recortadas a las columnas configuradas.
const spanAttr = card.span && card.span > 1 ? String(card.span) : undefined;

const descriptionHtml = renderDescription(card.description, card.descriptionFormat);
---
{isNote ? (
  <div
    class={baseClass}
    data-style={cardStyle}
    data-size={layout.cardSize}
    data-card-id={card.id}
    data-card-kind="note"
    data-span={spanAttr}
    data-health-check="false"
    data-format={card.descriptionFormat || 'plain'}
    data-tags={card.tags?.length ? card.tags.join(' ') : ''}
    title={card.title}
    style={styleOverride}
  >
    {noteBadge ? <span class="card-note-badge">{noteBadge}</span> : null}
    {iconUrl && (
      <div class="card-icon" data-icon-tint={iconTintActive ? iconTint : undefined} style={iconWrapStyle}>
        <img src={iconUrl} alt="" loading="lazy" />
      </div>
    )}
    {/* QR button (opt-in: features.qr). Sólo links (no notes). Se posiciona
        absolute top-right para no interferir con el ícono. El user hace
        click → abre el PNG en una nueva tab (más simple que un modal). */}
    {qrEnabled && card.kind === 'link' ? (
      <a
        class="card-qr-btn"
        href={qrUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Ver QR de esta card"
        aria-label="Ver QR"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"/>
          <rect x="14" y="3" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/>
          <line x1="14" y1="14" x2="14" y2="17"/>
          <line x1="14" y1="20" x2="17" y2="20"/>
          <line x1="14" y1="20" x2="17" y2="20"/>
          <line x1="20" y1="14" x2="20" y2="17"/>
          <line x1="20" y1="20" x2="20" y2="20"/>
        </svg>
      </a>
    ) : null}
    {/* Badge ámbar de mantenimiento (opt-in: features.maintenanceWindows).
        Render condicional — si maintenanceReason es '' (default), no aparece. */}
    {maintenanceReason ? (
      <span class="card-maintenance-badge" title={maintenanceReason} aria-label={`En mantenimiento: ${maintenanceReason}`}>
        🔧 {maintenanceReason}
      </span>
    ) : null}
    <h3 class="card-title">
      {/* Pinned indicator (opt-in: features.pinned). El server fuerza
          pinned=false si la feature está apagada, así que sólo se renderiza
          cuando el card REALMENTE es pinned. */}
      {card.pinned ? <span class="card-pinned-pin" aria-label="Fijada" title="Fijada">📌</span> : null}
      {card.title}
    </h3>
    {layout.showDescriptions && card.description && (
      card.descriptionFormat === 'markdown' && descriptionHtml
        ? <div class="card-desc card-desc-md" set:html={descriptionHtml} />
        : <p class="card-desc">{card.description}</p>
    )}
  </div>
) : (
  <a
    class={baseClass}
    data-style={cardStyle}
    data-size={layout.cardSize}
    data-card-id={card.id}
    data-card-kind="link"
    data-span={spanAttr}
    data-health-check={card.healthCheck ? 'true' : 'false'}
    data-format={card.descriptionFormat || 'plain'}
    data-tags={card.tags?.length ? card.tags.join(' ') : ''}
    href={card.url}
    target={card.openInNewTab ? '_blank' : '_self'}
    rel={card.openInNewTab ? 'noopener noreferrer' : undefined}
    title={card.title}
    style={styleOverride}
  >
    {iconUrl && (
      <div class="card-icon" data-icon-tint={iconTintActive ? iconTint : undefined} style={iconWrapStyle}>
        <img src={iconUrl} alt="" loading="lazy" />
      </div>
    )}
    {/* QR button (opt-in: features.qr). Sólo links (no notes). Se posiciona
        absolute top-right para no interferir con el ícono. El user hace
        click → abre el PNG en una nueva tab (más simple que un modal). */}
    {/* Es un `<button>` y no un `<a>` porque está dentro del `<a>` de la
        tarjeta, y un link anidado es HTML inválido. La URL va en un
        data-attribute: el `onclick` inline que había antes construía JS por
        concatenación de strings y obligaba a habilitar 'unsafe-inline'. */}
    {qrEnabled && card.kind === 'link' ? (
      <button
        type="button"
        class="card-qr-btn"
        data-qr-url={qrUrl}
        title="Ver QR de esta card"
        aria-label="Ver QR"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"/>
          <rect x="14" y="3" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/>
          <line x1="14" y1="14" x2="14" y2="17"/>
          <line x1="14" y1="20" x2="17" y2="20"/>
          <line x1="14" y1="20" x2="17" y2="20"/>
          <line x1="20" y1="14" x2="20" y2="17"/>
          <line x1="20" y1="20" x2="20" y2="20"/>
        </svg>
      </button>
    ) : null}
    {/* Badge ámbar de mantenimiento (opt-in: features.maintenanceWindows).
        Render condicional — si maintenanceReason es '' (default), no aparece. */}
    {maintenanceReason ? (
      <span class="card-maintenance-badge" title={maintenanceReason} aria-label={`En mantenimiento: ${maintenanceReason}`}>
        🔧 {maintenanceReason}
      </span>
    ) : null}
    <h3 class="card-title">
      {card.pinned ? <span class="card-pinned-pin" aria-label="Fijada" title="Fijada">📌</span> : null}
      {card.title}
    </h3>
    {layout.showDescriptions && card.description && (
      card.descriptionFormat === 'markdown' && descriptionHtml
        ? <div class="card-desc card-desc-md" set:html={descriptionHtml} />
        : <p class="card-desc">{card.description}</p>
    )}
  </a>
)}

<script>
  // Delegado en el documento: un listener para todas las tarjetas, en vez de
  // un handler inline por tarjeta.
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement)?.closest<HTMLElement>('.card-qr-btn[data-qr-url]');
    if (!btn) return;
    event.preventDefault();
    event.stopPropagation();
    window.open(btn.dataset.qrUrl!, '_blank', 'noopener,noreferrer');
  });
</script>
