---
import type { Theme } from '~/lib/schema';
import type { Config } from '~/lib/schema';
import { isFeatureEnabled } from '~/lib/features';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';
import JsonData from '~/components/JsonData.astro';

interface Props {
  theme: Theme;
  config?: Config;
  request?: Request;
}
const { theme, config, request } = Astro.props;

const useI18n = config ? isFeatureEnabled(config, 'i18n') : false;
const locale: Locale = (useI18n && request)
  ? resolveLocale(request, config, readLocaleCookie(request))
  : 'es';
const trf = t(locale);
const labelToLight = useI18n ? trf('home.modeToggleToLight') : 'Cambiar a modo claro';
const labelToDark = useI18n ? trf('home.modeToggleToDark') : 'Cambiar a modo oscuro';
const previewBannerText = useI18n ? trf('admin.theme.preview.banner') : 'Modo preview — cambios no guardados';
const base = import.meta.env.BASE_URL || '/';
// Sólo lo que usa theme-mode.js: no hace falta mandar el tema entero.
const themeModeData = {
  theme: { colorMode: theme.colorMode, autoStrategy: theme.autoStrategy },
  labelToLight,
  labelToDark,
  previewBannerText,
};
---
{/* Config para public/js/theme-mode.js (modo claro/oscuro antes del primer
    paint, búsqueda, atajos). Externo y sincrónico: sin JS inline, la CSP no
    necesita 'unsafe-inline' en script-src. */}
<JsonData id="umbral-theme-mode" data={themeModeData} />
<script is:inline src={`${base}js/theme-mode.js`}></script>
<script>
  import { applyThemeDraft, THEME_PREVIEW_STORAGE_KEY } from '~/lib/theme-admin-client';

  const params = new URLSearchParams(window.location.search);
  const isPreview = params.get('themePreview') === '1';

  function applyDraftFromStorage() {
    const draft = localStorage.getItem(THEME_PREVIEW_STORAGE_KEY);
    if (draft) applyThemeDraft(draft);
  }

  if (isPreview) {
    applyDraftFromStorage();
    document.addEventListener('DOMContentLoaded', applyDraftFromStorage);
    window.addEventListener('storage', (e) => {
      if (e.key === THEME_PREVIEW_STORAGE_KEY && e.newValue) {
        applyThemeDraft(e.newValue);
      }
    });
  }
</script>
