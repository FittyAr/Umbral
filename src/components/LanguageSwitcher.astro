---
/**
 * Language switcher para la portada pública.
 *
 * Solo se renderiza si `features.i18n.enabled === true`. El admin eligió
 * el default en /admin → Avanzado → Features. El visitante puede override
 * via este dropdown, que setea la cookie `umbral_locale` por 30 días.
 */
import type { Config } from '~/lib/schema';
import { isFeatureEnabled } from '~/lib/features';
import { LOCALES, LOCALE_NAMES, type Locale } from '~/i18n';

interface Props {
  config: Config;
  current: Locale;
}
const { config, current } = Astro.props;

// Feature gate: si la feature está apagada, no renderizamos nada.
if (!isFeatureEnabled(config, 'i18n')) return null;

const labels: Record<Locale, string> = LOCALE_NAMES;
---
<div class="lang-switcher" data-action="locale-switcher">
  <label class="lang-label" for="lang-select" title="Seleccionar idioma / Select language">
    <svg class="lang-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <path d="M2 12h20"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <select
      id="lang-select"
      name="locale"
      class="lang-select"
      aria-label="Cambiar idioma"
    >
      {LOCALES.map((loc) => (
        <option value={loc} selected={loc === current}>
          {labels[loc]}
        </option>
      ))}
    </select>
    <svg class="lang-chevron" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </label>
</div>

<script is:inline>
  (function () {
    const sel = document.getElementById('lang-select');
    if (!sel) return;
    sel.addEventListener('change', async (e) => {
      e.preventDefault();
      const loc = sel.value;
      // 1. Guardar cookie para SSR / backend
      document.cookie = `umbral_locale=${loc};path=/;max-age=2592000;SameSite=Lax`;
      
      // 2. Guardar en localStorage para modo estático demo
      try {
        localStorage.setItem('umbral_demo_locale', loc);
      } catch {}

      // 3. Enviar via fetch en vez de form submit nativo (evita 405 en GitHub Pages)
      try {
        const base = window.__BASE_URL__ || '/';
        const endpoint = base.endsWith('/') ? `${base}api/locale` : `${base}/api/locale`;
        await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ locale: loc }),
        });
      } catch (err) {
        console.warn('Locale fetch error:', err);
      }
      
      // 4. Recargar
      window.location.reload();
    });
  })();
</script>