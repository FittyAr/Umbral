---
/**
 * Language switcher para la portada pública.
 *
 * Solo se renderiza si `features.i18n.enabled === true`. El admin eligió
 * el default en /admin → Avanzado → Features. El visitante puede override
 * via este dropdown, que setea la cookie `umbral_locale` por 30 días.
 *
 * Renderiza como un <select> nativo (cero JS de framework, accesible
 * por teclado y screen reader out-of-the-box). El handler inline hace
 * fetch a /api/locale y recarga la página — simple, predecible.
 */
import type { Config } from '~/lib/schema';
import { isFeatureEnabled } from '~/lib/features';
import { LOCALES, LOCALE_NAMES, type Locale } from '~/i18n';

interface Props {
  config: Config;
  current: Locale;
}
const { config, current } = Astro.props;

// Feature gate: si la feature está apagada, no renderizamos nada.
if (!isFeatureEnabled(config, 'i18n')) return null;

const labels: Record<Locale, string> = LOCALE_NAMES;
---
<form
  class="lang-switcher"
  method="post"
  action="/api/locale"
  data-action="locale-switcher"
>
  <label class="lang-label" for="lang-select">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <path d="M2 12h20"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <select
      id="lang-select"
      name="locale"
      class="lang-select"
      aria-label="Cambiar idioma"
    >
      {LOCALES.map((loc) => (
        <option value={loc} selected={loc === current}>
          {labels[loc]}
        </option>
      ))}
    </select>
  </label>
</form>

<script is:inline>
  // Submit on change. Recargamos la página para que el server lea la
  // cookie nueva y renderice con el locale elegido.
  const sel = document.getElementById('lang-select');
  if (sel) {
    sel.addEventListener('change', () => {
      const form = sel.closest('form');
      if (form) form.submit();
    });
  }
</script>