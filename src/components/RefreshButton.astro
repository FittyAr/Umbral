---
// Botón de refresh. Hace fetch a /api/config y re-renderiza la página con
// los datos nuevos — sin el flash ni la pérdida de scroll/foco de un
// location.reload() completo. Si falla, fallback a location.reload.
---
<button
  type="button"
  class="refresh-btn"
  data-action="refresh-config"
  aria-label="Recargar configuración"
  title="Recargar configuración"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
    <path d="M3 3v5h5"/>
    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
    <path d="M16 16h5v5"/>
  </svg>
</button>

<script>
  // Wire up: el handler de la portada ya hace fetch + re-render. Lo único
  // que hacemos acá es el feedback visual (clase .is-loading) durante el
  // request, así el user sabe que está pasando algo.
  const btn = document.querySelector('[data-action="refresh-config"]');
  if (btn) {
    btn.addEventListener('click', () => {
      btn.classList.add('is-loading');
      // El data-action="refresh-config" lo captura el script principal de
      // index.astro (que llama al endpoint y re-renderiza). Si por alguna
      // razón el handler no existe, caemos al reload completo.
      setTimeout(() => btn.classList.remove('is-loading'), 1500);
    });
  }
</script>
