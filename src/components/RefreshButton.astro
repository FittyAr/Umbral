---
// Botón de refresh. Hace fetch a /api/config y re-renderiza la página con
// los datos nuevos — sin el flash ni la pérdida de scroll/foco de un
// location.reload() completo. Si falla, fallback a location.reload.
import type { Config } from '~/lib/schema';
import { isFeatureEnabled } from '~/lib/features';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';

interface Props {
  config: Config;
  request?: Request;
}
const { config, request } = Astro.props as Props & { request?: Request };

const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(request, config, request ? readLocaleCookie(request) : undefined)
  : 'es';
const tr = t(locale);

const ariaLabel = useI18n ? tr('home.refresh') : 'Recargar configuración';
const title = useI18n ? tr('home.refreshTitle') : 'Recargar configuración';
---
<button
  type="button"
  class="refresh-btn"
  data-action="refresh-config"
  aria-label={ariaLabel}
  title={title}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
    <path d="M3 3v5h5"/>
    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
    <path d="M16 16h5v5"/>
  </svg>
</button>

<script>
  // El comportamiento del botón vive acá y no en la página: estaba partido
  // entre este archivo (que sólo ponía la clase .is-loading) y un handler en
  // index.astro, copiado en [category].astro con `/api/config` absoluto — o
  // sea roto en cualquier deploy bajo subpath.
  import { apiUrl } from '~/scripts/public/base-url';

  const btn = document.querySelector('[data-action="refresh-config"]');
  btn?.addEventListener('click', async () => {
    btn.classList.add('is-loading');
    // Calentamos el cache del config antes de recargar: así el reload —que
    // conserva scroll, foco y el estado del buscador del browser— ve los
    // datos nuevos sin esperar la lectura del disco.
    try {
      await fetch(apiUrl('api/config'), { cache: 'no-store' });
    } catch { /* igual recargamos */ }
    window.location.reload();
  });
</script>
