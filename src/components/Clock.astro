---
// Reloj en vivo. Renderiza la hora actual y la actualiza cada segundo via
// setInterval. El formato respeta el locale efectivo (config.i18n o el
// default histórico 'es'). El usuario lo activa desde
// Admin → Tema → "Mostrar reloj".
import type { Config } from '~/lib/schema';
import { isFeatureEnabled } from '~/lib/features';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';

interface Props {
  config: Config;
  request?: Request;
  class?: string;
}
const { config, request, class: className = '' } = Astro.props as Props & { request?: Request };

const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(request, config, request ? readLocaleCookie(request) : undefined)
  : 'es';
const tr = t(locale);
const hour12 = config.theme.clockFormat === '12h';

// El aria-label se traduce. El formato de fecha/hora del Intl.DateTimeFormat
// usa el locale nativo del browser (es-AR, en-US, pt-BR, etc.). Mapeamos
// el código de locale de Umbral al código BCP-47 que Intl entiende —
// 'es' → 'es-AR' (default del proyecto), 'en' → 'en-US', 'pt' → 'pt-BR'.
const intlLocale = useI18n
  ? ({ es: 'es-AR', en: 'en-US', pt: 'pt-BR' }[locale] || locale)
  : 'es-AR';
const ariaLabel = useI18n ? tr('home.clock.aria') : 'Hora actual';
---
<time class:list={['clock', className]} datetime="" aria-label={ariaLabel}>
  <span class="clock-time">--:--:--</span>
  <span class="clock-date" aria-hidden="true"></span>
</time>

<script define:vars={{ intlLocale, hour12 }}>
  // El locale efectivo llega como var del server. Encapsulado: corre una
  // vez por page load, vive hasta el siguiente reload.
  const el = document.querySelector('.clock');
  if (el) {
    const timeEl = el.querySelector('.clock-time');
    const dateEl = el.querySelector('.clock-date');
    const isoEl = el;
    const dateFmt = new Intl.DateTimeFormat(intlLocale, {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    });
    const timeFmt = new Intl.DateTimeFormat(intlLocale, {
      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12,
    });
    const tick = () => {
      const now = new Date();
      if (timeEl) timeEl.textContent = timeFmt.format(now);
      if (dateEl) dateEl.textContent = dateFmt.format(now);
      isoEl.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
