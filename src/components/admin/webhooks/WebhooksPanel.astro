---
import PanelHeader from '../ui/PanelHeader.astro';
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
/** Literal JS entre comillas simples, para inyectar texto traducido en expresiones Alpine. */
const q = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
---

<div class="panel" :class="tab==='webhooks' && 'active'">
  <PanelHeader {...kit} titleExpr="webhooksTitle()" titleKey="admin.webhooks.title" titleFallback="Webhooks" helpKey="advanced.webhooks" introExpr="webhooksIntro()">
    <Fragment slot="intro">
    {t('admin.webhooks.intro', 'Notifica a URLs externas cuando una card con health-check cambia de estado (de healthy → failing o vice versa).')}
    </Fragment>
  </PanelHeader>

  <!-- Lista de webhooks -->
  <div class="webhooks-list">
    <template x-for="(wh, idx) in cfgList('webhooks')" :key="wh.id">
      <div class="webhook-item" :class="!wh.enabled && 'webhook-disabled'">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap">
          <div style="flex:1;min-width:0">
            <div style="font-weight:600" x-text="wh.name"></div>
            <div style="font-size:0.78rem;color:var(--text-subtle);font-family:ui-monospace,Menlo,Consolas,monospace;word-break:break-all" x-text="wh.url"></div>
            <div style="font-size:0.7rem;color:#64748b;margin-top:0.25rem">
              <span x-text={`${q(t('admin.webhooks.events', 'Eventos') + ': ')} + wh.events.join(', ')`}></span>
              <span x-text="' · threshold: ' + wh.minFailures + ' · cooldown: ' + wh.cooldownMin + 'min · ' + (wh.preset || 'custom')"></span>
              <span :style="{ color: wh.enabled ? 'var(--status-ok)' : 'var(--text-subtle)' }" x-text={`' · ' + (wh.enabled ? ${q(t('admin.webhooks.statusActive', 'activo'))} : ${q(t('admin.webhooks.statusInactive', 'inactivo'))})`}></span>
            </div>
          </div>
          <div style="display:flex;gap:0.4rem;flex-shrink:0">
            <button type="button" class="btn btn-sm btn-ghost" @click="testWebhook(wh)" :disabled="webhookTesting === wh.id" x-text="webhookTestLabel(wh.id)">{t('admin.msg.webhooks.test', 'Probar')}</button>
            <button type="button" class="btn btn-sm btn-ghost" @click="removeWebhook(idx)">×</button>
          </div>
        </div>
      </div>
    </template>
    <p x-show="cfgList('webhooks').length === 0" class="muted" style="padding:0.5rem 0">
      {t('admin.webhooks.empty', 'No hay webhooks configurados. Agregá uno abajo.')}
    </p>
  </div>

  <!-- Form para agregar -->
  <details style="margin-top:1rem;background:var(--surface);padding:1rem;border-radius:8px;border:1px solid var(--border)">
    <summary style="cursor:pointer;color:var(--text);font-weight:500;font-size:0.9rem">{t('admin.webhooks.addSummary', '+ Agregar webhook')}</summary>
    <div class="form-group" style="margin-top:0.75rem">
      <label>{t('admin.webhooks.form.name', 'Nombre')}</label>
      <input type="text" x-model="newWebhook.name" placeholder={t('admin.webhooks.form.namePlaceholder', 'Slack #alertas')} maxlength="60" />
    </div>
    <FormGroup {...kit} labelKey="admin.webhooks.form.url" labelFallback="URL">
      <input type="url" x-model="newWebhook.url" placeholder="https://hooks.slack.com/..." maxlength="500" />
      <small style="color:var(--text-faint);font-size:0.72rem">{t('admin.webhooks.form.urlHint', 'http(s) only. SSRF guard bloquea loopback y private IPs.')}</small>
    </FormGroup>
    <div class="form-group">
      <label for="webhook-preset">{t('admin.webhooks.form.format', 'Formato')}</label>
      <select id="webhook-preset" x-model="newWebhook.preset">
        <option value="custom">{t('admin.webhooks.form.formatCustom', 'JSON genérico')}</option>
        <option value="slack">Slack</option>
        <option value="discord">Discord</option>
        <option value="mattermost">Mattermost</option>
        <option value="ntfy">ntfy</option>
        <option value="gotify">Gotify</option>
      </select>
    </div>
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label>{t('admin.webhooks.events', 'Eventos')}</label>
        <div style="display:flex;gap:0.75rem;font-size:0.85rem">
          <label><input type="checkbox" x-model="newWebhook.eventFail" /> health_fail</label>
          <label><input type="checkbox" x-model="newWebhook.eventRecover" /> health_recover</label>
        </div>
      </div>
      <div class="form-group" style="width:100px">
        <label>{t('admin.webhooks.form.threshold', 'Threshold')}</label>
        <input type="number" x-model.number="newWebhook.minFailures" min="1" max="20" />
      </div>
      <div class="form-group" style="width:120px">
        <label>{t('admin.webhooks.form.cooldown', 'Cooldown (min)')}</label>
        <input type="number" x-model.number="newWebhook.cooldownMin" min="0" max="1440" />
      </div>
    </div>
    <div style="display:flex;gap:0.5rem;margin-top:0.75rem">
      <button type="button" class="btn btn-primary" @click="addWebhook()" x-text="webhooksAddLabel()">{t('admin.webhooks.add', 'Agregar')}</button>
      <button type="button" class="btn btn-ghost" @click="testNewWebhook()" :disabled="!newWebhook.url || webhookTesting === 'new'" x-text="webhookTestNewLabel()">{t('admin.webhooks.testNew', 'Probar antes de guardar')}</button>
    </div>
  </details>
</div>
