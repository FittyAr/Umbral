---
import PanelHeader from '../ui/PanelHeader.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="panel" :class="tab==='portals' && 'active'">
  <PanelHeader {...kit} titleExpr="tabPortals()" titleFallback="Multi-Portal" helpKey="advanced.multiPortal">
    <Fragment slot="intro">
      {t(
        'admin.portals.intro',
        'Cada portal tiene su propia portada (marca, tema, layout, categorías y tarjetas) y se sirve según el dominio o el prefijo de ruta. Usuarios, seguridad y features son comunes a todos.',
      )}
    </Fragment>
  </PanelHeader>

  <div class="portals-list">
    <div class="form-group" style="max-width:300px;margin-bottom:0.75rem">
      <label for="portal-default">{t('admin.portals.defaultPortal', 'Portal para pedidos sin match')}</label>
      <select id="portal-default" x-model="cfg.portals.defaultPortal" @change="markDirty()">
        <option value="default">default</option>
        <template x-for="p in cfgList('portals')" :key="p.id">
          <option :value="p.id" x-text="p.name || p.id"></option>
        </template>
      </select>
    </div>

    <template x-for="(p, idx) in cfgList('portals')" :key="p.id">
      <div class="webhook-item">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap">
          <div style="flex:1;min-width:0">
            <div style="font-weight:600" x-text="p.name || p.id"></div>
            <div style="font-size:0.78rem;color:var(--text-subtle);font-family:ui-monospace,Menlo,Consolas,monospace">
              <span x-text="'id: ' + p.id + ' · Host: ' + (p.host || '*') + ' · Prefix: ' + (p.pathPrefix || '/')"></span>
            </div>
          </div>
          <div style="display:flex;gap:0.4rem;flex-shrink:0">
            <a class="btn btn-sm btn-ghost" :href="portalEditUrl(p.id)">{t('admin.portals.edit', 'Editar portada')}</a>
            <a class="btn btn-sm btn-ghost" :href="portalPublicUrl(p)" target="_blank" rel="noopener noreferrer">{t('admin.portals.view', 'Ver')}</a>
            <button type="button" class="btn btn-sm btn-ghost" @click="removePortal(idx)" :aria-label="l('msgPortalRemove') + ' ' + p.id">×</button>
          </div>
        </div>
      </div>
    </template>
    <p x-show="cfgList('portals').length === 0" class="muted" style="padding:0.5rem 0">
      {t('admin.portals.empty', 'No hay portales adicionales configurados.')}
    </p>
  </div>

  <details style="margin-top:1rem;background:var(--surface);padding:1rem;border-radius:8px;border:1px solid var(--border)">
    <summary style="cursor:pointer;color:var(--text);font-weight:500;font-size:0.9rem">{t('admin.portals.addTitle', '+ Agregar portal')}</summary>
    <div class="form-row" style="margin-top:0.75rem">
      <div class="form-group" style="width:140px">
        <label for="portal-new-id">ID</label>
        <input id="portal-new-id" type="text" x-model="newPortal.id" placeholder="dev" maxlength="40" pattern="[a-z0-9-]+" />
      </div>
      <div class="form-group" style="flex:1">
        <label for="portal-new-name">{t('admin.portals.name', 'Nombre')}</label>
        <input id="portal-new-name" type="text" x-model="newPortal.name" placeholder="Portal Dev" maxlength="80" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label for="portal-new-host">{t('admin.portals.host', 'Host (opcional)')}</label>
        <input id="portal-new-host" type="text" x-model="newPortal.host" placeholder="dev.portal.local" />
      </div>
      <div class="form-group" style="flex:1">
        <label for="portal-new-prefix">{t('admin.portals.prefix', 'Prefijo de ruta (opcional)')}</label>
        <input id="portal-new-prefix" type="text" x-model="newPortal.pathPrefix" placeholder="/dev" />
      </div>
    </div>
    <p class="muted" style="font-size:0.78rem;margin:0.25rem 0 0.5rem">
      {t(
        'admin.portals.hint',
        'Un portal nuevo arranca con la portada por defecto. Guardá los cambios y usá "Editar portada" para configurarlo.',
      )}
    </p>
    <button type="button" class="btn btn-primary" @click="addPortal()" style="margin-top:0.5rem">{t('admin.portals.add', 'Agregar portal')}</button>
  </details>
</div>
