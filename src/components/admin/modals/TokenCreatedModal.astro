---
import FormGroup from '../ui/FormGroup.astro';
import Modal from '../ui/Modal.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
---

<Modal
  {...kit}
  show="showTokenModal && generatedTokenPlain"
  close="showTokenModal = false"
  titleFallback="Token API Generado"
  modalStyle="max-width:500px"
>
  <div class="login-warning" style="margin-bottom:1rem">
    ⚠ Copiá este token ahora. Por seguridad, no se guardará en texto plano y no vas a poder verlo de nuevo.
  </div>
  <FormGroup {...kit} labelFallback="Token Bearer">
    <div style="display:flex;gap:0.5rem">
      <input
        type="text"
        readonly
        :value="generatedTokenPlain"
        class="monospace"
        style="flex:1"
        id="generated-token-input"
      />
      <button
        type="button"
        class="btn btn-primary"
        @click="navigator.clipboard.writeText(generatedTokenPlain); window.umbralAdmin.toast('Token copiado al portapapeles', 'info')"
      >Copiar</button>
    </div>
  </FormGroup>
  <button slot="footer" type="button" class="btn btn-ghost" @click="showTokenModal = false">Cerrar</button>
</Modal>
