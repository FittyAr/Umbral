---
import FormGroup from '../ui/FormGroup.astro';
import Modal from '../ui/Modal.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
/** Literal JS entre comillas simples, para inyectar texto traducido en expresiones Alpine. */
const q = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
const kit = { useI18n, tr };
---

<Modal
  {...kit}
  show="showTokenModal && generatedTokenPlain"
  close="showTokenModal = false"
  titleKey="admin.tokenModal.title" titleFallback="Token API Generado"
  modalStyle="max-width:500px"
>
  <div class="login-warning" style="margin-bottom:1rem">
    {t('admin.tokenModal.warning', '⚠ Copiá este token ahora. Por seguridad, no se guardará en texto plano y no vas a poder verlo de nuevo.')}
  </div>
  <FormGroup {...kit} labelKey="admin.tokenModal.token" labelFallback="Token Bearer">
    <div style="display:flex;gap:0.5rem">
      <input
        type="text"
        readonly
        :value="generatedTokenPlain"
        class="monospace"
        style="flex:1"
        id="generated-token-input"
      />
      <button
        type="button"
        class="btn btn-primary"
        @click={`navigator.clipboard.writeText(generatedTokenPlain); window.umbralAdmin.toast(${q(t('admin.tokenModal.copied', 'Token copiado al portapapeles'))}, 'info')`}
      >{t('admin.tokenModal.copy', 'Copiar')}</button>
    </div>
  </FormGroup>
  <button slot="footer" type="button" class="btn btn-ghost" @click="showTokenModal = false">{t('common.close', 'Cerrar')}</button>
</Modal>
