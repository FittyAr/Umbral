---
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
/** Literal JS entre comillas simples, para inyectar texto traducido en expresiones Alpine. */
const q = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
---

<div class="icon-picker-panel">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem">
    <label style="margin:0;font-weight:600;display:flex;align-items:center;gap:0.35rem">
      <span>{t('admin.card.icon', 'Ícono')}</span>
      <HelpIcon helpKey="card.iconPicker" />
    </label>
    <button
      type="button"
      class="btn btn-ghost btn-sm"
      style="font-size:0.72rem;padding:0.15rem 0.4rem;color:var(--accent)"
      @click="openTab('iconpacks')"
      x-show="isFeatureOn('iconPacks')"
      x-cloak
    >
      {t('admin.iconPicker.managePacks', 'Gestionar packs')}
    </button>
  </div>

  <div class="icon-picker-preview">
    <span class="icon-picker-preview-img" aria-hidden="true">
      <template x-if="resolveIcon(editingCard.icon)">
        <img :src="resolveIcon(editingCard.icon)" :alt="editingCard.icon" />
      </template>
      <template x-if="!resolveIcon(editingCard.icon)">
        <span style="font-size:1.5rem">🚫</span>
      </template>
    </span>
    <span class="icon-picker-preview-name" x-text={`editingCard.icon || ${q(t('admin.iconPicker.noIcon', 'Sin ícono'))}`}></span>
  </div>

  <div class="icon-picker-toolbar">
    <div class="icon-picker-toolbar-row">
      <div class="icon-picker-tabs">
        <button type="button" class="icon-picker-tab" :class="iconPickerTab === 'icons' && 'active'" @click="iconPickerTab = 'icons'">{t('admin.iconPicker.tabIcons', 'Íconos')}</button>
        <button type="button" class="icon-picker-tab" :class="iconPickerTab === 'assets' && 'active'" @click="iconPickerTab = 'assets'">{t('admin.iconPicker.tabAssets', 'Assets')}</button>
      </div>
      <input
        type="text"
        class="icon-picker-search"
        x-model="iconPickerSearch"
        @input="iconPickerLimit = 120"
        placeholder={t('admin.iconPicker.searchPlaceholder', 'Buscar por nombre…')}
        x-show="iconPickerTab === 'icons'"
        x-cloak
      />
    </div>
    <div class="icon-picker-toolbar-row" x-show="iconPickerTab === 'icons'" x-cloak>
      <select class="icon-picker-pack-select" x-model="iconPickerPack" @change="iconPickerLimit = 120">
        <option value="all">{t('admin.iconPicker.allPacks', 'Todos los packs')}</option>
        <template x-for="pack in iconPickerPackOptions()" :key="pack">
          <option :value="pack" x-text="pack"></option>
        </template>
      </select>
    </div>
    <div class="icon-picker-meta" x-show="iconPickerTab === 'icons'" x-cloak>
      <span x-text={`${q(t('admin.iconPicker.showing', 'Mostrando {shown} de {total}'))}.replace('{shown}', visibleIconPickerIcons().length).replace('{total}', filteredIconPickerIcons().length)`}></span>
      <span class="icon-picker-badge" x-show="iconPickerPack !== 'all'" x-text="iconPickerPack"></span>
    </div>
  </div>

  <div class="icon-picker-empty" x-show="iconPickerTab === 'icons' && filteredIconPickerIcons().length === 0 && !iconPickerSearch.trim()" x-cloak>
    <p x-text="iconPickerEmptyMessage()"></p>
    <button type="button" class="btn btn-sm btn-primary" @click="openIconPacksFromPicker()" x-text="iconPickerEmptyAction()"></button>
  </div>

  <div class="icon-picker-grid" x-show="iconPickerTab === 'icons' && filteredIconPickerIcons().length > 0" x-cloak>
    <button
      type="button"
      class="icon-picker-tile"
      :class="!editingCard.icon && 'selected'"
      @click="setEditingIcon('')"
      title={t('admin.iconPicker.noIcon', 'Sin ícono')}
    >
      <span class="icon-picker-tile-none" aria-hidden="true">🚫</span>
    </button>
    <template x-for="i in visibleIconPickerIcons()" :key="i">
      <button
        type="button"
        class="icon-picker-tile"
        :class="editingCard.icon===i && 'selected'"
        @click="setEditingIcon(i)"
        :title="i"
      >
        <img :src="resolveIcon(i)" :alt="i" loading="lazy" />
      </button>
    </template>
  </div>

  <div class="icon-picker-load-more" x-show="iconPickerTab === 'icons' && iconPickerHasMore()" x-cloak>
    <button type="button" class="btn btn-sm btn-ghost" @click="loadMoreIcons()">{t('admin.iconPicker.loadMore', 'Cargar más (120)')}</button>
  </div>

  <div class="icon-picker-grid" x-show="iconPickerTab === 'assets'" x-cloak>
    <template x-if="iconPickerAssets().length === 0">
      <p style="grid-column:1/-1;font-size:0.78rem;color:var(--text-faint);margin:0.5rem 0">{t('admin.iconPicker.noAssets', 'No hay assets subidos. Subilos en la pestaña Assets.')}</p>
    </template>
    <template x-for="a in iconPickerAssets()" :key="a.name">
      <button
        type="button"
        class="icon-picker-tile"
        :class="editingCard.icon === a.url && 'selected'"
        @click="setEditingIcon(a.url)"
        :title="a.name"
      >
        <img :src="a.url" :alt="a.name" loading="lazy" />
      </button>
    </template>
  </div>

  <details class="icon-picker-custom">
    <summary>{t('admin.iconPicker.customSummary', '¿Usar un asset subido o un nombre custom?')}</summary>
    <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.4rem">
      <input
        type="text"
        x-model="editingCard.icon"
        placeholder={t('admin.iconPicker.customPlaceholder', '/api/assets/mi-logo.png o simple-icons/docker')}
        style="flex:1"
      />
      <button type="button" class="btn btn-sm btn-ghost" @click="editingCard.icon=''">{t('admin.iconPicker.clear', 'Limpiar')}</button>
    </div>
    <small class="field-hint">
      <Fragment set:html={t('admin.iconPicker.customHint', 'Pegá la URL de un asset (<code>/api/assets/mi-logo.png</code>) o un id de ícono (<code>simple-icons/docker</code>).')} />
    </small>
  </details>
</div>
