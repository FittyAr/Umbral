---
import PendingButton from '../ui/PendingButton.astro';
import FormGroup from '../ui/FormGroup.astro';
import Modal from '../ui/Modal.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<Modal
  {...kit}
  show="showTotpSetupModal && totpSetupData"
  close="showTotpSetupModal = false"
  titleKey="admin.totp.title" titleFallback="Configurar 2FA (TOTP)"
  modalStyle="max-width:440px"
>
      <p class="panel-intro">
        {t('admin.totp.intro', 'Escaneá el código QR con Google Authenticator, Authy, 1Password o tu gestor favorito, o ingresá el secret manualmente:')}
      </p>

      <div style="display:flex;justify-content:center;margin:1rem 0;background:white;padding:1rem;border-radius:8px">
        <img :src="totpSetupData.qrDataUrl" alt={t('admin.totp.qrAlt', 'QR Code 2FA')} style="width:200px;height:200px" />
      </div>

      <div style="margin-bottom:1rem;text-align:center">
        <code class="totp-secret" x-text="totpSetupData.secret"></code>
      </div>

      <form @submit.prevent="verifyAndSaveTotp()">
        <FormGroup {...kit} labelKey="admin.totp.code" labelFallback="Código de verificación (6 dígitos)">
          <input type="text" x-model="totpVerificationCode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required autocomplete="one-time-code" x-init="focusLater($el)" />
        </FormGroup>
        <div style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:1rem">
          <button type="button" class="btn btn-ghost" @click="showTotpSetupModal = false">{t('common.cancel', 'Cancelar')}</button>
          <PendingButton
            type="submit"
            pending="totpSaving"
            label={t('admin.security.enable2fa', 'Activar 2FA')}
            pendingLabel={t('admin.totp.verifying', 'Verificando…')}
            variant="btn-primary"
          />
        </div>
      </form>
</Modal>
