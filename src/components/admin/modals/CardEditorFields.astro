---
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
import SelectField from '../ui/SelectField.astro';
import ToggleField from '../ui/ToggleField.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
const kit = { useI18n, tr };
---

  <div class="card-editor-fields">
<div class="form-row">
  <FormGroup {...kit} labelFallback="Título" helpKey="card.title">
    <input type="text" x-model="editingCard.title" required maxlength="80" />
  </FormGroup>
  <SelectField
    {...kit}
    model="editingCard.kind"
    labelFallback="Tipo"
    helpKey="card.kind"
    options={[
      { value: 'link', label: 'Link (clickeable)' },
      { value: 'note', label: 'Nota (informativa, sin link)' },
    ]}
  >
    <small class="field-hint">"Link" lleva a una URL. "Nota" es solo informativa (anuncios, tips, etc.).</small>
  </SelectField>
</div>
<div class="form-row">
  <div class="form-group" style="flex:1">
    <label>URL <HelpIcon helpKey="card.url" /> <span x-show="editingCard.kind==='link'" style="color:#dc2626">*</span></label>
    <div style="display:flex;gap:0.4rem;align-items:flex-start">
      <input
        type="text"
        x-model="editingCard.url"
        :required="editingCard.kind==='link'"
        placeholder="https://… o /docs"
        style="flex:1"
        @blur="maybeAutofillFromUrl()"
      />
      <button
        type="button"
        class="btn btn-sm btn-ghost"
        @click="autofillFromUrl()"
        :disabled="autofillBusy || (!editingCard.url && !editingCard.title)"
        title="Traer título/desc/imagen del sitio (URL) o de la búsqueda externa (título)"
        x-show="editingCard.kind==='link'"
      >
        <span x-show="!autofillBusy">Auto-completar</span>
        <span x-show="autofillBusy" x-cloak>Buscando…</span>
      </button>
      <HelpIcon helpKey="card.autofill" x-show="editingCard.kind==='link'" />
    </div>
    <small class="field-hint">
      <template x-if="editingCard.kind==='link'">
        <span>URL externa (https://…) o path interno (/docs, /admin). Obligatoria. Auto-completar trae título/desc/imagen del sitio.</span>
      </template>
      <template x-if="editingCard.kind==='note'">
        <span>Opcional para notas. Útil si querés un link de referencia dentro del texto.</span>
      </template>
    </small>
  </div>
</div>
<div class="form-group" x-show="cfg.ai?.enabled && editingCard.kind==='link'" style="display:flex;gap:0.4rem;align-items:center;padding:0.5rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm)">
  <span style="color:var(--text-subtle);font-size:0.85rem">IA: </span>
  <button
    type="button"
    class="btn btn-sm btn-ghost"
    @click="improveWithAI()"
    :disabled="aiBusy || !editingCard.title"
    title="Mejorar el título y descripción con la IA configurada"
  >
    <span x-show="!aiBusy">Mejorar con IA</span>
    <span x-show="aiBusy" x-cloak>Pensando…</span>
  </button>
  <HelpIcon helpKey="card.aiEnhance" />
  <span style="color:var(--text-faint);font-size:0.75rem">
    Usa la config de IA (Admin → IA). Editá el prompt system ahí si querés otro estilo.
  </span>
</div>
<div class="form-group">
  <label>
    <span>Descripción <HelpIcon helpKey="card.description" /></span>
    <label x-show="markdownEnabled" style="display:inline-flex;align-items:center;gap:0.3rem;margin-left:0.5rem;font-size:0.78rem;color:var(--text-subtle);cursor:pointer" x-cloak>
      <input type="checkbox" x-model="editingCard.descriptionFormat" @change="updateDescriptionLimit()" true-value="markdown" false-value="plain" />
      <span x-text="markdownLabel()">Markdown</span>
      <HelpIcon helpKey="card.descriptionFormat" />
    </label>
  </label>
  <textarea
    x-model="editingCard.description"
    :maxlength="descMaxLength()"
    @input="cardFormDirty = true; markdownPreviewDirty = true"
    style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:0.85rem;min-height:5rem"
  ></textarea>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.25rem;font-size:0.75rem;color:var(--text-subtle)">
    <span>
      <span x-text="editingCard.description ? editingCard.description.length : 0"></span> / <span x-text="descMaxLength()"></span> chars
      <span x-show="editingCard.descriptionFormat === 'markdown' && markdownEnabled" x-cloak style="margin-left:0.5rem;color:var(--accent)">
        (markdown: ~<span x-text="Math.round(((editingCard.description || '').length / 4))"></span> tokens)
      </span>
    </span>
    <span x-show="editingCard.descriptionFormat === 'markdown' && markdownPreviewDirty && markdownEnabled" x-cloak>
      <button type="button" class="btn btn-ghost" @click="refreshMarkdownPreview()" style="padding:0.15rem 0.4rem;font-size:0.72rem" x-text="refreshPreviewLabel()">Refresh preview</button>
    </span>
  </div>
  <div x-show="editingCard.descriptionFormat === 'markdown' && markdownEnabled && markdownPreview" x-cloak class="markdown-preview-wrap" style="margin-top:0.5rem;padding:0.5rem;border:1px solid var(--border);border-radius:4px;background:var(--surface);font-size:0.8rem">
    <div style="font-size:0.7rem;color:var(--text-faint);margin-bottom:0.3rem" x-text="previewLabel()">Preview</div>
    <div class="card-desc-md" x-html="markdownPreview"></div>
  </div>
</div>
<div class="form-row">
  <FormGroup {...kit} labelFallback="Categoría" helpKey="card.category">
    <select
      x-model="editingCard.category"
      x-init="$nextTick(() => $el.value = editingCard.category || '')"
      required
    >
      <option :value="ungroupedSelectId" x-text="cardsUngroupedGroupLabel()">Sin grupo</option>
      <template x-for="c in realCategories()" :key="c.id">
        <option :value="c.id" x-text="c.name"></option>
      </template>
    </select>
  </FormGroup>
  <FormGroup {...kit} labelFallback="Color" helpKey="card.color">
    <input type="color" x-model="editingCard.color" />
  </FormGroup>
  <FormGroup {...kit} labelExpr="cardSpanLabel()" labelFallback="Ancho" helpKey="card.span">
    <select
      x-model.number="editingCard.span"
      x-init="$nextTick(() => $el.value = String(editingCard.span || 1))"
    >
      <template x-for="n in cardSpanOptions()" :key="n">
        <option :value="n" x-text="cardSpanOptionLabel(n)"></option>
      </template>
    </select>
    <small class="field-hint" x-text="cardSpanEffectiveHint()"></small>
  </FormGroup>
</div>

<div class="form-group" x-show="tagsEnabled" x-cloak>
  <label>
    <span x-text="tagsLabel()">Tags</span>
    <HelpIcon helpKey="card.tags" />
    <span style="font-size:0.7rem;color:var(--text-faint);margin-left:0.5rem" x-text="(editingCard.tags || []).length + '/10'"></span>
  </label>
  <div class="tags-chips-wrap" @click="$refs.tagsInput && $refs.tagsInput.focus()">
    <template x-for="(t, idx) in (editingCard.tags || [])" :key="t + '-' + idx">
      <span class="tag-chip">
        <span x-text="t"></span>
        <button type="button" class="tag-chip-remove" @click.stop="removeTag(idx)" :aria-label="'Quitar ' + t">×</button>
      </span>
    </template>
    <input
      type="text"
      class="tags-input"
      x-ref="tagsInput"
      x-model="tagInput"
      @keydown.enter.prevent="addTagFromInput()"
      @keydown.comma.prevent="addTagFromInput()"
      @keydown.space.prevent="addTagFromInput()"
      @keydown.backspace="tagInput === '' && removeTag((editingCard.tags || []).length - 1)"
      @blur="addTagFromInput()"
      :placeholder="(editingCard.tags || []).length >= 10 ? '' : tagInputPlaceholder()"
      :disabled="(editingCard.tags || []).length >= 10"
    />
  </div>
  <div x-show="tagSuggestions().length > 0 && tagInput.length > 0" x-cloak class="tag-suggestions">
    <template x-for="s in tagSuggestions()" :key="s">
      <button type="button" class="tag-suggestion" @click="addTag(s)">
        <span x-text="s"></span>
        <span class="tag-suggestion-add" x-text="tagsAddLabel()">+ agregar</span>
      </button>
    </template>
  </div>
  <small style="color:var(--text-faint);font-size:0.72rem" x-text="tagsHelp()">
    Tags kebab-case (frontend, urgent, legacy…). Enter, coma o espacio para agregar. Backspace borra el último.
  </small>
</div>

<div class="form-row">
  <ToggleField
    {...kit}
    model="editingCard.openInNewTab"
    labelFallback="Abrir en nueva pestaña"
    helpKey="card.openInNewTab"
    show="editingCard.kind==='link'"
  />
  <ToggleField {...kit} model="editingCard.enabled" labelFallback="Activa" helpKey="card.enabled" />
  <ToggleField
    {...kit}
    model="editingCard.pinned"
    labelExpr="pinnedLabel()"
    labelFallback="Fijada"
    helpKey="card.pinned"
    show="pinnedEnabled"
    cloak
  />
  <ToggleField
    {...kit}
    model="editingCard.healthCheck"
    labelFallback="Health check (dot en vivo)"
    helpKey="card.healthCheck"
    show="editingCard.kind==='link'"
  />
</div>
  </div>
