---
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="panel" :class="tab==='status' && 'active'">
  <h2 style="margin-top:0">
    Status de las tarjetas
    <button type="button" class="help-icon" @click="showHelp('status.check')" :title="helpTooltipLabel()">?</button>
  </h2>
  <p class="muted" style="color:#94a3b8;font-size:0.85rem">Ping HEAD a cada URL. Útil para detectar servicios caídos.</p>
  <button class="btn btn-primary" @click="checkAllStatus()" :disabled="checkingStatus">
    <span x-show="!checkingStatus">Probar todas</span>
    <span x-show="checkingStatus" x-cloak>Probando…</span>
  </button>
  <div style="margin-top:1rem">
    <template x-for="r in statusResults" :key="r.id">
      <div class="health-row">
        <span class="status-dot" :class="r.ok ? 'ok' : 'bad'"></span>
        <span x-text="(cfg.cards.find(c=>c.id===r.id)?.title) || r.url"></span>
        <span style="color:#64748b;font-size:0.75rem" x-text="r.status || r.error"></span>
        <span class="latency" x-text="r.latencyMs + 'ms'"></span>
      </div>
    </template>
  </div>
</div>
