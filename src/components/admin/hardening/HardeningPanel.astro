---
import NumberField from '../ui/NumberField.astro';
import SelectField from '../ui/SelectField.astro';
import TextField from '../ui/TextField.astro';
import TextareaField from '../ui/TextareaField.astro';
import ToggleField from '../ui/ToggleField.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };

/** Los caps de upload se guardan en bytes pero se editan en KB. */
const kbField = (key: 'maxBytesLogo' | 'maxBytesFavicon' | 'maxBytesIcon' | 'maxBytesBackground') => ({
  expr: `Math.round(cfg.security.uploads.${key} / 1024)`,
  change: `cfg.security.uploads.${key} = $event.target.value * 1024`,
});
---

<div class="panel" :class="tab==='hardening' && 'active'">
  <h2 style="margin-top:0">Hardening</h2>
  <p class="muted panel-intro">
    Defaults permisivos: la app funciona recién salida de la caja.
    Endurecé lo que necesites. Los cambios se aplican al guardar.
  </p>

  <h3 style="margin-top:1.5rem">Sesión y cookies</h3>
  <div class="form-row">
    <NumberField
      {...kit}
      model="cfg.security.session.ttlHours"
      min={1}
      max={720}
      labelFallback="Duración (horas)"
      helpKey="session.ttlHours"
    />
    <SelectField
      {...kit}
      model="cfg.security.session.cookieSameSite"
      labelFallback="SameSite"
      helpKey="session.cookieSameSite"
      options={[
        { value: 'Lax', label: 'Lax (permisivo, default)' },
        { value: 'Strict', label: 'Strict (más seguro)' },
        { value: 'None', label: 'None (requiere Secure)' },
      ]}
    />
    <SelectField
      {...kit}
      model="cfg.security.session.cookieSecure"
      labelFallback="Secure flag"
      helpKey="session.cookieSecure"
      options={[
        { value: 'auto', label: 'Auto (recomendado)' },
        { value: 'always', label: 'Siempre' },
        { value: 'never', label: 'Nunca' },
      ]}
    />
    <ToggleField
      {...kit}
      model="cfg.security.session.rotateCsrfOnLogin"
      labelFallback="Rotar CSRF en cada login"
      helpKey="session.rotateCsrfOnLogin"
    />
  </div>

  <h3 style="margin-top:1.5rem">Login y CSRF</h3>
  <div class="form-row">
    <NumberField
      {...kit}
      model="cfg.security.auth.minPasswordLength"
      min={0}
      max={128}
      labelFallback="Largo mínimo del password"
      helpKey="auth.minPasswordLength"
      hint="0 = sin mínimo (permite passwords cortos legados)"
    />
    <NumberField
      {...kit}
      model="cfg.security.auth.rateLimitMax"
      min={1}
      max={10000}
      labelFallback="Rate limit (intentos)"
      helpKey="auth.rateLimitMax"
    />
    <NumberField
      {...kit}
      model="cfg.security.auth.rateLimitWindowSec"
      min={1}
      max={3600}
      labelFallback="Rate limit (ventana, seg)"
      helpKey="auth.rateLimitWindowSec"
    />
    <SelectField
      {...kit}
      model="cfg.security.auth.csrfPolicy"
      labelFallback="Política CSRF"
      helpKey="auth.csrfPolicy"
      options={[
        { value: 'mutations', label: 'Mutations (default, recomendado)' },
        { value: 'all', label: 'Todos los requests' },
        { value: 'none', label: 'Ninguno (no recomendado)' },
      ]}
    />
  </div>

  <h3 style="margin-top:1.5rem">Uploads</h3>
  <div class="form-row">
    <NumberField {...kit} {...kbField('maxBytesLogo')} min={1} labelFallback="Máx logo (KB)" helpKey="uploads.maxBytesLogo" />
    <NumberField {...kit} {...kbField('maxBytesFavicon')} min={1} labelFallback="Máx favicon (KB)" helpKey="uploads.maxBytesFavicon" />
    <NumberField {...kit} {...kbField('maxBytesIcon')} min={1} labelFallback="Máx ícono (KB)" helpKey="uploads.maxBytesIcon" />
    <NumberField {...kit} {...kbField('maxBytesBackground')} min={1} labelFallback="Máx fondo (KB)" helpKey="uploads.maxBytesBackground" />
  </div>
  <div class="form-row">
    <TextField
      {...kit}
      value="cfg.security.uploads.allowedMimeTypes.join(', ')"
      change="cfg.security.uploads.allowedMimeTypes = $event.target.value.split(',').map(s => s.trim()).filter(Boolean)"
      labelFallback="MIME permitidos (coma-separado)"
      helpKey="uploads.allowedMimeTypes"
    />
  </div>
  <div class="form-row">
    <ToggleField {...kit} model="cfg.security.uploads.allowSvg" labelFallback="Permitir SVG" helpKey="uploads.allowSvg" />
    <ToggleField {...kit} model="cfg.security.uploads.sanitizeSvg" labelFallback="Sanitizar SVG con DOMPurify" helpKey="uploads.sanitizeSvg" />
    <ToggleField {...kit} model="cfg.security.uploads.processImages" labelFallback="Procesar imágenes con sharp" helpKey="uploads.processImages" />
  </div>

  <h3 style="margin-top:1.5rem">Red</h3>
  <div class="form-row">
    <ToggleField
      {...kit}
      model="cfg.security.network.trustForwardedFor"
      labelFallback="Confiar en X-Forwarded-For (sólo con reverse proxy)"
      helpKey="network.trustForwardedFor"
    />
    <ToggleField
      {...kit}
      model="cfg.security.network.allowInternalHosts"
      labelFallback="Permitir health checks a hosts internos (10/8, 172.16/12, 192.168/16)"
      helpKey="network.allowInternalHosts"
    />
    <TextField
      {...kit}
      model="cfg.security.network.cookieDomain"
      placeholder="(vacío = sin domain)"
      labelFallback="Cookie domain (ej: .example.com)"
      helpKey="network.cookieDomain"
    />
  </div>
  <TextareaField
    {...kit}
    model="cfg.security.network.trustedProxiesText"
    rows={3}
    placeholder={'10.0.0.1\n192.168.1.0/24'}
    labelFallback="Proxies confiables (uno por línea, informativo)"
    helpKey="network.trustedProxies"
  />

  <h3 style="margin-top:1.5rem">Headers de seguridad</h3>
  <div class="form-row">
    <SelectField
      {...kit}
      model="cfg.security.headers.xFrameOptions"
      labelFallback="X-Frame-Options"
      helpKey="headers.xFrameOptions"
      options={[
        { value: 'DENY', label: 'DENY (recomendado)' },
        { value: 'SAMEORIGIN', label: 'SAMEORIGIN' },
        { value: 'NONE', label: 'NONE (desactivar)' },
      ]}
    />
    <SelectField
      {...kit}
      model="cfg.security.headers.referrerPolicy"
      labelFallback="Referrer-Policy"
      helpKey="headers.referrerPolicy"
      options={[
        { value: 'no-referrer', label: 'no-referrer' },
        { value: 'same-origin', label: 'same-origin' },
        { value: 'strict-origin-when-cross-origin', label: 'strict-origin-when-cross-origin' },
        { value: 'no-referrer-when-downgrade', label: 'no-referrer-when-downgrade' },
      ]}
    />
  </div>
  <TextareaField
    {...kit}
    model="cfg.security.headers.csp"
    rows={4}
    labelFallback="Content-Security-Policy (vacío = no se envía header)"
    helpKey="headers.csp"
  />
  <TextField
    {...kit}
    model="cfg.security.headers.permissionsPolicy"
    labelFallback="Permissions-Policy"
    helpKey="headers.permissionsPolicy"
  />

  <h3 style="margin-top:1.5rem">HSTS (Strict-Transport-Security)</h3>
  <p class="muted panel-intro">
    Sólo se envía si el request es HTTPS. 'auto' lo activa automáticamente
    en deployments HTTPS (recomendado). 'never' desactiva. Cuidado con
    max-age: una vez activado, los browsers lo recuerdan.
  </p>
  <div class="form-row">
    <SelectField
      {...kit}
      model="cfg.security.headers.hsts"
      labelFallback="Modo"
      helpKey="headers.hsts"
      options={[
        { value: 'auto', label: 'Auto (default, recomendado)' },
        { value: 'always', label: 'Siempre forzar' },
        { value: 'never', label: 'Nunca' },
      ]}
    />
    <NumberField
      {...kit}
      model="cfg.security.headers.hstsMaxAge"
      min={0}
      max={63072000}
      labelFallback="Max-Age (segundos)"
      helpKey="headers.hstsMaxAge"
      hint="Default 31536000 (1 año). 0 desactiva."
    />
  </div>
  <div class="form-row">
    <ToggleField
      {...kit}
      model="cfg.security.headers.hstsIncludeSubDomains"
      labelFallback="includeSubDomains"
      helpKey="headers.hstsIncludeSubDomains"
      hint="Activar SÓLO si todos los subdominios son HTTPS."
    />
    <ToggleField
      {...kit}
      model="cfg.security.headers.hstsPreload"
      labelFallback="preload"
      helpKey="headers.hstsPreload"
      hint="Para enviar a hstspreload.org. Requiere includeSubDomains y max-age ≥ 1 año."
    />
  </div>
</div>
