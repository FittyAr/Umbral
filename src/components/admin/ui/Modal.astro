---
/**
 * Modal del admin: `template x-if` + backdrop que cierra al click afuera y con
 * Escape, más el header con título y botón de cerrar.
 *
 * El cuerpo va en el slot por defecto; el pie en el slot `footer`.
 */
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
  /** Expresión Alpine que controla la visibilidad, ej: `showPresetsModal`. */
  show: string;
  /** Expresión Alpine que cierra el modal, ej: `showPresetsModal = false`. */
  close: string;
  titleKey?: string;
  titleFallback?: string;
  titleExpr?: string;
  /** Clases extra sobre `.modal`, ej: `modal--wide`. */
  modalClass?: string;
  modalStyle?: string;
  /** Texto accesible del botón de cerrar. */
  closeLabel?: string;
}

const {
  useI18n,
  tr,
  show,
  close,
  titleKey,
  titleFallback = '',
  titleExpr,
  modalClass,
  modalStyle,
  closeLabel,
} = Astro.props;

const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
const titleText = titleKey ? t(titleKey, titleFallback) : titleFallback;
const closeText = closeLabel ?? t('common.close', 'Cerrar');
const hasFooter = Astro.slots.has('footer');
const titleId = `modal-title-${Math.random().toString(36).slice(2, 10)}`;
---

<template x-if={show}>
  <!-- Escape en el backdrop (con .stop) y no en window: con modales
       apilados (el selector de íconos dentro del editor, la ayuda arriba)
       se cerraban todos a la vez. El foco queda atrapado adentro mientras
       está abierto y vuelve al elemento anterior al cerrar. -->
  <div class="modal-backdrop" @click.self={close} @keydown.escape.stop={close}>
    <div
      class:list={['modal', modalClass]}
      style={modalStyle}
      role="dialog"
      aria-modal="true"
      aria-labelledby={titleId}
      x-init="trapFocusLater($el)"
    >
      <div class="modal-header">
        <h2 id={titleId} x-text={titleExpr}>{titleText}</h2>
        <button type="button" class="btn btn-ghost btn-sm" @click={close} aria-label={closeText}>✕</button>
      </div>
      <slot />
      {
        hasFooter && (
          <div class="modal-footer">
            <slot name="footer" />
          </div>
        )
      }
    </div>
  </div>
</template>
