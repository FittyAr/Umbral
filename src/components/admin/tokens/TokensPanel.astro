---
import PanelHeader from '../ui/PanelHeader.astro';
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
/** Literal JS entre comillas simples, para inyectar texto traducido en expresiones Alpine. */
const q = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
---

<div class="panel" :class="tab==='tokens' && 'active'">
  <PanelHeader {...kit} titleExpr="tabTokens()" titleKey="admin.tab.tokens" titleFallback="Tokens API" helpKey="advanced.apiTokens">
    <Fragment slot="intro">
    {t('admin.tokens.intro', 'Tokens Bearer para el CLI companion, scripts o integraciones de CI/CD. El token plano solo se muestra una vez al generarlo.')}
    </Fragment>
  </PanelHeader>

  <div class="api-tokens-list">
    <template x-for="tok in cfgList('apiTokens')" :key="tok.id">
      <div class="webhook-item">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap">
          <div style="flex:1;min-width:0">
            <div style="font-weight:600" x-text="tok.name"></div>
            <div style="font-size:0.78rem;color:var(--text-subtle);font-family:ui-monospace,Menlo,Consolas,monospace">
              <span x-text="'•••• •••• •••• ' + tok.tokenLast4"></span>
              <span :class="tok.scope === 'write' ? 'user-role-badge role-admin' : 'user-role-badge role-viewer'" x-text="tok.scope"></span>
            </div>
            <div style="font-size:0.7rem;color:#64748b;margin-top:0.25rem">
              <span x-text={`${q(t('admin.tokens.created', 'Creado:') + ' ')} + formatDate(tok.createdAt)`}></span>
              <span x-show="tok.expiresAt" x-text={`${q(' · ' + t('admin.tokens.expires', 'Expira:') + ' ')} + formatDate(tok.expiresAt)`}></span>
            </div>
          </div>
          <div style="display:flex;gap:0.4rem;flex-shrink:0">
            <button type="button" class="btn btn-sm btn-danger" @click="revokeToken(tok.id)">{t('admin.tokens.revoke', 'Revocar')}</button>
          </div>
        </div>
      </div>
    </template>
    <p x-show="cfgList('apiTokens').length === 0" class="muted" style="padding:0.5rem 0">
      {t('admin.tokens.empty', 'No hay tokens generados.')}
    </p>
  </div>

  <details style="margin-top:1rem;background:var(--surface);padding:1rem;border-radius:8px;border:1px solid var(--border)">
    <summary style="cursor:pointer;color:var(--text);font-weight:500;font-size:0.9rem">{t('admin.tokens.addSummary', '+ Generar nuevo token')}</summary>
    <div class="form-row" style="margin-top:0.75rem">
      <div class="form-group" style="flex:1">
        <label>{t('admin.tokens.name', 'Nombre o propósito')}</label>
        <input type="text" x-model="newToken.name" placeholder={t('admin.tokens.namePlaceholder', 'CLI deploy / Script backup')} maxlength="60" />
      </div>
      <div class="form-group" style="width:120px">
        <label>{t('admin.tokens.scope', 'Permiso')}</label>
        <select x-model="newToken.scope">
          <option value="read">{t('admin.tokens.scopeRead', 'Lectura')}</option>
          <option value="write">{t('admin.tokens.scopeWrite', 'Escritura')}</option>
        </select>
      </div>
      <div class="form-group" style="width:140px">
        <label>{t('admin.tokens.expiresIn', 'Expira en')}</label>
        <select x-model.number="newToken.expiresInDays">
          <option value="0">{t('admin.tokens.never', 'Nunca')}</option>
          <option value="30">{t('admin.tokens.days30', '30 días')}</option>
          <option value="90">{t('admin.tokens.days90', '90 días')}</option>
          <option value="365">{t('admin.tokens.year1', '1 año')}</option>
        </select>
      </div>
    </div>
    <button type="button" class="btn btn-primary" @click="generateToken()" :disabled="!newToken.name" style="margin-top:0.5rem">{t('admin.tokens.generate', 'Generar token')}</button>
  </details>
</div>
