---
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="panel" :class="tab==='tokens' && 'active'">
  <h2 style="margin-top:0;display:flex;align-items:center;gap:0.35rem"><span x-text="tabTokens()">Tokens API</span><button type="button" class="help-icon" @click="showHelp('advanced.apiTokens')" :title="helpTooltipLabel()">?</button></h2>
  <p style="color:#94a3b8;font-size:0.85rem;margin-bottom:1.25rem">
    Tokens Bearer para el CLI companion, scripts o integraciones de CI/CD. El token plano solo se muestra una vez al generarlo.
  </p>

  <div class="api-tokens-list">
    <template x-for="tok in (cfg?.apiTokens?.items || [])" :key="tok.id">
      <div class="webhook-item">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap">
          <div style="flex:1;min-width:0">
            <div style="font-weight:600" x-text="tok.name"></div>
            <div style="font-size:0.78rem;color:#94a3b8;font-family:ui-monospace,Menlo,Consolas,monospace">
              <span x-text="`•••• •••• •••• ${tok.tokenLast4}`"></span>
              <span :class="tok.scope === 'write' ? 'user-role-badge role-admin' : 'user-role-badge role-viewer'" x-text="tok.scope"></span>
            </div>
            <div style="font-size:0.7rem;color:#64748b;margin-top:0.25rem">
              <span x-text="`Creado: ${new Date(tok.createdAt).toLocaleDateString()}`"></span>
              <span x-show="tok.expiresAt" x-text="` · Expira: ${new Date(tok.expiresAt).toLocaleDateString()}`"></span>
            </div>
          </div>
          <div style="display:flex;gap:0.4rem;flex-shrink:0">
            <button type="button" class="btn btn-sm btn-danger" @click="revokeToken(tok.id)">Revocar</button>
          </div>
        </div>
      </div>
    </template>
    <p x-show="!cfg?.apiTokens?.items || cfg.apiTokens.items.length === 0" class="muted" style="padding:0.5rem 0">
      No hay tokens generados.
    </p>
  </div>

  <details style="margin-top:1rem;background:var(--surface);padding:1rem;border-radius:8px;border:1px solid var(--border)">
    <summary style="cursor:pointer;color:var(--text);font-weight:500;font-size:0.9rem">+ Generar nuevo token</summary>
    <div class="form-row" style="margin-top:0.75rem">
      <div class="form-group" style="flex:1">
        <label>Nombre o propósito</label>
        <input type="text" x-model="newToken.name" placeholder="CLI deploy / Script backup" maxlength="60" />
      </div>
      <div class="form-group" style="width:120px">
        <label>Permiso</label>
        <select x-model="newToken.scope">
          <option value="read">Lectura</option>
          <option value="write">Escritura</option>
        </select>
      </div>
      <div class="form-group" style="width:140px">
        <label>Expira en</label>
        <select x-model.number="newToken.expiresInDays">
          <option value="0">Nunca</option>
          <option value="30">30 días</option>
          <option value="90">90 días</option>
          <option value="365">1 año</option>
        </select>
      </div>
    </div>
    <button type="button" class="btn btn-primary" @click="generateToken()" :disabled="!newToken.name" style="margin-top:0.5rem">Generar token</button>
  </details>
</div>
