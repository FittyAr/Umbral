---
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="panel" :class="tab==='maintenance' && 'active'">
  <h2 style="margin-top:0;display:flex;align-items:center;gap:0.35rem"><span x-text="maintenanceTitle()">Mantenimiento</span><button type="button" class="help-icon" @click="showHelp('advanced.maintenance')" :title="helpTooltipLabel()">?</button></h2>
  <p style="color:#94a3b8;font-size:0.85rem;margin-bottom:1.25rem" x-html="maintenanceIntro()">
    Programa ventanas donde una (o todas) las cards están en mantenimiento. Durante la ventana, las cards muestran badge ámbar y NO disparan webhooks de health_fail.
  </p>

  <div class="maintenance-list">
    <template x-for="(mw, idx) in (cfg?.maintenanceWindows?.items || [])" :key="mw.id">
      <div class="maintenance-item" :class="isMaintenanceActive(mw) && 'maintenance-active'">
        <div style="flex:1;min-width:0">
          <div style="font-weight:600" x-text="mw.reason || '(sin razón)'"></div>
          <div style="font-size:0.78rem;color:#94a3b8">
            <span x-text="formatMwTime(mw.startsAt)"></span> → <span x-text="formatMwTime(mw.endsAt)"></span>
            <span x-show="isMaintenanceActive(mw)" style="color:#fbbf24;margin-left:0.4rem">⏱ <span x-text="formatMwRemaining(mw.endsAt)"></span></span>
          </div>
          <div style="font-size:0.7rem;color:#64748b;margin-top:0.25rem">
            Cards: <span x-text="mw.cardIds.join(', ')"></span>
            <span :style="`color: ${mw.enabled ? '#4ade80' : '#94a3b8'}`" x-text="` · ${mw.enabled ? 'activa' : 'deshabilitada'}`"></span>
          </div>
        </div>
        <div style="display:flex;gap:0.4rem;flex-shrink:0">
          <button type="button" class="btn btn-sm btn-ghost" @click="removeMaintenance(idx)">×</button>
        </div>
      </div>
    </template>
    <p x-show="!cfg?.maintenanceWindows?.items || cfg.maintenanceWindows.items.length === 0" class="muted" style="padding:0.5rem 0">
      No hay ventanas programadas.
    </p>
  </div>

  <details style="margin-top:1rem;background:var(--surface);padding:1rem;border-radius:8px;border:1px solid var(--border)">
    <summary style="cursor:pointer;color:var(--text);font-weight:500;font-size:0.9rem">+ Programar ventana</summary>
    <div class="form-row" style="margin-top:0.75rem">
      <div class="form-group" style="flex:1">
        <label>Cards afectadas</label>
        <select x-model="newMaintenance.cardMode" @change="newMaintenance.cardIds = []" style="margin-bottom:0.3rem">
          <option value="all">Todas las cards (*)</option>
          <option value="specific">Cards específicas</option>
        </select>
        <select x-show="newMaintenance.cardMode === 'specific'" x-model="newMaintenance.cardIds" multiple size="4" style="min-height:5rem">
          <template x-for="c in cfg?.cards || []" :key="c.id">
            <option :value="c.id" x-text="c.title || c.id"></option>
          </template>
        </select>
        <small x-show="newMaintenance.cardMode === 'all'" style="color:var(--text-faint);font-size:0.72rem">Aplica a todas las cards activas.</small>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label>Inicio (UTC)</label>
        <input type="datetime-local" x-model="newMaintenance.startsAt" />
      </div>
      <div class="form-group" style="flex:1">
        <label>Fin (UTC)</label>
        <input type="datetime-local" x-model="newMaintenance.endsAt" />
      </div>
    </div>
    <div class="form-group">
      <label>Razón</label>
      <input type="text" x-model="newMaintenance.reason" placeholder="Deploy v2.1, migración DB, etc." maxlength="120" />
    </div>
    <button type="button" class="btn btn-primary" @click="addMaintenance()" style="margin-top:0.5rem" x-text="maintenanceAddLabel()">Programar</button>
  </details>
</div>
