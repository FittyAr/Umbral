---
import ColorField from '../ui/ColorField.astro';
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
import SelectField from '../ui/SelectField.astro';
import TabBar from '../ui/TabBar.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);

/** Selector de modo para los tokens que tienen valor separado en dark y light. */
const modeTabs = [
  { id: 'dark', label: 'Dark' },
  { id: 'light', label: 'Light' },
];

const iconTintOptions = [
  { value: 'original', key: 'admin.theme.colors.iconTintOriginal', label: 'Original (sin tintar)' },
  { value: 'accent', key: 'admin.theme.colors.iconTintAccent', label: 'Color de acento' },
  { value: 'text', key: 'admin.theme.colors.iconTintText', label: 'Color de texto' },
  { value: 'custom', key: 'admin.theme.colors.iconTintCustom', label: 'Color personalizado' },
];

const colorModeOptions = [
  { value: 'auto', key: 'admin.theme.colors.modeAuto', label: 'Auto' },
  { value: 'dark', key: 'admin.theme.colors.modeDark', label: 'Oscuro' },
  { value: 'light', key: 'admin.theme.colors.modeLight', label: 'Claro' },
];

const autoStrategyOptions = [
  { value: 'system', key: 'admin.theme.colors.autoSystem', label: 'Sistema (prefers-color-scheme)' },
  { value: 'schedule', key: 'admin.theme.colors.autoSchedule', label: 'Horario (7–19 claro)' },
];
---

<h3 x-text="themeSectionColors()">{t('admin.theme.section.colors', 'Colores')}</h3>

<div class="form-row">
  <ColorField
    useI18n={useI18n}
    tr={tr}
    model="cfg.theme.accentColor"
    labelKey="admin.theme.colors.accent"
    labelFallback="Color de acento"
    labelExpr="themeAccentLabel()"
    helpKey="theme.accentColor"
  />
  <SelectField
    useI18n={useI18n}
    tr={tr}
    model="cfg.theme.iconTint"
    options={iconTintOptions}
    labelKey="admin.theme.colors.iconTint"
    labelFallback="Tinte de iconos"
    labelExpr="themeIconTintLabel()"
    helpKey="theme.iconTint"
  />
</div>

<FormGroup
  useI18n={useI18n}
  tr={tr}
  labelKey="admin.theme.colors.iconCustom"
  labelFallback="Color de icono (por modo)"
  labelExpr="themeIconCustomLabel()"
  helpKey="theme.iconColor"
  show="cfg.theme.iconTint==='custom'"
>
  <TabBar
    useI18n={useI18n}
    tr={tr}
    state="themeTextEditMode"
    items={modeTabs}
    variant="theme-advanced-tabs"
    style="margin-bottom:0.5rem"
  />
  <div class="theme-color-field">
    <input type="color" class="color-swatch" :value="getModeToken('icon')" @input="setModeToken('icon', $event.target.value)" />
    <input type="text" :value="getModeToken('icon')" @input="setModeToken('icon', $event.target.value)" placeholder="#60a5fa" />
  </div>
</FormGroup>

<div class="form-row">
  <SelectField
    useI18n={useI18n}
    tr={tr}
    model="cfg.theme.colorMode"
    options={colorModeOptions}
    labelKey="admin.theme.colors.mode"
    labelFallback="Modo de color"
    labelExpr="themeColorModeLabel()"
    helpKey="theme.colorMode"
  />
  <SelectField
    useI18n={useI18n}
    tr={tr}
    model="cfg.theme.autoStrategy"
    options={autoStrategyOptions}
    labelKey="admin.theme.colors.autoStrategy"
    labelFallback="Estrategia auto"
    labelExpr="themeAutoStrategyLabel()"
    helpKey="theme.autoStrategy"
    show="cfg.theme.colorMode==='auto'"
  />
</div>

<h4 style="margin:1rem 0 0.5rem;font-size:0.9rem;display:flex;align-items:center;gap:0.35rem">
  <span x-text="themeTextRampTitle()">{t('admin.theme.colors.textRamp', 'Rampa de texto por modo')}</span>
  <HelpIcon helpKey="theme.textColor" />
</h4>
<TabBar
  useI18n={useI18n}
  tr={tr}
  state="themeTextEditMode"
  items={modeTabs}
  variant="theme-advanced-tabs"
  style="margin-bottom:0.75rem"
/>

<div class="theme-token-list">
  <template x-for="key in ['text','textMuted','textSubtle','textFaint']" :key="key">
    <div class="theme-token-row">
      <label x-text="'--' + key.replace(/([A-Z])/g, '-$1').toLowerCase()"></label>
      <input type="color" class="color-swatch" :value="tokenColorInputForMode(key)" @input="setModeToken(key, $event.target.value)" />
      <input type="text" :value="getModeToken(key)" @input="setModeToken(key, $event.target.value)" :placeholder="themeTokenDefaultPlaceholder(key)" />
      <span class="theme-contrast-badge" :class="themeContrastClass(key)" x-text="themeContrastLabel(key)" x-show="key==='text'"></span>
    </div>
  </template>
</div>

<p class="theme-section-desc" style="margin-top:0.35rem;font-size:0.78rem" x-text="themeTextColorLegacyHint()">
  {t('admin.theme.colors.textLegacyHint', 'El campo legacy textColor del JSON se asigna automáticamente al modo que corresponda por luminancia.')}
</p>

<div style="margin-top:0.75rem;padding:0.65rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface)">
  <div style="font-size:0.78rem;color:var(--text-subtle);margin-bottom:0.45rem;display:flex;align-items:center;gap:0.35rem">
    <span x-text="themePalettePreviewLabel()">{t('admin.theme.colors.palettePreview', 'Paleta derivada del acento')}</span>
    <HelpIcon helpKey="theme.derivedPalette" />
  </div>
  <div style="display:flex;gap:0.35rem;flex-wrap:wrap">
    <div :style="`width:32px;height:32px;border-radius:6px;background:${cfg.theme.accentColor}`" :title="cfg.theme.accentColor"></div>
    <div :style="themePreviewAccentMutedStyle()" title="accent-muted"></div>
    <div :style="themePreviewAccentStrongStyle()" title="accent-strong"></div>
  </div>
</div>
