---
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<h3 x-text="themeSectionCards()">{t('admin.theme.section.cards', 'Tarjetas')}</h3>

<FormGroup {...kit} labelExpr="themeCardStyleLabel()" labelKey="admin.theme.cards.style" labelFallback="Estilo de tarjeta" helpKey="theme.cardStyle">
  <select x-model="cfg.theme.cardStyle">
    <option value="glass">{t('admin.theme.cards.glass', 'Glass (blur)')}</option>
    <option value="flat">{t('admin.theme.cards.flat', 'Flat')}</option>
    <option value="outlined">{t('admin.theme.cards.outlined', 'Outlined')}</option>
  </select>
</FormGroup>

<div class="form-row" x-show="cfg.theme.tokens">
  <div class="form-group">
    <label>
      <span x-text="themeCardBlurLabel()">{t('admin.theme.cards.blur', 'Blur glass')}</span>
      (<span x-text="cfg.theme.tokens?.shared?.cardBlur ?? 12"></span>px)
      <HelpIcon helpKey="theme.cardBlur" />
    </label>
    <input type="range" min="0" max="40" :value="cfg.theme.tokens?.shared?.cardBlur ?? 12" @input="setSharedToken('cardBlur', +$event.target.value)" />
  </div>
  <div class="form-group">
    <label>
      <span x-text="themeCardBorderLabel()">{t('admin.theme.cards.border', 'Ancho borde')}</span>
      (<span x-text="cfg.theme.tokens?.shared?.cardBorderWidth ?? 1.5"></span>px)
      <HelpIcon helpKey="theme.cardBorderWidth" />
    </label>
    <input type="range" min="0" max="4" step="0.5" :value="cfg.theme.tokens?.shared?.cardBorderWidth ?? 1.5" @input="setSharedToken('cardBorderWidth', +$event.target.value)" />
  </div>
</div>

<FormGroup {...kit} labelExpr="themeGroupLayoutLabel()" labelKey="admin.theme.cards.groupLayout" labelFallback="Disposición de grupos" helpKey="theme.groupLayout">
  <select x-model="cfg.theme.groupLayout">
    <option value="vertical">{t('admin.theme.cards.groupVertical', 'Vertical (apilados)')}</option>
    <option value="horizontal">{t('admin.theme.cards.groupHorizontal', 'Horizontal (columnas)')}</option>
  </select>
</FormGroup>
