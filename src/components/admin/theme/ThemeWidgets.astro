---
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<h3 x-text="themeSectionWidgets()">{t('admin.theme.section.widgets', 'Widgets')}</h3>
<p class="theme-section-desc" x-text="themeWidgetsIntro()">{t('admin.theme.widgets.intro', 'Encendé los que quieras en el header / pie. Apagados = cero overhead.')}</p>

<div class="form-row">
  <div class="form-group">
    <label>
      <input type="checkbox" x-model="cfg.theme.showClock" />
      <span x-text="themeShowClockLabel()">{t('admin.theme.widgets.clock', 'Mostrar reloj')}</span>
      <button type="button" class="help-icon" @click="showHelp('theme.showClock')" :title="helpTooltipLabel()">?</button>
    </label>
  </div>
  <div class="form-group">
    <label>
      <input type="checkbox" x-model="cfg.theme.showRefresh" />
      <span x-text="themeShowRefreshLabel()">{t('admin.theme.widgets.refresh', 'Mostrar botón refresh')}</span>
      <button type="button" class="help-icon" @click="showHelp('theme.showRefresh')" :title="helpTooltipLabel()">?</button>
    </label>
  </div>
  <div class="form-group">
    <label>
      <input type="checkbox" x-model="cfg.theme.showStatusBar" />
      <span x-text="themeShowStatusBarLabel()">{t('admin.theme.widgets.statusBar', 'Mostrar status bar')}</span>
      <button type="button" class="help-icon" @click="showHelp('theme.showStatusBar')" :title="helpTooltipLabel()">?</button>
    </label>
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <label>
      <input type="checkbox" x-model="cfg.theme.showModeToggle" />
      <span x-text="themeShowModeToggleLabel()">{t('admin.theme.widgets.modeToggle', 'Mostrar toggle claro/oscuro')}</span>
      <button type="button" class="help-icon" @click="showHelp('theme.showModeToggle')" :title="helpTooltipLabel()">?</button>
    </label>
  </div>
</div>

<div class="form-row" x-show="cfg.theme.showClock">
  <div class="form-group">
    <label>
      <span x-text="themeClockPositionLabel()">{t('admin.theme.widgets.clockPosition', 'Posición del reloj')}</span>
      <button type="button" class="help-icon" @click="showHelp('theme.clockPosition')" :title="helpTooltipLabel()">?</button>
    </label>
    <select x-model="cfg.theme.clockPosition">
      <option value="header-left">{t('admin.theme.widgets.clockLeft', 'Header izquierda')}</option>
      <option value="header-right">{t('admin.theme.widgets.clockRight', 'Header derecha')}</option>
    </select>
  </div>
  <div class="form-group">
    <label>
      <span x-text="themeClockFormatLabel()">{t('admin.theme.widgets.clockFormat', 'Formato del reloj')}</span>
      <button type="button" class="help-icon" @click="showHelp('theme.clockFormat')" :title="helpTooltipLabel()">?</button>
    </label>
    <select x-model="cfg.theme.clockFormat">
      <option value="24h">24h</option>
      <option value="12h">12h</option>
    </select>
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <label>
      <span x-text="themeHeaderOpacityLabel()">{t('admin.theme.widgets.headerOpacity', 'Opacidad header')}</span>
      (<span x-text="cfg.theme.headerOpacity"></span>)
      <button type="button" class="help-icon" @click="showHelp('theme.headerOpacity')" :title="helpTooltipLabel()">?</button>
    </label>
    <input type="range" min="0" max="1" step="0.05" x-model.number="cfg.theme.headerOpacity" />
  </div>
  <div class="form-group">
    <label>
      <span x-text="themeFooterOpacityLabel()">{t('admin.theme.widgets.footerOpacity', 'Opacidad footer')}</span>
      (<span x-text="cfg.theme.footerOpacity"></span>)
      <button type="button" class="help-icon" @click="showHelp('theme.footerOpacity')" :title="helpTooltipLabel()">?</button>
    </label>
    <input type="range" min="0" max="1" step="0.05" x-model.number="cfg.theme.footerOpacity" />
  </div>
</div>
