---
import ToggleField from '../ui/ToggleField.astro';
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<h3 x-text="themeSectionWidgets()">{t('admin.theme.section.widgets', 'Widgets')}</h3>
<p class="theme-section-desc" x-text="themeWidgetsIntro()">{t('admin.theme.widgets.intro', 'Encendé los que quieras en el header / pie. Apagados = cero overhead.')}</p>

<div class="form-row">
  <ToggleField {...kit} model="cfg.theme.showClock" labelExpr="themeShowClockLabel()" labelKey="admin.theme.widgets.clock" labelFallback="Mostrar reloj" helpKey="theme.showClock" />
  <ToggleField {...kit} model="cfg.theme.showRefresh" labelExpr="themeShowRefreshLabel()" labelKey="admin.theme.widgets.refresh" labelFallback="Mostrar botón refresh" helpKey="theme.showRefresh" />
  <ToggleField {...kit} model="cfg.theme.showStatusBar" labelExpr="themeShowStatusBarLabel()" labelKey="admin.theme.widgets.statusBar" labelFallback="Mostrar status bar" helpKey="theme.showStatusBar" />
</div>

<div class="form-row">
  <ToggleField {...kit} model="cfg.theme.showModeToggle" labelExpr="themeShowModeToggleLabel()" labelKey="admin.theme.widgets.modeToggle" labelFallback="Mostrar toggle claro/oscuro" helpKey="theme.showModeToggle" />
</div>

<div class="form-row" x-show="cfg.theme.showClock">
  <FormGroup {...kit} labelExpr="themeClockPositionLabel()" labelKey="admin.theme.widgets.clockPosition" labelFallback="Posición del reloj" helpKey="theme.clockPosition">
    <select x-model="cfg.theme.clockPosition">
      <option value="header-left">{t('admin.theme.widgets.clockLeft', 'Header izquierda')}</option>
      <option value="header-right">{t('admin.theme.widgets.clockRight', 'Header derecha')}</option>
    </select>
  </FormGroup>
  <FormGroup {...kit} labelExpr="themeClockFormatLabel()" labelKey="admin.theme.widgets.clockFormat" labelFallback="Formato del reloj" helpKey="theme.clockFormat">
    <select x-model="cfg.theme.clockFormat">
      <option value="24h">24h</option>
      <option value="12h">12h</option>
    </select>
  </FormGroup>
</div>

<div class="form-row">
  <div class="form-group">
    <label>
      <span x-text="themeHeaderOpacityLabel()">{t('admin.theme.widgets.headerOpacity', 'Opacidad header')}</span>
      (<span x-text="cfg.theme.headerOpacity"></span>)
      <HelpIcon helpKey="theme.headerOpacity" />
    </label>
    <input type="range" min="0" max="1" step="0.05" x-model.number="cfg.theme.headerOpacity" />
  </div>
  <div class="form-group">
    <label>
      <span x-text="themeFooterOpacityLabel()">{t('admin.theme.widgets.footerOpacity', 'Opacidad footer')}</span>
      (<span x-text="cfg.theme.footerOpacity"></span>)
      <HelpIcon helpKey="theme.footerOpacity" />
    </label>
    <input type="range" min="0" max="1" step="0.05" x-model.number="cfg.theme.footerOpacity" />
  </div>
</div>
