---
import RangeField from '../ui/RangeField.astro';
import SelectField from '../ui/SelectField.astro';
import TabBar from '../ui/TabBar.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);

const breakpoints = [
  { id: 'desktop', key: 'admin.layout.breakpoint.desktop', label: 'Desktop', labelExpr: 'layoutBreakpointDesktop()' },
  { id: 'tablet', key: 'admin.layout.breakpoint.tablet', label: 'Tablet', labelExpr: 'layoutBreakpointTablet()' },
  { id: 'mobile', key: 'admin.layout.breakpoint.mobile', label: 'Mobile', labelExpr: 'layoutBreakpointMobile()' },
];

/** Un slider de columnas por breakpoint, cada uno con su propio rango. */
const columnFields = [
  {
    breakpoint: 'desktop',
    model: 'cfg.layout.columnsDesktop',
    labelKey: 'admin.layout.columnsDesktop',
    labelFallback: 'Columnas desktop',
    labelExpr: 'layoutColumnsDesktopLabel()',
    helpKey: 'layout.columnsDesktop',
    min: 2,
    max: 8,
  },
  {
    breakpoint: 'tablet',
    model: 'cfg.layout.columnsTablet',
    labelKey: 'admin.layout.columnsTablet',
    labelFallback: 'Columnas tablet',
    labelExpr: 'layoutColumnsTabletLabel()',
    helpKey: 'layout.columnsTablet',
    min: 2,
    max: 6,
  },
  {
    breakpoint: 'mobile',
    model: 'cfg.layout.columnsMobile',
    labelKey: 'admin.layout.columnsMobile',
    labelFallback: 'Columnas mobile',
    labelExpr: 'layoutColumnsMobileLabel()',
    helpKey: 'layout.columnsMobile',
    min: 1,
    max: 3,
  },
];

const alignOptions = [
  { value: 'center', key: 'admin.layout.gridAlign.center', label: 'Centrado' },
  { value: 'left', key: 'admin.layout.gridAlign.left', label: 'Izquierda' },
];
---

<section class="layout-section">
  <h3 x-text="layoutSectionGrid()">{t('admin.layout.section.grid', 'Grilla')}</h3>

  <TabBar
    useI18n={useI18n}
    tr={tr}
    state="layoutBreakpoint"
    items={breakpoints}
    variant="layout-breakpoint-tabs"
    onSelect="setLayoutBreakpoint('$id')"
  />

  {
    columnFields.map((field) => (
      <RangeField
        useI18n={useI18n}
        tr={tr}
        model={field.model}
        min={field.min}
        max={field.max}
        labelKey={field.labelKey}
        labelFallback={field.labelFallback}
        labelExpr={field.labelExpr}
        helpKey={field.helpKey}
        withNumber
        show={`layoutBreakpoint==='${field.breakpoint}'`}
      />
    ))
  }

  <div class="form-row">
    <RangeField
      useI18n={useI18n}
      tr={tr}
      model="cfg.layout.gap"
      min={0}
      max={3}
      step={0.25}
      labelKey="admin.layout.gap"
      labelFallback="Espaciado entre tarjetas"
      labelExpr="layoutGapLabel()"
      helpKey="layout.gap"
      valueExpr="(cfg.layout.gap ?? 1).toFixed(1)"
      unit="rem"
      withNumber
    />
    <RangeField
      useI18n={useI18n}
      tr={tr}
      model="cfg.layout.maxWidth"
      min={720}
      max={2560}
      step={40}
      labelKey="admin.layout.maxWidth"
      labelFallback="Ancho máximo del contenido"
      labelExpr="layoutMaxWidthLabel()"
      helpKey="layout.maxWidth"
      unit="px"
      withNumber
    />
  </div>

  <div class="form-row">
    <RangeField
      useI18n={useI18n}
      tr={tr}
      model="cfg.layout.categoryGap"
      min={0}
      max={6}
      step={0.25}
      labelKey="admin.layout.categoryGap"
      labelFallback="Espaciado entre categorías"
      labelExpr="layoutCategoryGapLabel()"
      helpKey="layout.categoryGap"
      valueExpr="(cfg.layout.categoryGap ?? 2).toFixed(2)"
      unit="rem"
      withNumber
    />
    <RangeField
      useI18n={useI18n}
      tr={tr}
      model="cfg.layout.ghostCategoryGap"
      min={0}
      max={6}
      step={0.05}
      labelKey="admin.layout.ghostCategoryGap"
      labelFallback="Espaciado de tarjetas sueltas"
      labelExpr="layoutGhostCategoryGapLabel()"
      helpKey="layout.ghostCategoryGap"
      valueExpr="(cfg.layout.ghostCategoryGap ?? 0.35).toFixed(2)"
      unit="rem"
      withNumber
    />
  </div>

  <SelectField
    useI18n={useI18n}
    tr={tr}
    model="cfg.layout.gridAlign"
    options={alignOptions}
    labelKey="admin.layout.gridAlign"
    labelFallback="Alineación del contenido"
    labelExpr="layoutGridAlignLabel()"
    helpKey="layout.gridAlign"
  />
</section>
