---
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<section class="layout-section">
  <h3 x-text="layoutSectionGrid()">{t('admin.layout.section.grid', 'Grilla')}</h3>

  <div class="layout-breakpoint-tabs">
    <button type="button" :class="layoutBreakpoint==='desktop' && 'active'" @click="setLayoutBreakpoint('desktop')">
      <span x-text="layoutBreakpointDesktop()">{t('admin.layout.breakpoint.desktop', 'Desktop')}</span>
    </button>
    <button type="button" :class="layoutBreakpoint==='tablet' && 'active'" @click="setLayoutBreakpoint('tablet')">
      <span x-text="layoutBreakpointTablet()">{t('admin.layout.breakpoint.tablet', 'Tablet')}</span>
    </button>
    <button type="button" :class="layoutBreakpoint==='mobile' && 'active'" @click="setLayoutBreakpoint('mobile')">
      <span x-text="layoutBreakpointMobile()">{t('admin.layout.breakpoint.mobile', 'Mobile')}</span>
    </button>
  </div>

  <div class="form-group" x-show="layoutBreakpoint==='desktop'">
    <label>
      <span x-text="layoutColumnsDesktopLabel()">{t('admin.layout.columnsDesktop', 'Columnas desktop')}</span>
      <button type="button" class="help-icon" @click="showHelp('layout.columnsDesktop')" :title="helpTooltipLabel()">?</button>
      (<span x-text="cfg.layout.columnsDesktop"></span>)
    </label>
    <div class="layout-range-row">
      <input type="range" min="2" max="8" step="1" x-model.number="cfg.layout.columnsDesktop" />
      <input type="number" min="2" max="8" x-model.number="cfg.layout.columnsDesktop" class="layout-num-input" />
    </div>
  </div>

  <div class="form-group" x-show="layoutBreakpoint==='tablet'">
    <label>
      <span x-text="layoutColumnsTabletLabel()">{t('admin.layout.columnsTablet', 'Columnas tablet')}</span>
      <button type="button" class="help-icon" @click="showHelp('layout.columnsTablet')" :title="helpTooltipLabel()">?</button>
      (<span x-text="cfg.layout.columnsTablet"></span>)
    </label>
    <div class="layout-range-row">
      <input type="range" min="2" max="6" step="1" x-model.number="cfg.layout.columnsTablet" />
      <input type="number" min="2" max="6" x-model.number="cfg.layout.columnsTablet" class="layout-num-input" />
    </div>
  </div>

  <div class="form-group" x-show="layoutBreakpoint==='mobile'">
    <label>
      <span x-text="layoutColumnsMobileLabel()">{t('admin.layout.columnsMobile', 'Columnas mobile')}</span>
      <button type="button" class="help-icon" @click="showHelp('layout.columnsMobile')" :title="helpTooltipLabel()">?</button>
      (<span x-text="cfg.layout.columnsMobile"></span>)
    </label>
    <div class="layout-range-row">
      <input type="range" min="1" max="3" step="1" x-model.number="cfg.layout.columnsMobile" />
      <input type="number" min="1" max="3" x-model.number="cfg.layout.columnsMobile" class="layout-num-input" />
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>
        <span x-text="layoutGapLabel()">{t('admin.layout.gap', 'Espaciado entre tarjetas')}</span>
        <button type="button" class="help-icon" @click="showHelp('layout.gap')" :title="helpTooltipLabel()">?</button>
        (<span x-text="(cfg.layout.gap ?? 1).toFixed(1)"></span>rem)
      </label>
      <div class="layout-range-row">
        <input type="range" min="0" max="3" step="0.25" x-model.number="cfg.layout.gap" />
        <input type="number" min="0" max="3" step="0.25" x-model.number="cfg.layout.gap" class="layout-num-input" />
      </div>
    </div>
    <div class="form-group">
      <label>
        <span x-text="layoutMaxWidthLabel()">{t('admin.layout.maxWidth', 'Ancho máximo del contenido')}</span>
        <button type="button" class="help-icon" @click="showHelp('layout.maxWidth')" :title="helpTooltipLabel()">?</button>
        (<span x-text="cfg.layout.maxWidth"></span>px)
      </label>
      <div class="layout-range-row">
        <input type="range" min="720" max="2560" step="40" x-model.number="cfg.layout.maxWidth" />
        <input type="number" min="720" max="2560" step="40" x-model.number="cfg.layout.maxWidth" class="layout-num-input" />
      </div>
    </div>
  </div>

  <div class="form-group">
    <label>
      <span x-text="layoutGridAlignLabel()">{t('admin.layout.gridAlign', 'Alineación del contenido')}</span>
      <button type="button" class="help-icon" @click="showHelp('layout.gridAlign')" :title="helpTooltipLabel()">?</button>
    </label>
    <select x-model="cfg.layout.gridAlign">
      <option value="center">{t('admin.layout.gridAlign.center', 'Centrado')}</option>
      <option value="left">{t('admin.layout.gridAlign.left', 'Izquierda')}</option>
    </select>
  </div>
</section>
