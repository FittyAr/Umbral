---
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="layout-preview-wrap">
  <div class="layout-preview-toolbar">
    <label>
      <span x-text="layoutPreviewLabel()">{t('admin.layout.preview.title', 'Vista previa')}</span>
      <button type="button" class="help-icon" @click="showHelp('layout.preview')" :title="helpTooltipLabel()">?</button>
    </label>
    <div class="layout-preview-viewport-btns">
      <button type="button" :class="layoutPreviewViewport==='mobile' && 'active'" @click="setLayoutPreviewViewport('mobile')">
        <span x-text="layoutPreviewMobile()">{t('admin.layout.preview.mobile', 'Móvil')}</span>
      </button>
      <button type="button" :class="layoutPreviewViewport==='tablet' && 'active'" @click="setLayoutPreviewViewport('tablet')">
        <span x-text="layoutPreviewTablet()">{t('admin.layout.preview.tablet', 'Tablet')}</span>
      </button>
      <button type="button" :class="layoutPreviewViewport==='desktop' && 'active'" @click="setLayoutPreviewViewport('desktop')">
        <span x-text="layoutPreviewDesktop()">{t('admin.layout.preview.desktop', 'Desktop')}</span>
      </button>
    </div>
  </div>

  <div class="layout-preview-scaler">
    <div
      class="layout-preview-frame"
      :style="layoutPreviewFrameStyle()"
      :data-viewport="layoutPreviewViewport"
      :data-compact="cfg.layout.compact ? 'true' : 'false'"
      :data-grid-align="cfg.layout.gridAlign || 'center'"
      :data-group-layout="cfg.theme.groupLayout || 'vertical'"
    >
      <div class="layout-preview-page" :style="layoutPreviewPageStyle()">
        <div
          class="layout-preview-groups"
          :class="cfg.theme.groupLayout === 'horizontal' ? 'layout-preview-groups-horizontal' : 'layout-preview-groups-vertical'"
        >
          <template x-for="group in layoutPreviewGroups()" :key="group.id">
            <section class="layout-preview-group" :data-ghost="group.isGhost ? 'true' : undefined">
              <h4 class="layout-preview-group-title" x-show="!group.isGhost" x-text="group.name"></h4>
              <div class="layout-preview-grid">
                <template x-for="(card, i) in group.cards" :key="group.id + '-' + i">
                  <div
                    class="layout-preview-card"
                    :data-style="cfg.theme.cardStyle"
                    :data-size="cfg.layout.cardSize"
                    :style="`border-radius:${cfg.layout.cardRadius ?? 12}px`"
                  >
                    <div
                      class="layout-preview-card-icon"
                      :style="`background:${cfg.theme.accentColor}22;color:${cfg.theme.accentColor}`"
                    ></div>
                    <span class="layout-preview-card-title" x-text="card.title"></span>
                    <p
                      class="layout-preview-card-desc"
                      x-show="cfg.layout.showDescriptions && card.description"
                      x-text="card.description"
                    ></p>
                  </div>
                </template>
              </div>
            </section>
          </template>
        </div>
      </div>
    </div>
  </div>
  <p class="layout-preview-meta" x-text="layoutPreviewMetaLabel()"></p>
</div>
