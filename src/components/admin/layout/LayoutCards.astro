---
import ToggleField from '../ui/ToggleField.astro';
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<section class="layout-section">
  <h3 x-text="layoutSectionCards()">{t('admin.layout.section.cards', 'Tarjetas')}</h3>

  <div class="form-row">
    <FormGroup {...kit} labelExpr="layoutCardSizeLabel()" labelKey="admin.layout.cardSize" labelFallback="Tamaño de tarjeta" helpKey="layout.cardSize">
      <select x-model="cfg.layout.cardSize">
        <option value="small">{t('admin.layout.cardSize.small', 'Chico')}</option>
        <option value="medium">{t('admin.layout.cardSize.medium', 'Mediano')}</option>
        <option value="large">{t('admin.layout.cardSize.large', 'Grande')}</option>
      </select>
    </FormGroup>
    <div class="form-group">
      <label>
        <span x-text="layoutCardRadiusLabel()">{t('admin.layout.cardRadius', 'Radio de esquinas')}</span>
        <HelpIcon helpKey="layout.cardRadius" />
        (<span x-text="cfg.layout.cardRadius"></span>px)
      </label>
      <div class="layout-range-row">
        <input type="range" min="0" max="32" step="1" x-model.number="cfg.layout.cardRadius" />
        <input type="number" min="0" max="32" step="1" x-model.number="cfg.layout.cardRadius" class="layout-num-input" />
      </div>
    </div>
  </div>

  <ToggleField {...kit} model="cfg.layout.showDescriptions" labelExpr="layoutShowDescriptionsLabel()" labelKey="admin.layout.showDescriptions" labelFallback="Mostrar descripciones" helpKey="layout.showDescriptions" />

  <ToggleField {...kit} model="cfg.layout.compact" labelExpr="layoutCompactLabel()" labelKey="admin.layout.compact" labelFallback="Modo compacto" helpKey="layout.compact" />
</section>
