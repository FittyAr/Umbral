---
import LayoutGrid from './LayoutGrid.astro';
import LayoutCards from './LayoutCards.astro';
import LayoutBehavior from './LayoutBehavior.astro';
import LayoutPreview from './LayoutPreview.astro';

interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="panel layout-panel-root" :class="tab==='layout' && 'active'">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
    <h2 style="margin:0" x-text="layoutTitle()">{t('admin.layout.title', 'Layout')}</h2>
  </div>

  <div class="layout-panel">
    <div class="layout-panel-form">
      <LayoutGrid useI18n={useI18n} tr={tr} />
      <LayoutCards useI18n={useI18n} tr={tr} />
      <LayoutBehavior useI18n={useI18n} tr={tr} />
    </div>

    <div class="layout-panel-preview-col">
      <LayoutPreview useI18n={useI18n} tr={tr} />
    </div>
  </div>
</div>
