---
import FormGroup from '../ui/FormGroup.astro';
import HelpIcon from '../ui/HelpIcon.astro';
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
}

const { useI18n, tr } = Astro.props;
const kit = { useI18n, tr };
const t = (key: string, fallback: string) => (useI18n ? tr(key) : fallback);
---

<div class="panel" :class="tab==='branding' && 'active'">
  <h2 style="margin-top:0">{t('admin.tab.branding', 'Branding')}</h2>
  <FormGroup {...kit} labelKey="admin.branding.companyName" labelFallback="Nombre de la empresa" helpKey="branding.companyName">
    <input type="text" x-model="cfg.branding.companyName" maxlength="80" />
  </FormGroup>
  <div class="form-row">
    <div class="form-group">
      <label>{t('admin.branding.logo', 'Logo')} <HelpIcon helpKey="branding.logo" /></label>
      <select x-model="cfg.branding.logo">
        <option value="">{t('admin.branding.noLogo', '— Sin logo (usar inicial) —')}</option>
        <template x-for="a in assets.filter(a => /\.(png|jpe?g|webp|svg)$/i.test(a.name))" :key="a.name">
          <option :value="a.url" x-text="a.name"></option>
        </template>
      </select>
      <div class="preview-box" x-show="cfg.branding.logo" style="display:flex;align-items:center;justify-content:center">
        <img :src="cfg.branding.logo" style="max-height:60px;max-width:200px" />
      </div>
    </div>
    <FormGroup {...kit} labelKey="admin.branding.favicon" labelFallback="Favicon" helpKey="branding.favicon">
      <select x-model="cfg.branding.favicon">
        <option value="">{t('admin.branding.defaultFavicon', '— Default —')}</option>
        <template x-for="a in assets.filter(a => /\.(png|jpe?g|webp|svg|ico)$/i.test(a.name))" :key="a.name">
          <option :value="a.url" x-text="a.name"></option>
        </template>
      </select>
    </FormGroup>
  </div>
</div>
