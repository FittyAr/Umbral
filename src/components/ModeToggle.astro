---
/**
 * Botón de modo claro/oscuro. El mismo markup estaba escrito cuatro veces
 * (portada, subpágina y las dos páginas de docs), SVG de sol incluido.
 *
 * El estado lo maneja `ThemeScript.astro`, que actualiza `aria-label`,
 * `aria-pressed` y el ícono según el modo activo.
 */
interface Props {
  useI18n: boolean;
  tr: (key: string) => string;
  /** Atributos que sólo usa la vista previa del admin. */
  themeWidget?: boolean;
  hidden?: boolean;
}

const { useI18n, tr, themeWidget = false, hidden = false } = Astro.props;
const label = useI18n ? tr('home.modeToggle') : 'Cambiar modo claro/oscuro';
const title = useI18n ? tr('home.modeToggleTitle') : 'Cambiar modo claro/oscuro';
---

<button
  data-theme-widget={themeWidget ? 'modeToggle' : undefined}
  data-action="toggle-mode"
  class="mode-toggle"
  style={hidden ? 'display:none' : undefined}
  aria-label={label}
  aria-pressed="false"
  title={title}
>
  <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
  </svg>
</button>
