---
import { promises as fs } from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import createDOMPurify from 'dompurify';
import { JSDOM } from 'jsdom';
import PublicLayout from '~/layouts/PublicLayout.astro';
import { getConfig } from '~/lib/config';
import { resolveIconUrl } from '~/lib/icons';

// dompurify necesita un window. En Node creamos uno con jsdom (que ya está
// en deps) y se lo pasamos. Esto sólo se ejecuta en SSR, no llega al cliente.
const purifyWindow = new JSDOM('').window;
const DOMPurify = createDOMPurify(purifyWindow as unknown as Window);

export const prerender = false;

const DOCS_DIR = path.join(process.cwd(), 'docs');
const { slug } = Astro.params;

// ── 1) Resolve the file path. Reject anything that tries to escape `docs/`.
function resolveDocFile(slugParam: string | undefined): { abs: string; rel: string } | null {
  if (!slugParam) return null;
  // Reject backslashes, NUL, leading slashes — normalize the path and
  // make sure it stays under DOCS_DIR after resolution.
  if (/[\\:\0]/.test(slugParam)) return null;
  const safe = slugParam
    .split('/')
    .map((p) => p.replace(/[^a-zA-Z0-9._-]/g, ''))
    .filter(Boolean)
    .join('/');
  if (!safe) return null;
  const abs = path.resolve(DOCS_DIR, `${safe}.md`);
  const rel = path.relative(DOCS_DIR, abs);
  if (rel.startsWith('..') || path.isAbsolute(rel)) return null;
  return { abs, rel };
}

const resolved = resolveDocFile(slug);
if (!resolved) {
  return new Response('Not found', { status: 404 });
}

let raw: string;
try {
  raw = await fs.readFile(resolved.abs, 'utf8');
} catch {
  return new Response('Not found', { status: 404 });
}
// Strip UTF-8 BOM if present. Notepad y PowerShell 5 `Set-Content -Encoding UTF8`
// lo agregan; si no lo sacamos, el primer H1 del archivo (ej: `# Quickstart
// Docker`) no matchea `/^#\s+/` porque la línea empieza con \uFEFF.
if (raw.charCodeAt(0) === 0xfeff) raw = raw.slice(1);

// ── 2) Parse and sanitize the markdown.
const titleMatch = raw.match(/^#\s+(.+?)$/m);
const pageTitle = titleMatch?.[1]?.replace(/^Umbral\s*—\s*/i, '').replace(/^Documentación\s*—\s*/i, '').trim() ?? 'Documentación';

marked.setOptions({
  gfm: true,
  breaks: false,
  pedantic: false,
});

const htmlBody = marked.parse(raw, { async: false }) as string;

// DOMPurify server-side: strip any dangerous tags that managed to slip
// through marked (e.g. <script>, on*= handlers, javascript: URLs).
// We use a permissive config because this is our own markdown, not user input.
const cleanBody = DOMPurify.sanitize(htmlBody, {
  ALLOWED_TAGS: [
    'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
    'p', 'br', 'hr', 'blockquote',
    'ul', 'ol', 'li',
    'strong', 'em', 'del', 'code', 'pre', 'kbd', 'samp', 'sub', 'sup',
    'a', 'img',
    'table', 'thead', 'tbody', 'tr', 'th', 'td',
    'div', 'span',
    'input', // checkboxes via GFM task list — safe
  ],
  ALLOWED_ATTR: ['href', 'title', 'alt', 'src', 'checked', 'disabled', 'type', 'class', 'rel', 'target', 'id'],
  ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto|tel|ftp):|[^a-z]|[a-z+.\-]+(?:[^a-z+.\-:]|$))/i,
  // Add `target="_blank"` + `rel="noopener noreferrer"` to external links.
  ADD_ATTR: ['target', 'rel'],
});

// Rewrite external links to open in a new tab.
const finalBody = cleanBody.replace(
  /<a\s+(?![^>]*\btarget=)([^>]*?)href="(https?:\/\/[^"]+)"([^>]*)>/g,
  '<a $1href="$2" target="_blank" rel="noopener noreferrer"$3>',
);

const config = await getConfig();
const logoUrl = resolveIconUrl(config.branding.logo);

// Breadcrumb: split the slug into sections
const crumbs = (slug ?? '').split('/').filter(Boolean);
const sectionLabels: Record<string, string> = {
  install: 'Instalación',
  config: 'Configuración',
  usage: 'Uso',
  dev: 'Desarrollo',
};
---
<PublicLayout config={config} title={`${pageTitle} — Documentación`}>
  <main class="page-wrap docs-page">
    <header class="header">
      {logoUrl && (
        <img src={logoUrl} alt={config.branding.companyName} class="header-logo" />
      )}
      <h1 class="header-title">Documentación</h1>
    </header>

    <nav class="docs-breadcrumb" aria-label="breadcrumb">
      <a href="/docs">← Índice</a>
      {crumbs.map((c, i) => {
        const href = '/docs/' + crumbs.slice(0, i + 1).join('/');
        const label = sectionLabels[c] ?? c;
        return (
          <>
            <span class="sep">/</span>
            {i === crumbs.length - 1
              ? <span class="current">{label}</span>
              : <a href={href}>{label}</a>
            }
          </>
        );
      })}
    </nav>

    <article class="docs-article">
      <div class="docs-content" set:html={finalBody}></div>
    </article>

    <footer style="margin-top:3rem;padding:1.5rem 0;border-top:1px solid var(--border);text-align:center;font-size:0.8rem;color:var(--text-faint)">
      <a href="/docs" style="color:var(--text-subtle)">← Volver al índice</a>
    </footer>
  </main>
</PublicLayout>
