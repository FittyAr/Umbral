---
import { promises as fs } from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import createDOMPurify from 'dompurify';
import { JSDOM } from 'jsdom';
import PublicLayout from '~/layouts/PublicLayout.astro';
import { getConfig } from '~/lib/config';
import { resolveIconUrl } from '~/lib/icons';

// dompurify necesita un window. En Node creamos uno con jsdom (que ya está
// en deps) y se lo pasamos. Esto sólo se ejecuta en SSR, no llega al cliente.
const purifyWindow = new JSDOM('').window;
const DOMPurify = createDOMPurify(purifyWindow as unknown as Window);

export const prerender = false;

const DOCS_DIR = path.join(process.cwd(), 'docs');
const { slug } = Astro.params;

// ── 1) Resolve the file path. Reject anything that tries to escape `docs/`.
function resolveDocFile(slugParam: string | undefined): { abs: string; rel: string } | null {
  if (!slugParam) return null;
  // Reject backslashes, NUL, leading slashes — normalize the path and
  // make sure it stays under DOCS_DIR after resolution.
  if (/[\\:\0]/.test(slugParam)) return null;
  const safe = slugParam
    .split('/')
    .map((p) => p.replace(/[^a-zA-Z0-9._-]/g, ''))
    .filter(Boolean)
    .join('/');
  if (!safe) return null;
  const abs = path.resolve(DOCS_DIR, `${safe}.md`);
  const rel = path.relative(DOCS_DIR, abs);
  if (rel.startsWith('..') || path.isAbsolute(rel)) return null;
  return { abs, rel };
}

const resolved = resolveDocFile(slug);
if (!resolved) {
  return new Response('Not found', { status: 404 });
}

let raw: string;
try {
  raw = await fs.readFile(resolved.abs, 'utf8');
} catch {
  return new Response('Not found', { status: 404 });
}

// ── 2) Parse and sanitize the markdown.
const titleMatch = raw.match(/^#\s+(.+?)$/m);
const pageTitle = titleMatch?.[1]?.replace(/^Atajo\s*—\s*/i, '').replace(/^Documentación\s*—\s*/i, '').trim() ?? 'Documentación';

marked.setOptions({
  gfm: true,
  breaks: false,
  pedantic: false,
});

const htmlBody = marked.parse(raw, { async: false }) as string;

// DOMPurify server-side: strip any dangerous tags that managed to slip
// through marked (e.g. <script>, on*= handlers, javascript: URLs).
// We use a permissive config because this is our own markdown, not user input.
const cleanBody = DOMPurify.sanitize(htmlBody, {
  ALLOWED_TAGS: [
    'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
    'p', 'br', 'hr', 'blockquote',
    'ul', 'ol', 'li',
    'strong', 'em', 'del', 'code', 'pre', 'kbd', 'samp', 'sub', 'sup',
    'a', 'img',
    'table', 'thead', 'tbody', 'tr', 'th', 'td',
    'div', 'span',
    'input', // checkboxes via GFM task list — safe
  ],
  ALLOWED_ATTR: ['href', 'title', 'alt', 'src', 'checked', 'disabled', 'type', 'class', 'rel', 'target', 'id'],
  ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto|tel|ftp):|[^a-z]|[a-z+.\-]+(?:[^a-z+.\-:]|$))/i,
  // Add `target="_blank"` + `rel="noopener noreferrer"` to external links.
  ADD_ATTR: ['target', 'rel'],
});

// Rewrite external links to open in a new tab.
const finalBody = cleanBody.replace(
  /<a\s+(?![^>]*\btarget=)([^>]*?)href="(https?:\/\/[^"]+)"([^>]*)>/g,
  '<a $1href="$2" target="_blank" rel="noopener noreferrer"$3>',
);

const config = await getConfig();
const logoUrl = resolveIconUrl(config.branding.logo);

// Breadcrumb: split the slug into sections
const crumbs = (slug ?? '').split('/').filter(Boolean);
const sectionLabels: Record<string, string> = {
  install: 'Instalación',
  config: 'Configuración',
  usage: 'Uso',
  dev: 'Desarrollo',
};
---
<PublicLayout config={config} title={`${pageTitle} — Documentación`}>
  <main class="page-wrap docs-page">
    <header class="header">
      {logoUrl && (
        <img src={logoUrl} alt={config.branding.companyName} class="header-logo" />
      )}
      <h1 class="header-title">Documentación</h1>
    </header>

    <nav class="docs-breadcrumb" aria-label="breadcrumb">
      <a href="/docs">← Índice</a>
      {crumbs.map((c, i) => {
        const href = '/docs/' + crumbs.slice(0, i + 1).join('/');
        const label = sectionLabels[c] ?? c;
        return (
          <>
            <span class="sep">/</span>
            {i === crumbs.length - 1
              ? <span class="current">{label}</span>
              : <a href={href}>{label}</a>
            }
          </>
        );
      })}
    </nav>

    <article class="docs-article">
      <div class="docs-content" set:html={finalBody}></div>
    </article>

    <footer style="margin-top:3rem;padding:1.5rem 0;border-top:1px solid rgba(255,255,255,0.08);text-align:center;font-size:0.8rem;color:#64748b">
      <a href="/docs" style="color:#94a3b8">← Volver al índice</a>
    </footer>
  </main>
</PublicLayout>

<style is:global>
  .docs-page .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .docs-page .docs-breadcrumb a {
    color: var(--accent, #60a5fa);
    text-decoration: none;
  }
  .docs-page .docs-breadcrumb a:hover {
    text-decoration: underline;
  }
  .docs-page .docs-breadcrumb .sep {
    color: #475569;
  }
  .docs-page .docs-breadcrumb .current {
    color: #f1f5f9;
    font-weight: 500;
  }

  .docs-article {
    max-width: 820px;
    margin: 0 auto;
  }
  .docs-content {
    line-height: 1.65;
    color: #e2e8f0;
  }
  .docs-content h1 {
    font-size: 2rem;
    margin: 0 0 1.2rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 0.5rem;
  }
  .docs-content h2 {
    font-size: 1.5rem;
    margin: 2rem 0 0.8rem;
    color: #f1f5f9;
  }
  .docs-content h3 {
    font-size: 1.2rem;
    margin: 1.5rem 0 0.6rem;
    color: #f1f5f9;
  }
  .docs-content h4 {
    font-size: 1.05rem;
    margin: 1.2rem 0 0.5rem;
    color: #cbd5e1;
  }
  .docs-content p {
    margin: 0.6rem 0;
  }
  .docs-content a {
    color: var(--accent, #60a5fa);
    text-decoration: none;
  }
  .docs-content a:hover {
    text-decoration: underline;
  }
  .docs-content code {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .docs-content pre {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 1rem 1.2rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
    line-height: 1.5;
  }
  .docs-content pre code {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: #e2e8f0;
  }
  .docs-content blockquote {
    border-left: 3px solid var(--accent, #60a5fa);
    margin: 1rem 0;
    padding: 0.4rem 1rem;
    color: #cbd5e1;
    background: rgba(96, 165, 250, 0.06);
    border-radius: 0 4px 4px 0;
  }
  .docs-content blockquote p {
    margin: 0.3rem 0;
  }
  .docs-content ul, .docs-content ol {
    padding-left: 1.6rem;
    margin: 0.6rem 0;
  }
  .docs-content li {
    margin: 0.25rem 0;
  }
  .docs-content li > p {
    margin: 0.2rem 0;
  }
  .docs-content table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
    font-size: 0.9rem;
  }
  .docs-content th, .docs-content td {
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .docs-content th {
    background: rgba(255,255,255,0.04);
    font-weight: 600;
  }
  .docs-content tr:nth-child(even) td {
    background: rgba(255,255,255,0.02);
  }
  .docs-content hr {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin: 2rem 0;
  }
  .docs-content img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .docs-content input[type="checkbox"] {
    margin-right: 0.4rem;
  }
</style>
