---
import PublicLayout from '~/layouts/PublicLayout.astro';
import DocsHeader from '~/components/DocsHeader.astro';
import { getConfig } from '~/lib/config';
import { resolveIconUrl } from '~/lib/icon-url';
import { isFeatureEnabled } from '~/lib/features';
import { listDocs, groupDocsBySection, SECTION_LABELS } from '~/lib/docs-catalog';
import { t as tr, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';

// El catálogo recorre docs/ en el filesystem, así que la página se resuelve
// en el primer GET. El walk está memoizado por mtime en lib/docs-catalog.ts.
export const prerender = false;

const docs = await listDocs();
const config = await getConfig();
const logoUrl = resolveIconUrl(config.branding.logo);
const base = import.meta.env.BASE_URL || '/';

const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = tr(locale);

const grouped = groupDocsBySection(docs);
---
<PublicLayout config={config} title="Documentación — Umbral">
  <main class="page-wrap docs-page">
    <DocsHeader config={config} useI18n={useI18n} trf={trf} locale={locale} logoUrl={logoUrl} base={base} />

    <div class="docs-hero" style="margin: 1.5rem 0 2rem;">
      <h1 style="font-size: 1.8rem; margin: 0 0 0.3rem; font-weight: 700;">Documentación</h1>
      <p class="docs-page-subtitle">
        Guías de instalación, configuración, uso y desarrollo.
      </p>
    </div>

    {docs.length === 0 ? (
      <div class="empty">
        <h2>No hay documentación</h2>
        <p>La carpeta <code>docs/</code> está vacía o no se encuentra.</p>
      </div>
    ) : (
      Array.from(grouped.entries()).map(([section, items]) => (
        <section class="docs-section" id={section}>
          <h2 class="section-title">{SECTION_LABELS[section] ?? section}</h2>
          <div class="grid docs-grid">
            {items.map((doc) => (
              <a class="card docs-card" data-style="medium" data-card-id={`doc-${doc.slug}`} href={`${base}docs/${doc.slug}`} style="--accent:#10b981">
                <div class="docs-card-row">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="docs-card-icon" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                  <div class="docs-card-info">
                    <h3 class="card-title docs-card-title">{doc.title}</h3>
                  </div>
                </div>
                {doc.description && (
                  <p class="card-desc docs-card-desc">{doc.description}</p>
                )}
                <div class="docs-card-slug">
                  /docs/{doc.slug}
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    )}

    <footer class="docs-footer">
      <div style="display:flex;justify-content:center;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:0.5rem">
        <a href={base} style="color:var(--accent);text-decoration:none;font-weight:500">← Volver a la portada principal</a>
        <span style="color:var(--text-faint)">•</span>
        <a href={`${base}admin`} style="color:var(--accent);text-decoration:none;font-weight:500">Ir al panel de administración</a>
      </div>
      <div>Editá los archivos en <code>docs/</code> y reiniciá la app para ver los cambios.</div>
    </footer>
  </main>
</PublicLayout>

<style>
  .docs-page-subtitle {
    margin: 0.3rem 0 0;
    color: var(--text-subtle);
    font-size: 0.95rem;
    width: 100%;
  }
  .docs-section { margin-bottom: 2rem; }
  .docs-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .docs-card {
    align-items: stretch;
    text-align: left;
  }
  .docs-card-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .docs-card-icon {
    flex-shrink: 0;
    margin-top: 2px;
    opacity: 0.7;
  }
  .docs-card-info { flex: 1; min-width: 0; }
  .docs-card-title {
    font-size: 1rem;
    line-height: 1.3;
  }
  .docs-card-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0.3rem 0 0;
    -webkit-line-clamp: 3;
  }
  .docs-card-slug {
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    word-break: break-all;
  }
  .docs-footer {
    margin-top: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
</style>
