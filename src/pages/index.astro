---
import PublicLayout from '~/layouts/PublicLayout.astro';
import CategoryGroup from '~/components/CategoryGroup.astro';
import ModeToggle from '~/components/ModeToggle.astro';
import Search from '~/components/Search.astro';
import Logo from '~/components/Logo.astro';
import Clock from '~/components/Clock.astro';
import RefreshButton from '~/components/RefreshButton.astro';
import StatusBar from '~/components/StatusBar.astro';
import LanguageSwitcher from '~/components/LanguageSwitcher.astro';
import { getConfig } from '~/lib/config';
import { resolveIconUrl } from '~/lib/icon-url';
import { isFeatureEnabled } from '~/lib/features';
import { getActiveWindowsForCards } from '~/lib/maintenance';
import { buildHealthLabels } from '~/lib/health-labels';
import { t as tr, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';
import { useAnimatedCounters, useTypewriter } from '~/lib/animations';
import TypewriterText from '@astroanimate/core/TypewriterText';

const config = await getConfig();
const t = config.theme;
const l = config.layout;

// i18n: resolvemos el locale efectivo una sola vez al tope del page y lo
// pasamos a todos los componentes que lo necesiten. Si la feature está
// apagada, todo queda en español (comportamiento histórico).
const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = tr(locale);
// Subpage categories are excluded from the main homepage (only accessible via /<category_id>)
const subpageCategoryIds = new Set(
  config.categories.filter((c) => c.isSubpage).map((c) => c.id),
);
const enabledCards = config.cards
  .filter((c) => c.enabled && !subpageCategoryIds.has(c.category))
  // Sort: pinned primero (independiente del order), después por order ASC.
  // pinned es opt-in (features.pinned). Si la feature está apagada, el
  // server fuerza pinned=false en todas las cards — este sort no hace
  // diferencia (todos van por order).
  .sort((a, b) => {
    if (a.pinned && !b.pinned) return -1;
    if (!a.pinned && b.pinned) return 1;
    return a.order - b.order;
  });
// Maintenance windows (opt-in: features.maintenanceWindows): resolvemos
// una sola vez qué cards están en mantenimiento AHORA y lo pasamos a
// Card.astro vía prop. O(n) sobre windows × cardIds — ver src/lib/maintenance.ts
const metricsEnabled = isFeatureEnabled(config, 'metrics');
const qrEnabled = isFeatureEnabled(config, 'qr');
// Se resuelven acá y bajan por props: antes cada Card.astro pedía el config
// dos veces para averiguar lo mismo.
const markdownEnabled = isFeatureEnabled(config, 'markdown');
const iconTint = t.iconTint ?? 'original';
const cardMaintenance = await getActiveWindowsForCards(enabledCards.map((c) => c.id));
const logoUrl = resolveIconUrl(config.branding.logo);

// Group by category (only categories that actually have enabled cards and are not standalone subpages)
const grouped = new Map<string, typeof enabledCards>();
for (const c of enabledCards) {
  const arr = grouped.get(c.category) ?? [];
  arr.push(c);
  grouped.set(c.category, arr);
}
// BUGFIX (sortable de categorías pedido por el user): antes el orden de
// los grupos en la portada dependía del orden de inserción del Map, que
// a su vez dependía de cuál era la PRIMER card con esa categoría — no
// del orden de las categorías en el array. Si el user tenía "com" en
// la posición 1 de categories pero la primera card era de "prod", el
// grupo "com" aparecía después de "prod" en la portada. Ahora ordenamos
// los grupos según la posición de catId en config.categories. Categorías
// huérfanas (cards con un category que ya no existe) van al final.
const catOrder = new Map(config.categories.filter((c) => !c.isSubpage).map((c, i) => [c.id, i]));
const groupEntries = Array.from(grouped.entries())
  .filter(([catId]) => !subpageCategoryIds.has(catId))
  .sort(([a], [b]) => (catOrder.get(a) ?? Infinity) - (catOrder.get(b) ?? Infinity));
const noteBadge = trf('home.card.noteBadge');
const isHorizontal = t.groupLayout === 'horizontal';
const isThemePreview = Astro.url.searchParams.get('themePreview') === '1';

// Animaciones (opt-in: features.animations). El texto del título se sirve
// completo igual: el efecto sólo lo reescribe letra por letra si hay JS.
const animateTitle = isFeatureEnabled(config, 'animations') && useTypewriter(t);
const animateCount = isFeatureEnabled(config, 'animations') && useAnimatedCounters(t);
const healthLabels = buildHealthLabels(useI18n, trf);
---
<PublicLayout config={config}>
  <main
    class="page-wrap"
    data-group-layout={t.groupLayout}
    data-grid-align={l.gridAlign}
    data-compact={l.compact ? 'true' : 'false'}
    data-health-config
    data-health-interval={String(l.healthCheckInterval)}
    data-health-metrics={metricsEnabled ? 'true' : 'false'}
    data-health-checking={healthLabels.checking}
    data-health-ok={healthLabels.ok}
    data-health-bad={healthLabels.bad}
    data-health-fetch-error={healthLabels.fetchError}
  >
    <header class="header" data-header-opacity={t.headerOpacity < 1 ? '1' : undefined} style={t.headerOpacity < 1 ? `--header-opacity:${t.headerOpacity}` : undefined}>
      <Logo src={logoUrl} alt={config.branding.companyName} fallbackName={config.branding.companyName} />
      <h1 class="header-title">
        {
          animateTitle ? (
            <TypewriterText
              texts={[config.branding.companyName]}
              enhance
              loop={false}
              erase={false}
              showCursor={false}
            />
          ) : (
            config.branding.companyName
          )
        }
      </h1>
      {(t.showClock || isThemePreview) && (
        <div
          data-theme-widget="clock"
          class={t.clockPosition === 'header-left' ? 'header-clock-left' : 'header-clock-right'}
          style={(!t.showClock && isThemePreview) ? 'display:none' : undefined}
        >
          <Clock config={config} request={Astro.request} />
        </div>
      )}
      <Search config={config} request={Astro.request} />
      {(t.showRefresh || isThemePreview) && (
        <div data-theme-widget="refresh" style={(!t.showRefresh && isThemePreview) ? 'display:none' : undefined}>
          <RefreshButton config={config} request={Astro.request} />
        </div>
      )}
      {useI18n && <LanguageSwitcher config={config} current={locale} />}
      {(t.showModeToggle !== false || isThemePreview) && (
        <ModeToggle
          useI18n={useI18n}
          tr={trf}
          themeWidget
          hidden={isThemePreview && t.showModeToggle === false}
        />
      )}
    </header>

    {enabledCards.length === 0 ? (
      <div class="empty">
        <h2>{useI18n ? trf('home.empty.title') : 'No hay aplicaciones todavía'}</h2>
        <p>{useI18n ? trf('home.empty.body') : 'Pedile al administrador que agregue algunas desde el panel.'}</p>
      </div>
    ) : (
      <div
        class:list={[isHorizontal ? 'groups-horizontal' : 'groups-vertical']}
        style={isHorizontal
          ? `--groups-cols-mobile:${l.columnsMobile};--groups-cols-tablet:${l.columnsTablet};--groups-cols-desktop:${l.columnsDesktop};`
          : undefined}
      >
        {groupEntries.map(([catId, cards]) => (
          <CategoryGroup
            catId={catId}
            cat={config.categories.find((c) => c.id === catId)}
            cards={cards}
            layout={l}
            cardStyle={t.cardStyle}
            cardMaintenance={cardMaintenance}
            qrEnabled={qrEnabled}
            noteBadge={noteBadge}
            iconTint={iconTint}
            markdownEnabled={markdownEnabled}
            useI18n={useI18n}
            trf={trf}
            extraClass={isHorizontal ? 'group-col' : undefined}
          />
        ))}
      </div>
    )}

    {(t.showStatusBar || isThemePreview) && (
      <div
        class="status-bar-wrap"
        data-theme-widget="statusBar"
        data-footer-opacity={t.footerOpacity < 1 ? '1' : undefined}
        style={[
          t.footerOpacity < 1 ? `--footer-opacity:${t.footerOpacity}` : '',
          !t.showStatusBar && isThemePreview ? 'display:none' : '',
        ].filter(Boolean).join(';') || undefined}
      >
        <StatusBar config={config} appCount={enabledCards.length} animateCount={animateCount} />
      </div>
    )}
  </main>
</PublicLayout>

<script>
  // Toda la lógica de la portada vive en módulos: se sirven minificados y
  // cacheados en vez de repetirse en crudo dentro del HTML de cada página.
  import { initCategoryLocks } from '~/scripts/public/category-lock';
  import { initHealthDots } from '~/scripts/public/health-dots';

  initCategoryLocks();
  initHealthDots();
</script>
