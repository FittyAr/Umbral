---
import crypto from 'node:crypto';
import PublicLayout from '~/layouts/PublicLayout.astro';
import Card from '~/components/Card.astro';
import Search from '~/components/Search.astro';
import Logo from '~/components/Logo.astro';
import Clock from '~/components/Clock.astro';
import RefreshButton from '~/components/RefreshButton.astro';
import StatusBar from '~/components/StatusBar.astro';
import { getConfig } from '~/lib/config';
import { resolveIconUrl } from '~/lib/icons';

const config = await getConfig();
const t = config.theme;
const l = config.layout;
const enabledCards = config.cards.filter((c) => c.enabled).sort((a, b) => a.order - b.order);
const logoUrl = resolveIconUrl(config.branding.logo);

// Group by category (only categories that actually have enabled cards)
const grouped = new Map<string, typeof enabledCards>();
for (const c of enabledCards) {
  const arr = grouped.get(c.category) ?? [];
  arr.push(c);
  grouped.set(c.category, arr);
}
// BUGFIX (sortable de categorías pedido por el user): antes el orden de
// los grupos en la portada dependía del orden de inserción del Map, que
// a su vez dependía de cuál era la PRIMER card con esa categoría — no
// del orden de las categorías en el array. Si el user tenía "com" en
// la posición 1 de categories pero la primera card era de "prod", el
// grupo "com" aparecía después de "prod" en la portada. Ahora ordenamos
// los grupos según la posición de catId en config.categories. Categorías
// huérfanas (cards con un category que ya no existe) van al final.
const catOrder = new Map(config.categories.map((c, i) => [c.id, i]));
const groupEntries = Array.from(grouped.entries()).sort(
  ([a], [b]) => (catOrder.get(a) ?? Infinity) - (catOrder.get(b) ?? Infinity),
);
const isHorizontal = t.groupLayout === 'horizontal';
---
<PublicLayout config={config}>
  <main class="page-wrap" data-group-layout={t.groupLayout}>
    <header class="header">
      <Logo src={logoUrl} alt={config.branding.companyName} fallbackName={config.branding.companyName} />
      <h1 class="header-title">{config.branding.companyName}</h1>
      {t.showClock && <Clock />}
      <Search />
      {t.showRefresh && <RefreshButton />}
      <button
        data-action="toggle-mode"
        class="mode-toggle"
        aria-label="Cambiar modo claro/oscuro"
        title="Cambiar modo claro/oscuro"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
      </button>
    </header>

    {enabledCards.length === 0 ? (
      <div class="empty">
        <h2>No hay aplicaciones todavía</h2>
        <p>Pedile al administrador que agregue algunas desde el panel.</p>
      </div>
    ) : isHorizontal ? (
      <div class="groups-horizontal" style={`--groups-cols-mobile:${l.columnsMobile};--groups-cols-tablet:${l.columnsTablet};--groups-cols-desktop:${l.columnsDesktop};`}>
        {groupEntries.map(([catId, cards]) => {
          const cat = config.categories.find((c) => c.id === catId);
          const isLocked = Boolean(cat?.isLocked && cat?.password);
          const catHash = isLocked ? crypto.createHash('sha256').update(cat.password).digest('hex') : '';
          return (
            <section
              class="group-col category-section"
              data-cat-id={catId}
              data-is-locked={isLocked ? 'true' : 'false'}
              data-cat-hash={catHash}
            >
              {cat && (
                <div class="category-header">
                  <h2 class="section-title">{cat.name}</h2>
                  {isLocked && (
                    <div class="cat-lock-status">
                      <span class="cat-lock-badge badge-locked" title="Categoría protegida con contraseña">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>Protegida</span>
                      </span>
                      <button type="button" class="cat-relock-btn" style="display: none;" title="Volver a bloquear categoría">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>Bloquear</span>
                      </button>
                    </div>
                  )}
                </div>
              )}

              {isLocked && (
                <div class="category-lock-box">
                  <div class="lock-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  </div>
                  <p class="lock-title">Categoría bloqueada</p>
                  <p class="lock-subtitle">Ingresá la contraseña para ver los enlaces</p>
                  <form class="lock-form" onsubmit="return false;">
                    <div class="lock-input-group">
                      <input
                        type="password"
                        class="lock-input"
                        placeholder="Contraseña…"
                        autocomplete="current-password"
                        required
                      />
                      <button type="submit" class="lock-submit-btn">
                        Desbloquear
                      </button>
                    </div>
                    <p class="lock-error" style="display: none;">Contraseña incorrecta</p>
                  </form>
                </div>
              )}

              <div class="category-cards-wrap" style={isLocked ? 'display: none;' : undefined}>
                <div class="grid">
                  {cards.map((c) => <Card card={c} layout={l} />)}
                </div>
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <div class="groups-vertical">
        {groupEntries.map(([catId, cards]) => {
          const cat = config.categories.find((c) => c.id === catId);
          const isLocked = Boolean(cat?.isLocked && cat?.password);
          const catHash = isLocked ? crypto.createHash('sha256').update(cat.password).digest('hex') : '';
          return (
            <section
              class="category-section"
              data-cat-id={catId}
              data-is-locked={isLocked ? 'true' : 'false'}
              data-cat-hash={catHash}
            >
              {cat && (
                <div class="category-header">
                  <h2 class="section-title">{cat.name}</h2>
                  {isLocked && (
                    <div class="cat-lock-status">
                      <span class="cat-lock-badge badge-locked" title="Categoría protegida con contraseña">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>Protegida</span>
                      </span>
                      <button type="button" class="cat-relock-btn" style="display: none;" title="Volver a bloquear categoría">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>Bloquear</span>
                      </button>
                    </div>
                  )}
                </div>
              )}

              {isLocked && (
                <div class="category-lock-box">
                  <div class="lock-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  </div>
                  <p class="lock-title">Categoría bloqueada</p>
                  <p class="lock-subtitle">Ingresá la contraseña para ver los enlaces</p>
                  <form class="lock-form" onsubmit="return false;">
                    <div class="lock-input-group">
                      <input
                        type="password"
                        class="lock-input"
                        placeholder="Contraseña…"
                        autocomplete="current-password"
                        required
                      />
                      <button type="submit" class="lock-submit-btn">
                        Desbloquear
                      </button>
                    </div>
                    <p class="lock-error" style="display: none;">Contraseña incorrecta</p>
                  </form>
                </div>
              )}

              <div class="category-cards-wrap" style={isLocked ? 'display: none;' : undefined}>
                <div class="grid">
                  {cards.map((c) => <Card card={c} layout={l} />)}
                </div>
              </div>
            </section>
          );
        })}
      </div>
    )}

    {t.showStatusBar && <StatusBar config={config} />}
  </main>
</PublicLayout>

<script define:vars={{ healthCheckInterval: l.healthCheckInterval }}>
  // ── Desbloqueo de categorías protegidas ──
  (function () {
    const lockedSections = document.querySelectorAll('.category-section[data-is-locked="true"]');
    if (lockedSections.length === 0) return;

    async function sha256Hex(text) {
      const buffer = new TextEncoder().encode(text);
      const digest = await crypto.subtle.digest('SHA-256', buffer);
      return Array.from(new Uint8Array(digest))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    function unlockSection(section, saveSession = true) {
      const catId = section.getAttribute('data-cat-id');
      const lockBox = section.querySelector('.category-lock-box');
      const cardsWrap = section.querySelector('.category-cards-wrap');
      const lockBadge = section.querySelector('.badge-locked');
      const relockBtn = section.querySelector('.cat-relock-btn');

      section.setAttribute('data-unlocked', 'true');
      if (lockBox) lockBox.style.display = 'none';
      if (cardsWrap) cardsWrap.style.display = 'block';
      if (lockBadge) lockBadge.style.display = 'none';
      if (relockBtn) relockBtn.style.display = 'inline-flex';

      if (saveSession && catId) {
        try {
          sessionStorage.setItem('umbral_unlocked_' + catId, '1');
        } catch { /* ignore */ }
      }
    }

    function relockSection(section) {
      const catId = section.getAttribute('data-cat-id');
      const lockBox = section.querySelector('.category-lock-box');
      const cardsWrap = section.querySelector('.category-cards-wrap');
      const lockBadge = section.querySelector('.badge-locked');
      const relockBtn = section.querySelector('.cat-relock-btn');
      const input = section.querySelector('.lock-input');
      const err = section.querySelector('.lock-error');

      section.removeAttribute('data-unlocked');
      if (lockBox) lockBox.style.display = 'flex';
      if (cardsWrap) cardsWrap.style.display = 'none';
      if (lockBadge) lockBadge.style.display = 'inline-flex';
      if (relockBtn) relockBtn.style.display = 'none';
      if (input) input.value = '';
      if (err) err.style.display = 'none';

      if (catId) {
        try {
          sessionStorage.removeItem('umbral_unlocked_' + catId);
        } catch { /* ignore */ }
      }
    }

    lockedSections.forEach((section) => {
      const catId = section.getAttribute('data-cat-id');
      const expectedHash = section.getAttribute('data-cat-hash');
      const form = section.querySelector('.lock-form');
      const input = section.querySelector('.lock-input');
      const err = section.querySelector('.lock-error');
      const relockBtn = section.querySelector('.cat-relock-btn');

      // Check session storage
      try {
        if (sessionStorage.getItem('umbral_unlocked_' + catId) === '1') {
          unlockSection(section, false);
        }
      } catch { /* ignore */ }

      if (relockBtn) {
        relockBtn.addEventListener('click', () => {
          relockSection(section);
        });
      }

      if (form && input) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const val = input.value.trim();
          if (!val) return;

          try {
            const hash = await sha256Hex(val);
            if (hash === expectedHash) {
              if (err) err.style.display = 'none';
              unlockSection(section, true);
            } else {
              if (err) err.style.display = 'block';
              input.classList.remove('shake');
              void input.offsetWidth; // trigger reflow
              input.classList.add('shake');
              input.focus();
              input.select();
            }
          } catch (error) {
            console.error('[umbral] Error verifying category password:', error);
          }
        });
      }
    });
  })();

  // ── Health check en vivo ──
  // Pedimos al server (/api/status) que pingue las URLs. Esto evita
  // exponer la CSP a dominios arbitrarios y mantiene el SSRF protection
  // que ya está implementado en el endpoint (bloquea IPs privadas/loopback).
  (function () {
    const cards = Array.from(document.querySelectorAll('.card[data-health-check="true"]'));
    if (cards.length === 0) return;
    const dots = new Map(); // cardId → HTMLElement
    for (const c of cards) {
      const id = c.getAttribute('data-card-id');
      if (!id) continue;
      const d = document.createElement('span');
      d.className = 'health-dot pending';
      d.title = 'Verificando…';
      c.appendChild(d);
      dots.set(id, d);
    }
    const setDot = (id, state, title) => {
      const d = dots.get(id);
      if (!d) return;
      d.classList.remove('ok', 'bad', 'pending');
      d.classList.add(state);
      d.title = title;
    };
    const tick = async () => {
      // Marcar a todos como pending mientras dura el check
      dots.forEach((d) => {
        d.classList.remove('ok', 'bad');
        d.classList.add('pending');
        d.title = 'Verificando…';
      });
      try {
        const res = await fetch('/api/status', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: Array.from(dots.keys()) }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        for (const r of (data.results || [])) {
          setDot(
            r.id,
            r.ok ? 'ok' : 'bad',
            r.ok ? `Servicio OK (${r.latencyMs ?? '?'}ms)` : (r.error || `HTTP ${r.status}`),
          );
        }
      } catch (err) {
        // Si el endpoint falla, marcamos a todos como bad (mejor rojo que
        // un falso verde que oculte un problema real del server).
        for (const id of dots.keys()) {
          setDot(id, 'bad', 'Error al consultar /api/status');
        }
      }
    };
    tick();
    setInterval(tick, Math.max(10, healthCheckInterval) * 1000);
  })();

  // ── Refresh button: location.reload conserva scroll/foco/search del
  // browser. Fetch al /api/config primero (warm-up del cache) para que el
  // reload sea casi instantáneo.
  const refreshBtn = document.querySelector('[data-action="refresh-config"]');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/config', { cache: 'no-store' });
      } catch { /* ignorar — igual recargamos */ }
      window.location.reload();
    });
  }
</script>
