---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { getConfig } from '~/lib/config';
import { getBuiltinIconNames } from '~/lib/icons';
import { AI_PROVIDERS, DEFAULT_AI_SYSTEM_PROMPT, findPresetByBaseUrl } from './ai-providers';
import { HELP_TEXTS } from './help-texts';
import { AI_LANGUAGES, DEFAULT_AI_SYSTEM_PROMPTS } from '~/lib/ai-prompts';

const isAuthed = Astro.locals.auth?.isAuthenticated ?? false;
if (!isAuthed) {
  return Astro.redirect('/admin');
}
const csrfToken = Astro.locals.auth?.csrfToken ?? '';
const config = await getConfig();
const builtinIcons = await getBuiltinIconNames();
---
<AdminLayout title="Dashboard" csrfToken={csrfToken} isAuthed={true}>
  <div class="admin-wrap" x-data="adminApp" x-init="init()">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
      <h1 style="margin:0;font-size:1.4rem">Panel de configuración</h1>
      <div style="display:flex;gap:0.5rem;align-items:center">
        <span x-show="dirty" class="dirty-badge" x-cloak>● Cambios sin guardar</span>
        <button class="btn btn-ghost" @click="reloadConfig()" :disabled="busy">Recargar</button>
        <button class="btn btn-primary" @click="saveAll()" :disabled="busy || !dirty">
          <span x-show="!busy">Guardar cambios</span>
          <span x-show="busy" x-cloak>Guardando…</span>
        </button>
      </div>
    </div>

    <div class="tabs">
      <button class="tab" :class="tab==='branding' && 'active'" @click="tab='branding'">Branding</button>
      <button class="tab" :class="tab==='theme' && 'active'" @click="tab='theme'">Tema</button>
      <button class="tab" :class="tab==='layout' && 'active'" @click="tab='layout'">Layout</button>
      <button class="tab" :class="tab==='categories' && 'active'" @click="tab='categories'">Categorías</button>
      <button class="tab" :class="tab==='cards' && 'active'" @click="tab='cards'">Tarjetas</button>
      <button class="tab" :class="tab==='assets' && 'active'" @click="tab='assets'">Assets</button>
      <button class="tab" :class="tab==='status' && 'active'" @click="tab='status'">Status</button>
      <button class="tab" :class="tab==='hardening' && 'active'" @click="tab='hardening'">Hardening</button>
      <button class="tab" :class="tab==='security' && 'active'" @click="tab='security'">Password</button>
      <button class="tab" :class="tab==='ai' && 'active'" @click="tab='ai'">IA</button>
      <button class="tab" :class="tab==='advanced' && 'active'" @click="tab='advanced'">Avanzado</button>
    </div>

    <!-- BRANDING -->
    <div class="panel" :class="tab==='branding' && 'active'">
      <h2 style="margin-top:0">Branding</h2>
      <div class="form-group">
        <label>Nombre de la empresa <button type="button" class="help-icon" @click="showHelp('branding.companyName')" title="¿Qué hace esto?">?</button></label>
        <input type="text" x-model="cfg.branding.companyName" maxlength="80" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Logo <button type="button" class="help-icon" @click="showHelp('branding.logo')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.branding.logo">
            <option value="">— Sin logo (usar inicial) —</option>
            <template x-for="a in assets.filter(a => /\.(png|jpe?g|webp|svg)$/i.test(a.name))" :key="a.name">
              <option :value="a.url" x-text="a.name"></option>
            </template>
          </select>
          <div class="preview-box" x-show="cfg.branding.logo" style="display:flex;align-items:center;justify-content:center">
            <img :src="cfg.branding.logo" style="max-height:60px;max-width:200px" />
          </div>
        </div>
        <div class="form-group">
          <label>Favicon <button type="button" class="help-icon" @click="showHelp('branding.favicon')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.branding.favicon">
            <option value="">— Default —</option>
            <template x-for="a in assets.filter(a => /\.(png|jpe?g|webp|svg|ico)$/i.test(a.name))" :key="a.name">
              <option :value="a.url" x-text="a.name"></option>
            </template>
          </select>
        </div>
      </div>
    </div>

    <!-- THEME -->
    <div class="panel" :class="tab==='theme' && 'active'">
      <h2 style="margin-top:0">Tema</h2>
      <div class="form-group">
        <label>Tipo de fondo <button type="button" class="help-icon" @click="showHelp('theme.background.type')" title="¿Qué hace esto?">?</button></label>
        <select x-model="cfg.theme.background.type">
          <option value="gradient">Gradiente / Color CSS</option>
          <option value="color">Color sólido</option>
          <option value="image">Imagen subida</option>
        </select>
      </div>
      <div class="form-group" x-show="cfg.theme.background.type==='image'">
        <label>Imagen de fondo <button type="button" class="help-icon" @click="showHelp('theme.background.value')" title="¿Qué hace esto?">?</button></label>
        <select x-model="cfg.theme.background.value">
          <option value="">— Seleccionar imagen —</option>
          <template x-for="a in assets.filter(a => /\.(png|jpe?g|webp)$/i.test(a.name))" :key="a.name">
            <option :value="a.url" x-text="a.name"></option>
          </template>
        </select>
      </div>
      <div class="form-group" x-show="cfg.theme.background.type!=='image'">
        <label>
          <span x-text="cfg.theme.background.type==='color' ? 'Color' : 'CSS (gradient/color)'"></span>
          <button type="button" class="help-icon" @click="showHelp('theme.background.value')" title="¿Qué hace esto?">?</button>
        </label>
        <input type="text" x-model="cfg.theme.background.value" :placeholder="cfg.theme.background.type==='color' ? '#0f172a' : 'linear-gradient(135deg, #0f172a, #1e3a8a)'" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Blur (<span x-text="cfg.theme.background.blur"></span>px) <button type="button" class="help-icon" @click="showHelp('theme.background.blur')" title="¿Qué hace esto?">?</button></label>
          <input type="range" min="0" max="40" x-model.number="cfg.theme.background.blur" />
        </div>
        <div class="form-group">
          <label>Overlay opacity (<span x-text="cfg.theme.background.overlay"></span>) <button type="button" class="help-icon" @click="showHelp('theme.background.overlay')" title="¿Qué hace esto?">?</button></label>
          <input type="range" min="0" max="1" step="0.05" x-model.number="cfg.theme.background.overlay" />
        </div>
        <div class="form-group">
          <label>Color overlay <button type="button" class="help-icon" @click="showHelp('theme.background.overlayColor')" title="¿Qué hace esto?">?</button></label>
          <input type="color" x-model="cfg.theme.background.overlayColor" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Color de acento <button type="button" class="help-icon" @click="showHelp('theme.accentColor')" title="¿Qué hace esto?">?</button></label>
          <input type="color" x-model="cfg.theme.accentColor" />
        </div>
        <div class="form-group">
          <label>Color de texto <button type="button" class="help-icon" @click="showHelp('theme.textColor')" title="¿Qué hace esto?">?</button></label>
          <input type="color" x-model="cfg.theme.textColor" />
        </div>
        <div class="form-group">
          <label>Estilo de tarjeta <button type="button" class="help-icon" @click="showHelp('theme.cardStyle')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.theme.cardStyle">
            <option value="glass">Glass (blur)</option>
            <option value="flat">Flat</option>
            <option value="outlined">Outlined</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Tipografía <button type="button" class="help-icon" @click="showHelp('theme.fontFamily')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.theme.fontFamily" @change="updateFontUrl()">
            <option>Inter</option><option>Roboto</option><option>Open Sans</option>
            <option>Lato</option><option>Poppins</option><option>Montserrat</option>
            <option>Source Sans 3</option><option>Nunito</option><option>Raleway</option>
            <option>system-ui</option>
          </select>
        </div>
        <div class="form-group">
          <label>Modo de color <button type="button" class="help-icon" @click="showHelp('theme.colorMode')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.theme.colorMode">
            <option value="auto">Auto (según hora)</option>
            <option value="dark">Oscuro</option>
            <option value="light">Claro</option>
          </select>
        </div>
        <div class="form-group">
          <label>Disposición de grupos <button type="button" class="help-icon" @click="showHelp('theme.groupLayout')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.theme.groupLayout">
            <option value="vertical">Vertical (apilados)</option>
            <option value="horizontal">Horizontal (en columnas)</option>
          </select>
        </div>
      </div>

      <h3 style="margin:1.25rem 0 0.5rem;font-size:0.95rem">Widgets opcionales</h3>
      <p style="color:var(--text-subtle);font-size:0.82rem;margin:0 0 0.75rem">
        Encendé los que quieras en el header / pie. Apagados = cero overhead.
      </p>
      <div class="form-row">
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.theme.showClock" /> Mostrar reloj <button type="button" class="help-icon" @click="showHelp('theme.showClock')" title="¿Qué hace esto?">?</button></label>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.theme.showRefresh" /> Mostrar botón de refresh <button type="button" class="help-icon" @click="showHelp('theme.showRefresh')" title="¿Qué hace esto?">?</button></label>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.theme.showStatusBar" /> Mostrar status bar (versión + última actualización) <button type="button" class="help-icon" @click="showHelp('theme.showStatusBar')" title="¿Qué hace esto?">?</button></label>
        </div>
      </div>

      <h3>Vista previa</h3>
      <div class="preview-box" :style="previewStyle()">
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;justify-content:center">
          <div :data-style="cfg.theme.cardStyle" :style="`background:${cfg.theme.cardStyle==='glass'?'rgba(255,255,255,0.08)':'transparent'};border:1px solid rgba(255,255,255,0.12);padding:1rem;border-radius:12px;color:${cfg.theme.textColor};min-width:120px;text-align:center`">
            <div :style="`width:40px;height:40px;border-radius:10px;background:${cfg.theme.accentColor};margin:0 auto 0.4rem;opacity:0.3`"></div>
            <div style="font-weight:600">Tarjeta</div>
          </div>
          <div :data-style="cfg.theme.cardStyle" :style="`background:${cfg.theme.cardStyle==='glass'?'rgba(255,255,255,0.08)':'transparent'};border:1px solid rgba(255,255,255,0.12);padding:1rem;border-radius:12px;color:${cfg.theme.textColor};min-width:120px;text-align:center`">
            <div :style="`width:40px;height:40px;border-radius:10px;background:${cfg.theme.accentColor};margin:0 auto 0.4rem;opacity:0.5`"></div>
            <div style="font-weight:600">Ejemplo</div>
          </div>
        </div>
      </div>
    </div>

    <!-- LAYOUT -->
    <div class="panel" :class="tab==='layout' && 'active'">
      <h2 style="margin-top:0">Layout</h2>
      <div class="form-row">
        <div class="form-group">
          <label>Columnas desktop <button type="button" class="help-icon" @click="showHelp('layout.columnsDesktop')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="2" max="8" x-model.number="cfg.layout.columnsDesktop" />
        </div>
        <div class="form-group">
          <label>Columnas tablet <button type="button" class="help-icon" @click="showHelp('layout.columnsTablet')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="2" max="6" x-model.number="cfg.layout.columnsTablet" />
        </div>
        <div class="form-group">
          <label>Columnas mobile <button type="button" class="help-icon" @click="showHelp('layout.columnsMobile')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" max="3" x-model.number="cfg.layout.columnsMobile" />
        </div>
        <div class="form-group">
          <label>Tamaño de tarjeta <button type="button" class="help-icon" @click="showHelp('layout.cardSize')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.layout.cardSize">
            <option value="small">Chico</option>
            <option value="medium">Mediano</option>
            <option value="large">Grande</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label><input type="checkbox" x-model="cfg.layout.showDescriptions" /> Mostrar descripciones <button type="button" class="help-icon" @click="showHelp('layout.showDescriptions')" title="¿Qué hace esto?">?</button></label>
      </div>
      <div class="form-group">
        <label>Intervalo health check (segundos) <button type="button" class="help-icon" @click="showHelp('layout.healthCheckInterval')" title="¿Qué hace esto?">?</button>
          <span style="color:var(--text-faint);font-size:0.8rem" x-text="'— ' + (cfg.layout.healthCheckInterval || 60) + 's'"></span>
        </label>
        <input type="number" min="10" max="3600" x-model.number="cfg.layout.healthCheckInterval" />
        <p style="color:var(--text-faint);font-size:0.75rem;margin:0.25rem 0 0">
          Cada cuánto se vuelve a probar las tarjetas con health check activado. Mín 10s, máx 1h.
        </p>
      </div>
    </div>

    <!-- CATEGORIES -->
    <div class="panel" :class="tab==='categories' && 'active'">
      <h2 style="margin-top:0">
        Categorías
        <button type="button" class="help-icon" @click="showHelp('category.order')" title="¿Qué hace esto?">?</button>
      </h2>
      <p class="muted" style="color:#94a3b8;font-size:0.85rem">Las tarjetas se agrupan por categoría. El id es la clave interna (kebab-case). Arrastrá las filas con <code>⋮⋮</code> para reordenar — el orden de las categorías en la portada sigue el orden acá.</p>
      <div class="card-list" id="categories-sortable">
        <template x-for="(cat, idx) in cfg.categories" :key="cat.id">
          <div class="card-item">
            <div class="drag-handle" title="Arrastrar para reordenar">⋮⋮</div>
            <div class="info" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.5rem;align-items:center">
              <input type="text" x-model="cat.id" placeholder="id (kebab-case)" @input="markDirty()" />
              <input type="text" x-model="cat.name" placeholder="Nombre" @input="markDirty()" />
              <select x-model="cat.icon" @change="markDirty()" :title="cat.icon || 'ícono'">
                <option value="">— ícono —</option>
                <template x-for="i in builtinIcons" :key="i">
                  <option :value="i" x-text="i"></option>
                </template>
              </select>
            </div>
            <button class="btn btn-sm btn-ghost" @click="removeCategory(idx)">×</button>
          </div>
        </template>
      </div>
      <button class="btn btn-ghost" style="margin-top:0.5rem" @click="addCategory()">+ Agregar categoría</button>
    </div>

    <!-- CARDS -->
    <div class="panel" :class="tab==='cards' && 'active'">
      <h2 style="margin-top:0">Tarjetas</h2>
      <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;align-items:center">
        <input type="text" x-model="cardFilter" placeholder="Filtrar tarjetas…" style="max-width:280px" />
        <button class="btn btn-primary" @click="addCard()">+ Nueva tarjeta</button>
      </div>
      <div class="card-list" id="cards-sortable">
        <template x-for="(card, idx) in filteredCards()" :key="card.id">
          <div class="card-item" :data-id="card.id" :class="isSystemCard(card) && 'card-system'">
            <div class="drag-handle" title="Arrastrar para reordenar">⋮⋮</div>
            <div class="icon-preview">
              <template x-if="card.icon && (card.icon.includes('/') || card.icon.includes('.'))">
                <img :src="resolveIcon(card.icon)" />
              </template>
              <template x-if="card.icon && !card.icon.includes('/') && !card.icon.includes('.')">
                <img :src="'/icons/' + card.icon + '.svg'" />
              </template>
            </div>
            <div class="info">
              <div class="title" x-text="card.title || '(sin título)'"></div>
              <div class="url" x-text="card.url || ''"></div>
            </div>
            <span class="color-dot" :style="`background:${card.color}`"></span>
            <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:#94a3b8">
              <input type="checkbox" x-model="card.enabled" @change="markDirty()" /> Activa
            </label>
            <div class="actions">
              <template x-if="!isSystemCard(card)">
                <span style="display:flex;gap:0.25rem">
                  <button class="btn btn-sm btn-ghost" @click="editCard(idx)">Editar</button>
                  <button class="btn btn-sm btn-ghost" @click="removeCard(idx)" title="Borrar tarjeta">×</button>
                </span>
              </template>
              <template x-if="isSystemCard(card)">
                <span class="system-badge" title="Tarjeta del sistema — no se puede editar ni borrar (apunta a la documentación de Umbral en /docs). Protegida también a nivel server.">🔒 Sistema</span>
              </template>
            </div>
          </div>
        </template>
      </div>
      <p x-show="cfg.cards.length===0" class="empty-state">No hay tarjetas. Agregá la primera con "+ Nueva tarjeta".</p>
    </div>

    <!-- ASSETS -->
    <div class="panel" :class="tab==='assets' && 'active'">
      <h2 style="margin-top:0">
        Assets
        <button type="button" class="help-icon" @click="showHelp('assets.upload')" title="¿Qué hace esto?">?</button>
      </h2>
      <div class="uploader" :class="uploaderDragover && 'dragover'"
           @click="$refs.fileInput.click()"
           @dragover.prevent="uploaderDragover=true"
           @dragleave="uploaderDragover=false"
           @drop.prevent="handleFileDrop($event)">
        <p style="margin:0 0 0.5rem">Arrastrá archivos acá o hacé click para subir</p>
        <small>PNG, JPEG, WebP, SVG, GIF · Logos 1MB · Iconos 512KB · Bg 5MB</small>
        <input type="file" x-ref="fileInput" accept="image/*" multiple @change="handleFileSelect($event)" hidden />
      </div>
      <div class="form-group" style="max-width:240px">
        <label>Tipo al subir <button type="button" class="help-icon" @click="showHelp('assets.upload')" title="¿Qué hace esto?">?</button></label>
        <select x-model="uploadKind">
          <option value="icon">Icono (128px, ≤512KB)</option>
          <option value="logo">Logo (512px, ≤1MB)</option>
          <option value="favicon">Favicon (64px, ≤256KB)</option>
          <option value="background">Fondo (1920px, ≤5MB)</option>
        </select>
      </div>

      <h3>Assets subidos (<span x-text="assets.length"></span>)</h3>
      <div class="asset-grid">
        <template x-for="a in assets" :key="a.name">
          <div class="asset-tile" :class="selectedAsset===a.name && 'selected'">
            <img :src="a.url" :alt="a.name" loading="lazy" />
            <div class="name" x-text="a.name"></div>
            <div class="bytes" x-text="(a.bytes/1024).toFixed(1) + ' KB'"></div>
            <div class="usage" x-show="a.usedBy.length" x-text="'Usado en: ' + a.usedBy.join(', ')"></div>
            <div style="display:flex;gap:0.2rem;margin-top:0.4rem;width:100%">
              <button class="btn btn-sm btn-ghost" style="flex:1;font-size:0.7rem;padding:0.2rem" @click="copyToClipboard(a.url)">Copiar URL</button>
              <button class="btn btn-sm btn-ghost" style="flex:0 0 auto;font-size:0.7rem;padding:0.2rem 0.4rem" @click="deleteAsset(a.name)" :disabled="a.usedBy.length>0" :title="a.usedBy.length ? 'En uso' : 'Borrar'">🗑</button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- STATUS -->
    <div class="panel" :class="tab==='status' && 'active'">
      <h2 style="margin-top:0">
        Status de las tarjetas
        <button type="button" class="help-icon" @click="showHelp('status.check')" title="¿Qué hace esto?">?</button>
      </h2>
      <p class="muted" style="color:#94a3b8;font-size:0.85rem">Ping HEAD a cada URL. Útil para detectar servicios caídos.</p>
      <button class="btn btn-primary" @click="checkAllStatus()" :disabled="checkingStatus">
        <span x-show="!checkingStatus">Probar todas</span>
        <span x-show="checkingStatus" x-cloak>Probando…</span>
      </button>
      <div style="margin-top:1rem">
        <template x-for="r in statusResults" :key="r.id">
          <div class="health-row">
            <span class="status-dot" :class="r.ok ? 'ok' : 'bad'"></span>
            <span x-text="(cfg.cards.find(c=>c.id===r.id)?.title) || r.url"></span>
            <span style="color:#64748b;font-size:0.75rem" x-text="r.status || r.error"></span>
            <span class="latency" x-text="r.latencyMs + 'ms'"></span>
          </div>
        </template>
      </div>
    </div>

    <!-- HARDENING -->
    <div class="panel" :class="tab==='hardening' && 'active'">
      <h2 style="margin-top:0">Hardening</h2>
      <p class="muted" style="color:#94a3b8;font-size:0.85rem">
        Defaults permisivos: la app funciona recién salida de la caja.
        Endurecé lo que necesites. Los cambios se aplican al guardar.
      </p>

      <h3 style="margin-top:1.5rem">Sesión y cookies</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Duración (horas) <button type="button" class="help-icon" @click="showHelp('session.ttlHours')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" max="720" x-model.number="cfg.security.session.ttlHours" />
        </div>
        <div class="form-group">
          <label>SameSite <button type="button" class="help-icon" @click="showHelp('session.cookieSameSite')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.security.session.cookieSameSite">
            <option value="Lax">Lax (permisivo, default)</option>
            <option value="Strict">Strict (más seguro)</option>
            <option value="None">None (requiere Secure)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Secure flag <button type="button" class="help-icon" @click="showHelp('session.cookieSecure')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.security.session.cookieSecure">
            <option value="auto">Auto (recomendado)</option>
            <option value="always">Siempre</option>
            <option value="never">Nunca</option>
          </select>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.session.rotateCsrfOnLogin" /> Rotar CSRF en cada login <button type="button" class="help-icon" @click="showHelp('session.rotateCsrfOnLogin')" title="¿Qué hace esto?">?</button></label>
        </div>
      </div>

      <h3 style="margin-top:1.5rem">Login y CSRF</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Largo mínimo del password <button type="button" class="help-icon" @click="showHelp('auth.minPasswordLength')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="0" max="128" x-model.number="cfg.security.auth.minPasswordLength" />
          <small style="color:#94a3b8">0 = sin mínimo (permite passwords cortos legados)</small>
        </div>
        <div class="form-group">
          <label>Rate limit (intentos) <button type="button" class="help-icon" @click="showHelp('auth.rateLimitMax')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" max="10000" x-model.number="cfg.security.auth.rateLimitMax" />
        </div>
        <div class="form-group">
          <label>Rate limit (ventana, seg) <button type="button" class="help-icon" @click="showHelp('auth.rateLimitWindowSec')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" max="3600" x-model.number="cfg.security.auth.rateLimitWindowSec" />
        </div>
        <div class="form-group">
          <label>Política CSRF <button type="button" class="help-icon" @click="showHelp('auth.csrfPolicy')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.security.auth.csrfPolicy">
            <option value="mutations">Mutations (default, recomendado)</option>
            <option value="all">Todos los requests</option>
            <option value="none">Ninguno (no recomendado)</option>
          </select>
        </div>
      </div>

      <h3 style="margin-top:1.5rem">Uploads</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Máx logo (KB) <button type="button" class="help-icon" @click="showHelp('uploads.maxBytesLogo')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" x-model.number="Math.round(cfg.security.uploads.maxBytesLogo / 1024)" @change="cfg.security.uploads.maxBytesLogo = $event.target.value * 1024" />
        </div>
        <div class="form-group">
          <label>Máx favicon (KB) <button type="button" class="help-icon" @click="showHelp('uploads.maxBytesFavicon')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" x-model.number="Math.round(cfg.security.uploads.maxBytesFavicon / 1024)" @change="cfg.security.uploads.maxBytesFavicon = $event.target.value * 1024" />
        </div>
        <div class="form-group">
          <label>Máx ícono (KB) <button type="button" class="help-icon" @click="showHelp('uploads.maxBytesIcon')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" x-model.number="Math.round(cfg.security.uploads.maxBytesIcon / 1024)" @change="cfg.security.uploads.maxBytesIcon = $event.target.value * 1024" />
        </div>
        <div class="form-group">
          <label>Máx fondo (KB) <button type="button" class="help-icon" @click="showHelp('uploads.maxBytesBackground')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="1" x-model.number="Math.round(cfg.security.uploads.maxBytesBackground / 1024)" @change="cfg.security.uploads.maxBytesBackground = $event.target.value * 1024" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>MIME permitidos (coma-separado) <button type="button" class="help-icon" @click="showHelp('uploads.allowedMimeTypes')" title="¿Qué hace esto?">?</button></label>
          <input type="text" :value="cfg.security.uploads.allowedMimeTypes.join(', ')" @change="cfg.security.uploads.allowedMimeTypes = $event.target.value.split(',').map(s => s.trim()).filter(Boolean)" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.uploads.allowSvg" /> Permitir SVG <button type="button" class="help-icon" @click="showHelp('uploads.allowSvg')" title="¿Qué hace esto?">?</button></label>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.uploads.sanitizeSvg" /> Sanitizar SVG con DOMPurify <button type="button" class="help-icon" @click="showHelp('uploads.sanitizeSvg')" title="¿Qué hace esto?">?</button></label>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.uploads.processImages" /> Procesar imágenes con sharp <button type="button" class="help-icon" @click="showHelp('uploads.processImages')" title="¿Qué hace esto?">?</button></label>
        </div>
      </div>

      <h3 style="margin-top:1.5rem">Red</h3>
      <div class="form-row">
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.network.trustForwardedFor" /> Confiar en X-Forwarded-For (sólo con reverse proxy) <button type="button" class="help-icon" @click="showHelp('network.trustForwardedFor')" title="¿Qué hace esto?">?</button></label>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.network.allowInternalHosts" /> Permitir health checks a hosts internos (10/8, 172.16/12, 192.168/16) <button type="button" class="help-icon" @click="showHelp('network.allowInternalHosts')" title="¿Qué hace esto?">?</button></label>
        </div>
        <div class="form-group">
          <label>Cookie domain (ej: .example.com) <button type="button" class="help-icon" @click="showHelp('network.cookieDomain')" title="¿Qué hace esto?">?</button></label>
          <input type="text" x-model="cfg.security.network.cookieDomain" placeholder="(vacío = sin domain)" />
        </div>
      </div>
      <div class="form-group">
        <label>Proxies confiables (uno por línea, informativo) <button type="button" class="help-icon" @click="showHelp('network.trustedProxies')" title="¿Qué hace esto?">?</button></label>
        <textarea x-model="cfg.security.network.trustedProxiesText" rows="3" placeholder="10.0.0.1&#10;192.168.1.0/24"></textarea>
      </div>

      <h3 style="margin-top:1.5rem">Headers de seguridad</h3>
      <div class="form-row">
        <div class="form-group">
          <label>X-Frame-Options <button type="button" class="help-icon" @click="showHelp('headers.xFrameOptions')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.security.headers.xFrameOptions">
            <option value="DENY">DENY (recomendado)</option>
            <option value="SAMEORIGIN">SAMEORIGIN</option>
            <option value="NONE">NONE (desactivar)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Referrer-Policy <button type="button" class="help-icon" @click="showHelp('headers.referrerPolicy')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.security.headers.referrerPolicy">
            <option value="no-referrer">no-referrer</option>
            <option value="same-origin">same-origin</option>
            <option value="strict-origin-when-cross-origin">strict-origin-when-cross-origin</option>
            <option value="no-referrer-when-downgrade">no-referrer-when-downgrade</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Content-Security-Policy (vacío = no se envía header) <button type="button" class="help-icon" @click="showHelp('headers.csp')" title="¿Qué hace esto?">?</button></label>
        <textarea x-model="cfg.security.headers.csp" rows="4"></textarea>
      </div>
      <div class="form-group">
        <label>Permissions-Policy <button type="button" class="help-icon" @click="showHelp('headers.permissionsPolicy')" title="¿Qué hace esto?">?</button></label>
        <input type="text" x-model="cfg.security.headers.permissionsPolicy" />
      </div>
      <h3 style="margin-top:1.5rem">HSTS (Strict-Transport-Security)</h3>
      <p class="muted" style="color:#94a3b8;font-size:0.85rem">
        Sólo se envía si el request es HTTPS. 'auto' lo activa automáticamente
        en deployments HTTPS (recomendado). 'never' desactiva. Cuidado con
        max-age: una vez activado, los browsers lo recuerdan.
      </p>
      <div class="form-row">
        <div class="form-group">
          <label>Modo <button type="button" class="help-icon" @click="showHelp('headers.hsts')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.security.headers.hsts">
            <option value="auto">Auto (default, recomendado)</option>
            <option value="always">Siempre forzar</option>
            <option value="never">Nunca</option>
          </select>
        </div>
        <div class="form-group">
          <label>Max-Age (segundos) <button type="button" class="help-icon" @click="showHelp('headers.hstsMaxAge')" title="¿Qué hace esto?">?</button></label>
          <input type="number" min="0" max="63072000" x-model.number="cfg.security.headers.hstsMaxAge" />
          <small style="color:#94a3b8">Default 31536000 (1 año). 0 desactiva.</small>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.headers.hstsIncludeSubDomains" /> includeSubDomains <button type="button" class="help-icon" @click="showHelp('headers.hstsIncludeSubDomains')" title="¿Qué hace esto?">?</button></label>
          <small style="color:#94a3b8">Activar SÓLO si todos los subdominios son HTTPS.</small>
        </div>
        <div class="form-group">
          <label><input type="checkbox" x-model="cfg.security.headers.hstsPreload" /> preload <button type="button" class="help-icon" @click="showHelp('headers.hstsPreload')" title="¿Qué hace esto?">?</button></label>
          <small style="color:#94a3b8">Para enviar a hstspreload.org. Requiere includeSubDomains y max-age ≥ 1 año.</small>
        </div>
      </div>
    </div>

    <!-- PASSWORD -->
    <div class="panel" :class="tab==='security' && 'active'">
      <h2 style="margin-top:0">Seguridad</h2>
      <h3>Cambiar contraseña <button type="button" class="help-icon" @click="showHelp('security.password')" title="¿Qué hace esto?">?</button></h3>
      <form @submit.prevent="changePassword()" style="max-width:400px">
        <div class="form-group">
          <label>Contraseña actual</label>
          <input type="password" x-model="pwForm.current" required autocomplete="current-password" />
        </div>
        <div class="form-group">
          <label>Nueva contraseña (mín 8)</label>
          <input type="password" x-model="pwForm.next" required minlength="8" autocomplete="new-password" />
        </div>
        <div class="form-group">
          <label>Confirmar</label>
          <input type="password" x-model="pwForm.confirm" required minlength="8" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary">Cambiar</button>
      </form>

      <h3 style="margin-top:2rem">CSRF Token <button type="button" class="help-icon" @click="showHelp('security.csrf')" title="¿Qué hace esto?">?</button></h3>
      <p style="color:#94a3b8;font-size:0.85rem">Este token se rota automáticamente al cambiar la contraseña.</p>
      <code style="display:inline-block;padding:0.4rem 0.7rem;background:#0f172a;border-radius:4px;font-size:0.8rem;word-break:break-all" x-text="csrfToken || '—'"></code>
    </div>

    <!-- AI -->
    <div class="panel" :class="tab==='ai' && 'active'">
      <h2 style="margin-top:0">Asistente IA</h2>
      <p style="color:var(--text-subtle);font-size:0.85rem;margin:0 0 1rem">
        Conectá un provider OpenAI-compatible para mejorar las tarjetas (título + descripción).
        <strong>Apagado por default</strong>: la apiKey no se manda a ningún lado hasta que actives esto.
      </p>
      <div class="form-group">
        <label><input type="checkbox" x-model="cfg.ai.enabled" /> Habilitar asistente IA</label>
      </div>
      <div class="form-row" x-show="cfg.ai.enabled">
        <div class="form-group">
          <label>Preset <button type="button" class="help-icon" @click="showHelp('ai.preset')" title="¿Qué hace esto?">?</button></label>
          <select x-model="aiPreset" @change="applyAiPreset(aiPreset)">
            <option value="">— Custom / Otro —</option>
            <template x-for="p in aiProviders" :key="p.id">
              <option :value="p.id" x-text="p.name"></option>
            </template>
          </select>
          <small style="color:#94a3b8" x-text="presetDescription()"></small>
        </div>
        <div class="form-group" style="flex:1">
          <label>Base URL</label>
          <input type="text" x-model="cfg.ai.baseUrl" placeholder="https://api.openai.com/v1" />
          <small style="color:#94a3b8" x-show="presetRegion()" x-text="presetRegion()" x-cloak></small>
        </div>
      </div>
      <div class="form-row" x-show="cfg.ai.enabled">
        <div class="form-group" style="flex:1">
          <label>
            <span x-text="presetApiKeyLabel()">API Key</span>
            <button type="button" class="help-icon" @click="showHelp('ai.apiKey')" title="¿Por qué en texto plano?">?</button>
          </label>
          <input type="password" x-model="cfg.ai.apiKey" placeholder="sk-..." autocomplete="off" />
          <small style="color:#94a3b8" x-text="presetApiKeyHelp()"></small>
        </div>
        <div class="form-group">
          <label>Modelo <button type="button" class="help-icon" @click="showHelp('ai.model')" title="¿Qué hace esto?">?</button></label>
          <input type="text" x-model="cfg.ai.model" placeholder="gpt-4o-mini" list="ai-model-suggestions" />
          <datalist id="ai-model-suggestions">
            <template x-for="m in presetModels()" :key="m">
              <option :value="m"></option>
            </template>
          </datalist>
        </div>
        <div class="form-group">
          <label>Idioma de la IA <button type="button" class="help-icon" @click="showHelp('ai.language')" title="¿Qué hace esto?">?</button></label>
          <select x-model="cfg.ai.language">
            <template x-for="l in aiLanguages" :key="l.code">
              <option :value="l.code" x-text="l.name"></option>
            </template>
          </select>
          <small style="color:#94a3b8">En qué idioma escribe la IA cuando mejora una tarjeta. No afecta al contenido que ya escribiste vos.</small>
        </div>
      </div>
      <div class="form-group" x-show="cfg.ai.enabled">
        <label>
          System prompt
          <button type="button" class="help-icon" @click="showHelp('ai.systemPrompt')" title="¿Qué es el system prompt?">?</button>
        </label>
        <textarea x-model="cfg.ai.systemPrompt" rows="3" placeholder="Si lo dejás vacío, uso uno default en castellano rioplatense."></textarea>
        <details style="margin-top:0.5rem">
          <summary style="cursor:pointer;color:var(--text-subtle);font-size:0.8rem">
            Ver el system prompt que proponemos por default
            (<span x-text="aiLanguages.find(l => l.code === (cfg.ai?.language || 'es'))?.name || cfg.ai?.language"></span>)
          </summary>
          <pre style="margin-top:0.5rem;padding:0.75rem;background:var(--code-bg);color:var(--code-fg);border:1px solid var(--code-border);border-radius:6px;font-size:0.78rem;white-space:pre-wrap;line-height:1.5" x-text="currentDefaultSystemPrompt()"></pre>
          <button type="button" class="btn btn-sm btn-ghost" style="margin-top:0.4rem" @click="useDefaultSystemPrompt()" x-show="cfg.ai.systemPrompt !== currentDefaultSystemPrompt()">Usar este prompt</button>
        </details>
      </div>
      <div class="form-group" x-show="cfg.ai.enabled">
        <button type="button" class="btn btn-ghost btn-sm" @click="testAI()" :disabled="aiBusy">
          <span x-show="!aiBusy">Probar conexión</span>
          <span x-show="aiBusy" x-cloak>Probando…</span>
        </button>
        <span x-show="aiTestResult" x-text="aiTestResult" style="margin-left:0.75rem;font-size:0.85rem" :class="aiTestOk ? 'help-ok' : 'help-err'" x-cloak></span>
      </div>

      <h3 style="margin-top:1.5rem">
        Búsqueda externa (auto-completar)
        <button type="button" class="help-icon" @click="showHelp('externalSearch.intro')" title="¿Qué hace esto?">?</button>
      </h3>
      <p style="color:var(--text-subtle);font-size:0.82rem;margin:0 0 0.5rem">
        Cuando el botón "Auto-completar" del form de tarjeta no puede scrapear el sitio
        (servicios internos sin HTML público, IP:puerto sin DNS, etc.), hace fallback a
        búsqueda externa. Default sin keys: <strong>Wikipedia + DuckDuckGo</strong>.
        Si cargás una key de Brave o Tavily, se usan primero (mejor calidad).
      </p>
      <div class="form-group">
        <label>
          Brave Search API key <button type="button" class="help-icon" @click="showHelp('externalSearch.brave')" title="¿Qué hace esto?">?</button>
        </label>
        <input type="password" x-model="cfg.externalSearch.braveApiKey" placeholder="BSA..." autocomplete="off" />
        <small style="color:#94a3b8">2000 req/mes gratis. Conseguila en <a href="https://brave.com/search/api/" target="_blank" rel="noopener">brave.com/search/api</a>.</small>
      </div>
      <div class="form-group">
        <label>
          Tavily API key <button type="button" class="help-icon" @click="showHelp('externalSearch.tavily')" title="¿Qué hace esto?">?</button>
        </label>
        <input type="password" x-model="cfg.externalSearch.tavilyApiKey" placeholder="tvly-..." autocomplete="off" />
        <small style="color:#94a3b8">1000 req/mes gratis. Optimizado para AI. Conseguila en <a href="https://tavily.com" target="_blank" rel="noopener">tavily.com</a>.</small>
      </div>
      <details style="margin-top:0.4rem">
        <summary style="cursor:pointer;color:var(--text-subtle);font-size:0.78rem">SearXNG self-hosted (avanzado)</summary>
        <p style="margin-top:0.5rem;font-size:0.82rem;color:var(--text-subtle);line-height:1.5">
          Si querés búsqueda sin límites, sin keys y sin tracking, deployá SearXNG
          (instrucciones en <a href="https://docs.searxng.org/admin/installation.html" target="_blank" rel="noopener">docs.searxng.org</a>).
          Umbral no tiene un campo dedicado para SearXNG, pero podés usar
          <strong>Custom / Otro</strong> en el preset del provider IA y apuntarlo a tu
          instance (después deshabilitás el bloque "Proveedor IA" y dejás sólo el
          endpoint). Para setups más limpios abrí un issue y agregamos un campo.
        </p>
      </details>
    </div>

    <!-- ADVANCED -->
    <div class="panel" :class="tab==='advanced' && 'active'">
      <h2 style="margin-top:0">Avanzado</h2>

      <h3>Export / Import <button type="button" class="help-icon" @click="showHelp('advanced.export')" title="¿Qué hace esto?">?</button></h3>
      <div style="display:flex;gap:0.5rem;margin-bottom:1rem;align-items:center">
        <button class="btn btn-ghost" @click="exportConfig()">Descargar config.json</button>
        <span style="color:#94a3b8;font-size:0.85rem">backup / migración / versionar</span>
      </div>
      <div style="display:flex;gap:0.5rem;margin-bottom:1rem;align-items:center">
        <label class="btn btn-ghost" style="cursor:pointer">
          Importar config.json
          <input type="file" accept="application/json" @change="importConfig($event)" hidden />
        </label>
        <button type="button" class="help-icon" @click="showHelp('advanced.import')" title="¿Qué hace esto?">?</button>
        <span style="color:#94a3b8;font-size:0.85rem">reemplaza la config actual (no es merge)</span>
      </div>

      <h3>Healthcheck <button type="button" class="help-icon" @click="showHelp('advanced.healthcheck')" title="¿Qué hace esto?">?</button></h3>
      <button class="btn btn-ghost" @click="checkHealth()">Probar /api/health</button>
      <pre x-show="healthInfo" x-text="JSON.stringify(healthInfo, null, 2)" style="background:#0f172a;padding:0.75rem;border-radius:6px;margin-top:0.5rem;font-size:0.8rem;overflow:auto" x-cloak></pre>

      <h3 style="margin-top:2rem">Reset <button type="button" class="help-icon" @click="showHelp('advanced.reset')" title="¿Qué hace esto?">?</button></h3>
      <p style="color:#94a3b8;font-size:0.85rem">Restaura la configuración a los valores por defecto (mantiene la contraseña y el CSRF).</p>
      <button class="btn btn-danger" @click="resetConfig()">Reset a defaults</button>
    </div>

    <!-- Card editor modal -->
    <template x-if="editingCard !== null">
      <div class="modal-backdrop" @click.self="tryCancelEdit()">
        <div class="modal" @keydown.escape.window="tryCancelEdit()">
          <h2 style="margin-top:0">Editar tarjeta</h2>
          <form @submit.prevent="saveCard()" @input="cardFormDirty = true" :key="editingKey">
            <div class="form-row">
              <div class="form-group">
                <label>Título <button type="button" class="help-icon" @click="showHelp('card.title')" title="¿Qué hace esto?">?</button></label>
                <input type="text" x-model="editingCard.title" required maxlength="80" />
              </div>
              <div class="form-group">
                <label>Tipo <button type="button" class="help-icon" @click="showHelp('card.kind')" title="¿Qué hace esto?">?</button></label>
                <select x-model="editingCard.kind">
                  <option value="link">Link (clickeable)</option>
                  <option value="note">Nota (informativa, sin link)</option>
                </select>
                <small style="color:#94a3b8">"Link" lleva a una URL. "Nota" es solo informativa (anuncios, tips, etc.).</small>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group" style="flex:1">
                <label>URL <button type="button" class="help-icon" @click="showHelp('card.url')" title="¿Qué hace esto?">?</button> <span x-show="editingCard.kind==='link'" style="color:#dc2626">*</span></label>
                <div style="display:flex;gap:0.4rem;align-items:flex-start">
                  <input
                    type="text"
                    x-model="editingCard.url"
                    :required="editingCard.kind==='link'"
                    placeholder="https://… o /docs"
                    style="flex:1"
                    @blur="maybeAutofillFromUrl()"
                  />
                  <button
                    type="button"
                    class="btn btn-sm btn-ghost"
                    @click="autofillFromUrl()"
                    :disabled="autofillBusy || (!editingCard.url && !editingCard.title)"
                    title="Traer título/desc/imagen del sitio (URL) o de la búsqueda externa (título)"
                    x-show="editingCard.kind==='link'"
                  >
                    <span x-show="!autofillBusy">Auto-completar</span>
                    <span x-show="autofillBusy" x-cloak>Buscando…</span>
                  </button>
                </div>
                <small style="color:#94a3b8">
                  <template x-if="editingCard.kind==='link'">
                    <span>URL externa (https://…) o path interno (/docs, /admin). Obligatoria. Auto-completar trae título/desc/imagen del sitio.</span>
                  </template>
                  <template x-if="editingCard.kind==='note'">
                    <span>Opcional para notas. Útil si querés un link de referencia dentro del texto.</span>
                  </template>
                </small>
              </div>
            </div>
            <div class="form-group" x-show="cfg.ai?.enabled && editingCard.kind==='link'" style="display:flex;gap:0.4rem;align-items:center;padding:0.5rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm)">
              <span style="color:var(--text-subtle);font-size:0.85rem">IA: </span>
              <button
                type="button"
                class="btn btn-sm btn-ghost"
                @click="improveWithAI()"
                :disabled="aiBusy || !editingCard.title"
                title="Mejorar el título y descripción con la IA configurada"
              >
                <span x-show="!aiBusy">Mejorar con IA</span>
                <span x-show="aiBusy" x-cloak>Pensando…</span>
              </button>
              <span style="color:var(--text-faint);font-size:0.75rem">
                Usa la config de IA (Admin → IA). Editá el prompt system ahí si querés otro estilo.
              </span>
            </div>
            <div class="form-group">
              <label>Descripción <button type="button" class="help-icon" @click="showHelp('card.description')" title="¿Qué hace esto?">?</button></label>
              <textarea x-model="editingCard.description" maxlength="200"></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Categoría <button type="button" class="help-icon" @click="showHelp('card.category')" title="¿Qué hace esto?">?</button></label>
                <!-- BUGFIX (categoría no se cargaba al editar reportado por
                     el user): Alpine 3 procesa directivas en orden de aparición
                     en el DOM. Cuando el form se monta, el <select x-model=
                     "editingCard.category"> se inicializa ANTES de que el
                     <template x-for="c in cfg.categories"> haya renderizado
                     los <option>. En ese momento editingCard.category tiene
                     un valor (ej: "com") pero no hay ningún <option value=
                     "com"> en el DOM todavía, así que el select cae al
                     fallback "— seleccionar —" y se queda ahí aunque las
                     options se rendericen un instante después. El x-model
                     NO re-evalúa cuando se agregan options nuevas — sólo
                     cuando cambia el valor bindeado.
                     
                     El fix canónico de Alpine 3 para este caso es x-init +
                     $nextTick: setear el value explícitamente después de que
                     el próximo tick renderizó las options. Por qué $nextTick
                     y no setTimeout: $nextTick se ejecuta justo después del
                     próximo batch de render, así que las options ya están en
                     el DOM y el .value = 'com' encuentra su match. -->
                <select
                  x-model="editingCard.category"
                  x-init="$nextTick(() => $el.value = editingCard.category || '')"
                  required
                >
                    <option value="">— seleccionar —</option>
                    <template x-for="c in cfg.categories" :key="c.id">
                      <option :value="c.id" x-text="c.name"></option>
                    </template>
                </select>
              </div>
              <div class="form-group">
                <label>Color <button type="button" class="help-icon" @click="showHelp('card.color')" title="¿Qué hace esto?">?</button></label>
                <input type="color" x-model="editingCard.color" />
              </div>
            </div>
            <div class="form-group">
              <label>Ícono <button type="button" class="help-icon" @click="showHelp('card.icon')" title="¿Qué hace esto?">?</button></label>
              <!-- Picker visual: cada fila es un ícono + nombre, click selecciona.
                   El user pidió "listbox que muestre los íconos junto al nombre de
                   cada uno" — esto es exactamente eso. El input de texto de abajo
                   queda sólo para custom paths (assets subidos, lucide icons que
                   no estén en el set, etc.). -->
              <div class="icon-picker">
                <button
                  type="button"
                  class="icon-picker-item"
                  :class="!editingCard.icon && 'selected'"
                  @click="editingCard.icon=''; markDirty()"
                >
                  <span class="icon-picker-img" aria-hidden="true">🚫</span>
                  <span class="icon-picker-name">Sin ícono</span>
                </button>
                <template x-for="i in builtinIcons" :key="i">
                  <button
                    type="button"
                    class="icon-picker-item"
                    :class="editingCard.icon===i && 'selected'"
                    @click="editingCard.icon=i; markDirty()"
                    :title="i"
                  >
                    <span class="icon-picker-img">
                      <img :src="'/icons/' + i + '.svg'" :alt="i" />
                    </span>
                    <span class="icon-picker-name" x-text="i"></span>
                  </button>
                </template>
              </div>
              <!-- Custom path: input secundario, sólo para assets subidos o
                   nombres que no estén en el picker. -->
              <details style="margin-top:0.5rem">
                <summary style="cursor:pointer;color:var(--text-subtle);font-size:0.78rem">¿Usar un asset subido o un nombre custom?</summary>
                <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.4rem">
                  <input
                    type="text"
                    x-model="editingCard.icon"
                    placeholder="/api/assets/mi-logo.png o nombre-lucide"
                    style="flex:1"
                  />
                  <button type="button" class="btn btn-sm btn-ghost" @click="editingCard.icon=''">Limpiar</button>
                </div>
                <small style="color:#94a3b8">
                  Pegá la URL de un asset que subiste (tipo <code>/api/assets/mi-logo.png</code>),
                  o un nombre de ícono Lucide no listado (ej: <code>rocket</code>, <code>database</code>).
                </small>
              </details>
            </div>
            <div class="form-row">
              <div class="form-group" x-show="editingCard.kind==='link'">
                <label>
                  <input type="checkbox" x-model="editingCard.openInNewTab" /> Abrir en nueva pestaña
                  <button type="button" class="help-icon" @click="showHelp('card.openInNewTab')" title="¿Qué hace esto?">?</button>
                </label>
              </div>
              <div class="form-group">
                <label>
                  <input type="checkbox" x-model="editingCard.enabled" /> Activa
                  <button type="button" class="help-icon" @click="showHelp('card.enabled')" title="¿Qué hace esto?">?</button>
                </label>
              </div>
              <div class="form-group" x-show="editingCard.kind==='link'">
                <label>
                  <input type="checkbox" x-model="editingCard.healthCheck" /> Health check (dot en vivo)
                  <button type="button" class="help-icon" @click="showHelp('card.healthCheck')" title="¿Qué hace esto?">?</button>
                </label>
              </div>
            </div>
            <div style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:1rem">
              <button type="button" class="btn btn-ghost" @click="tryCancelEdit()">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </template>

    <!-- Help modal — se abre al clickear un ícono "?" del admin.
         Lee el texto de window.__helpTexts[currentKey]. -->
    <template x-if="helpModalKey !== null && currentHelp()">
      <div class="modal-backdrop" @click.self="closeHelp()" @keydown.escape.window="closeHelp()">
        <div class="modal help-modal">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:0.5rem">
            <h2 style="margin:0" x-text="currentHelp().title"></h2>
            <button type="button" class="btn btn-ghost btn-sm" @click="closeHelp()" aria-label="Cerrar">✕</button>
          </div>
          <p style="color:var(--text-subtle);font-size:0.85rem;margin:0 0 1rem" x-text="currentHelp().short"></p>
          <div class="help-body" x-text="currentHelp().body" style="white-space:pre-wrap;font-size:0.9rem;line-height:1.6"></div>
          <div style="display:flex;justify-content:flex-end;margin-top:1rem">
            <button type="button" class="btn btn-primary btn-sm" @click="closeHelp()">Entendido</button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Alpine.js + Sortable + dashboard logic -->
  <script is:inline define:vars={{ initialConfig: config, builtinIcons, AI_PROVIDERS, DEFAULT_AI_SYSTEM_PROMPT, HELP_TEXTS, AI_LANGUAGES, DEFAULT_AI_SYSTEM_PROMPTS }}>
    // Mirror trustedProxies (array) into a text form so the textarea can edit it.
    initialConfig.security.network.trustedProxiesText = (initialConfig.security.network.trustedProxies || []).join('\n');
    // expose config to adminApp data
    window.__initialConfig = initialConfig;
    window.__builtinIcons = builtinIcons;
    window.__aiProviders = AI_PROVIDERS;
    window.__defaultAiSystemPrompt = DEFAULT_AI_SYSTEM_PROMPT;
    window.__helpTexts = HELP_TEXTS;
    window.__aiLanguages = AI_LANGUAGES;
    window.__defaultAiSystemPrompts = DEFAULT_AI_SYSTEM_PROMPTS;
  </script>
  <script>
    import Alpine from 'alpinejs';
    import Sortable from 'sortablejs';
    window.Alpine = Alpine;
    window.Sortable = Sortable;

    document.addEventListener('alpine:init', () => {
      Alpine.data('adminApp', () => ({
        tab: 'cards',
        cfg: null,
        original: null,
        dirty: false,
        busy: false,
        assets: [],
        uploadKind: 'icon',
        uploaderDragover: false,
        cardFilter: '',
        editingCard: null,
        editingIndex: -1,
        // BUGFIX: se incrementa en cada editCard() para forzar re-mount del
        // form via :key="editingKey". Sin esto, Alpine puede mantener
        // bindings stale cuando se cambia de una tarjeta a otra rápido,
        // y el form muestra los datos de la anterior o valores vacíos.
        editingKey: 0,
        // `true` cuando el user modificó algo en el form del modal de tarjeta.
        // Usado por tryCancelEdit para confirmar antes de descartar. NO es
        // lo mismo que `dirty` (que es el flag global de "cambios sin guardar
        // en el config"): cardFormDirty es local al modal.
        cardFormDirty: false,
        // Para el botón "Auto-completar" del modal: bloquea el botón mientras
        // se hace el fetch al sitio externo.
        autofillBusy: false,
        // Para el botón "Probar conexión" en la tab IA.
        aiBusy: false,
        aiTestResult: '',
        aiTestOk: false,
        statusResults: [],
        checkingStatus: false,
        healthInfo: null,
        selectedAsset: null,
        builtinIcons: window.__builtinIcons || [],
        csrfToken: (document.body.dataset.csrf || ''),
        pwForm: { current: '', next: '', confirm: '' },
        // AI provider presets (cargados desde src/pages/admin/ai-providers.ts).
        // Sirven para auto-rellenar baseUrl y model cuando elegís un provider
        // popular (OpenAI, Anthropic, Gemini, etc.). No bloquean — podés editar
        // los valores después y la UI detecta automáticamente si matchean un preset.
        aiProviders: window.__aiProviders || [],
        aiPreset: '',
        // Idiomas disponibles para el system prompt default de la IA.
        // Cargados desde src/lib/ai-prompts.ts. La lista de códigos matchea
        // exactamente con cfg.ai.language (validado por zod en el schema).
        aiLanguages: window.__aiLanguages || [],
        // Map de prompts default por idioma. Se usa para mostrar el preview
        // y para "Usar este prompt" según el idioma actual.
        defaultSystemPrompts: window.__defaultAiSystemPrompts || {},
        defaultSystemPrompt: window.__defaultAiSystemPrompt || '',
        // Help texts (cargados desde src/pages/admin/help-texts.ts).
        helpTexts: window.__helpTexts || {},
        // Modal de ayuda actualmente abierto (key del HELP_TEXTS).
        helpModalKey: null,

        async init() {
          this.cfg = structuredClone(window.__initialConfig);
          this.original = structuredClone(window.__initialConfig);
          // BUGFIX (regresión reportada por el user): si el server arrancó
          // con un config viejo (sin `ai` ni otras secciones nuevas) y por
          // algún motivo el cache devolvió un cfg sin `ai`, Alpine tira
          // "Cannot read properties of undefined (reading 'enabled')" en
          // cada binding del tab IA. Rellenamos con defaults del lado del
          // cliente como red de seguridad: el server también lo hace (ver
          // loadFresh), pero esto evita la cascada de errores en lo que el
          // cache se refresca.
          if (!this.cfg.ai) this.cfg.ai = { enabled: false, provider: 'openai-compatible', baseUrl: 'https://api.openai.com/v1', apiKey: '', model: 'gpt-4o-mini', systemPrompt: '', language: 'es' };
          // Mismo fallback para externalSearch.
          if (!this.cfg.externalSearch) this.cfg.externalSearch = { braveApiKey: '', tavilyApiKey: '' };
          // Por si el cache tiene un cfg.ai sin el campo `language` (cards
          // viejas previas a este commit), lo rellenamos con 'es' (default).
          if (!this.cfg.ai.language) this.cfg.ai.language = 'es';
          // Mismo fallback para los widgets nuevos del theme (no deberían
          // faltar porque el schema llena defaults, pero por si el cache
          // quedó stale durante un rolling update).
          if (typeof this.cfg.theme.showClock !== 'boolean') this.cfg.theme.showClock = false;
          if (typeof this.cfg.theme.showRefresh !== 'boolean') this.cfg.theme.showRefresh = false;
          if (typeof this.cfg.theme.showStatusBar !== 'boolean') this.cfg.theme.showStatusBar = false;
          if (typeof this.cfg.theme.groupLayout !== 'string') this.cfg.theme.groupLayout = 'vertical';
          if (typeof this.cfg.layout.healthCheckInterval !== 'number') this.cfg.layout.healthCheckInterval = 60;
          // Defer refreshAssets until after the page's umbralAdmin is defined.
          // AdminLayout's inline script defines it; this module script may run
          // before or after that depending on Vite's module loading order.
          if (window.umbralAdmin) {
            await this.refreshAssets();
          } else {
            // Retry a few times in case the inline script hasn't parsed yet.
            for (let i = 0; i < 5 && !window.umbralAdmin; i++) {
              await new Promise((r) => setTimeout(r, 20));
            }
            if (window.umbralAdmin) await this.refreshAssets();
          }
          this.$nextTick(() => this.initSortable());
          // Auto-mark dirty on any cfg change. x-model alone doesn't fire markDirty,
          // so we deep-watch cfg and re-check after each mutation. Cheap because
          // we only stringify when something actually changes.
          this.$watch('cfg', () => this.markDirty());
          // Auto-detectar el preset de IA según el baseUrl actual. Si el user
          // tenía OpenAI y eligió OpenAI en el preset, o si su config actual
          // matchea un preset, lo dejamos pre-seleccionado.
          this.aiPreset = this.currentPresetId();
          // Si el user cambia baseUrl a mano, sincronizamos el dropdown.
          this.$watch('cfg.ai.baseUrl', () => {
            const matched = this.currentPresetId();
            if (matched !== this.aiPreset) this.aiPreset = matched;
          });
        },

        markDirty() { this.dirty = JSON.stringify(this.cfg) !== JSON.stringify(this.original); },

        // ── AI provider presets ──────────────────────────────────────
        // Cuando el user elige un preset, rellenamos baseUrl y model con los
        // valores oficiales. Si después edita baseUrl a mano, el preset se
        // "deselecciona" automáticamente (presetId() devuelve '' porque ya
        // no matchea). Así el preset es sugerencia, no lock.
        applyAiPreset(presetId) {
          const p = this.aiProviders.find((x) => x.id === presetId);
          if (!p) return;
          this.cfg.ai.baseUrl = p.baseUrl;
          this.cfg.ai.model = p.defaultModel;
          this.markDirty();
        },
        // Devuelve el ID del preset que matchea el baseUrl actual, o '' si es custom.
        currentPresetId() {
          const bu = (this.cfg.ai?.baseUrl || '').replace(/\/+$/, '').toLowerCase();
          if (!bu) return '';
          const p = this.aiProviders.find((x) => x.baseUrl.replace(/\/+$/, '').toLowerCase() === bu);
          return p?.id || '';
        },
        presetDescription() {
          const id = this.aiPreset || this.currentPresetId();
          const p = this.aiProviders.find((x) => x.id === id);
          return p?.description || 'Custom: cualquier endpoint /v1/chat/completions';
        },
        presetRegion() {
          const id = this.aiPreset || this.currentPresetId();
          const p = this.aiProviders.find((x) => x.id === id);
          return p?.region || '';
        },
        presetApiKeyLabel() {
          const id = this.aiPreset || this.currentPresetId();
          const p = this.aiProviders.find((x) => x.id === id);
          return p?.apiKeyLabel || 'API Key';
        },
        presetApiKeyHelp() {
          const id = this.aiPreset || this.currentPresetId();
          const p = this.aiProviders.find((x) => x.id === id);
          return p?.apiKeyHelp || 'Tu clave del provider. Se guarda en data/config.json en texto plano (ver ayuda en el ícono ?).';
        },
        presetModels() {
          const id = this.aiPreset || this.currentPresetId();
          const p = this.aiProviders.find((x) => x.id === id);
          return p?.models || [];
        },
        useDefaultSystemPrompt() {
          // Carga el prompt default del idioma actual (no el español).
          this.cfg.ai.systemPrompt = this.currentDefaultSystemPrompt();
          this.markDirty();
        },
        // El preview que se muestra debajo del textarea. Si el user
        // cambió el idioma, este getter devuelve el prompt en el nuevo
        // idioma, así el preview matchea.
        currentDefaultSystemPrompt() {
          const lang = (this.cfg.ai && this.cfg.ai.language) || 'es';
          return this.defaultSystemPrompts[lang] || this.defaultSystemPrompts.es || this.defaultSystemPrompt;
        },

        // ── Help modal ──────────────────────────────────────────────
        showHelp(key) { this.helpModalKey = key; },
        closeHelp() { this.helpModalKey = null; },
        currentHelp() {
          if (!this.helpModalKey) return null;
          return this.helpTexts[this.helpModalKey] || null;
        },

        async testAI() {
          this.aiTestResult = '';
          this.aiTestOk = false;
          if (!this.cfg.ai?.enabled) {
            this.aiTestResult = '✗ Activá el switch "Habilitar asistente IA" arriba primero.';
            return;
          }
          if (!this.cfg.ai?.baseUrl) {
            this.aiTestResult = '✗ Falta Base URL. Elegí un preset o tipeá la URL del provider.';
            return;
          }
          if (!this.cfg.ai?.model) {
            this.aiTestResult = '✗ Falta Modelo. Elegí un preset (que autocompleta) o tipeá el nombre del modelo.';
            return;
          }
          this.aiBusy = true;
          try {
            // El server lee su propia config (la persistida). Si el user cambió
            // algo y no guardó todavía, el test va a usar la config vieja. Para
            // evitar eso: primero guardamos silenciosamente y después testeamos.
            await window.umbralAdmin.api('PUT', '/api/config', this.cfg).catch(() => null);
            const res = await fetch('/api/ai/format-card', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                title: 'GitHub',
                description: 'Plataforma de código',
                url: 'https://github.com',
              }),
            });
            if (res.ok) {
              const data = await res.json();
              this.aiTestOk = true;
              this.aiTestResult = `✓ Conectado. Respuesta: "${data.title}" / "${data.description}"`;
              // refrescamos la config en memoria (PUT exitoso la devuelve)
              const updated = await window.umbralAdmin.api('GET', '/api/config').catch(() => null);
              if (updated) { this.cfg = structuredClone(updated); this.original = structuredClone(updated); this.dirty = false; }
            } else {
              const err = await res.json().catch(() => ({}));
              this.aiTestResult = `✗ ${res.status}: ${err.error || res.statusText}`;
            }
          } catch (err) {
            this.aiTestResult = `✗ ${err.message}`;
          } finally {
            this.aiBusy = false;
          }
        },

        initSortable() {
          // Tarjetas: drag-and-drop reordena `cfg.cards` y renumera `order`.
          // (El `order` se persiste para que el home ordene por valor, no por
          // posición del array — más robusto frente a migraciones.)
          const cardsEl = document.getElementById('cards-sortable');
          if (cardsEl) {
            Sortable.create(cardsEl, {
              handle: '.drag-handle',
              animation: 150,
              onEnd: (evt) => {
                const arr = this.cfg.cards;
                const [moved] = arr.splice(evt.oldIndex, 1);
                arr.splice(evt.newIndex, 0, moved);
                arr.forEach((c, i) => c.order = i);
                this.markDirty();
              },
            });
          }
          // Categorías: drag-and-drop reordena el array `cfg.categories`.
          // No hay campo `order` en CategorySchema — el home ahora respeta
          // la posición del array (ver src/pages/index.astro: sortByCatOrder).
          const catsEl = document.getElementById('categories-sortable');
          if (catsEl) {
            Sortable.create(catsEl, {
              handle: '.drag-handle',
              animation: 150,
              onEnd: (evt) => {
                const arr = this.cfg.categories;
                const [moved] = arr.splice(evt.oldIndex, 1);
                arr.splice(evt.newIndex, 0, moved);
                this.markDirty();
              },
            });
          }
        },

        async refreshAssets() {
          try {
            const data = await window.umbralAdmin.api('GET', '/api/assets');
            this.assets = data.items || [];
          } catch (e) { console.error(e); }
        },

        filteredCards() {
          if (!this.cfg) return [];
          const q = this.cardFilter.toLowerCase().trim();
          const sorted = [...this.cfg.cards].sort((a,b) => a.order - b.order);
          if (!q) return sorted;
          return sorted.filter(c =>
            (c.title || '').toLowerCase().includes(q) ||
            (c.description || '').toLowerCase().includes(q) ||
            (c.url || '').toLowerCase().includes(q)
          );
        },

        addCard() {
          if (!this.cfg.categories.length) {
            window.umbralAdmin.toast('Primero creá una categoría', 'error');
            this.tab = 'categories';
            return;
          }
          this.editingIndex = -1;
          // Bumpear editingKey para que el form se re-mountee con el default
          // "Nueva tarjeta" en lugar de mostrar datos de la edición anterior.
          this.editingKey = (this.editingKey || 0) + 1;
          this.editingCard = {
            id: 'card-' + Date.now().toString(36),
            title: 'Nueva tarjeta',
            kind: 'link',
            description: '',
            url: 'https://',
            icon: this.builtinIcons[0] || 'globe',
            category: this.cfg.categories[0].id,
            openInNewTab: true,
            color: this.cfg.theme.accentColor,
            order: this.cfg.cards.length,
            enabled: true,
            healthCheck: false,
          };
        },
        async editCard(idx) {
          const cardId = this.filteredCards()[idx]?.id;
          if (cardId) {
            const target = this.cfg.cards.find((c) => c.id === cardId);
            if (target && this.isSystemCard(target)) {
              window.umbralAdmin.toast('Esta tarjeta es del sistema (apunta a la documentación de Umbral en /docs) y no se puede editar.', 'error');
              return;
            }
          }
          if (!cardId) {
            window.umbralAdmin.toast('No se pudo encontrar la tarjeta', 'error');
            return;
          }
          const realIdx = this.cfg.cards.findIndex((c) => c.id === cardId);
          if (realIdx < 0) {
            window.umbralAdmin.toast('No se pudo encontrar la tarjeta en la config', 'error');
            return;
          }
          try {
            // Re-validar contra el schema. Si la card en memoria tiene
            // campos faltantes (cards viejas sin kind/healthCheck), zod
            // los rellena con los defaults.
            const { CardSchema } = await import('~/lib/schema');
            const parsed = CardSchema.safeParse(this.cfg.cards[realIdx]);
            if (!parsed.success) {
              window.umbralAdmin.toast('La tarjeta en disco está corrupta: ' + parsed.error.issues.map(i => i.message).join('; '), 'error');
              return;
            }
            this.editingIndex = realIdx;
            // Spread shallow + parsed (que ya tiene defaults aplicados).
            // structuredClone o JSON.parse(JSON.stringify) sobre un proxy
            // de Alpine 3 puede perder tipos o referencias. Spread es
            // suficiente porque CardSchema es flat (sin objetos anidados).
            this.editingCard = { ...parsed.data };
            this.cardFormDirty = false;
            // Incrementar el key fuerza re-mount del form, eliminando
            // cualquier binding stale de la edición anterior.
            this.editingKey = (this.editingKey || 0) + 1;
            this.$nextTick(() => {
              const modal = document.querySelector('.modal');
              if (modal) modal.scrollTop = 0;
            });
          } catch (err) {
            console.error('[umbral] editCard failed:', err);
            window.umbralAdmin.toast('Error abriendo la tarjeta: ' + err.message, 'error');
          }
        },
        saveCard() {
          if (!this.editingCard) return;
          if (this.editingIndex < 0) {
            this.cfg.cards.push({ ...this.editingCard });
          } else {
            this.cfg.cards[this.editingIndex] = { ...this.editingCard };
          }
          this.cancelEdit();
          this.markDirty();
        },
        cancelEdit() { this.editingCard = null; this.editingIndex = -1; this.cardFormDirty = false; },
        // Cierra el modal con confirmación si hay cambios sin guardar. Se usa
        // para ESC, click fuera, y botón Cancelar. Para "Guardar" no aplica
        // porque ahí los cambios van al cfg local.
        tryCancelEdit() {
          if (this.cardFormDirty) {
            const ok = window.confirm('Tenés cambios sin guardar en esta tarjeta. ¿Descartarlos?');
            if (!ok) return;
          }
          this.cancelEdit();
        },
        // Auto-completar el form desde la URL o el nombre. Pide a
        // /api/fetch-card-info que scrapea el <head> del sitio y, si no
        // encuentra nada útil, hace fallback a búsqueda externa
        // (Brave/Tavily si hay key, Wikipedia + DuckDuckGo siempre).
        // Sólo sobreescribe campos VACÍOS — no pisa lo que el user ya escribió.
        async autofillFromUrl() {
          if (!this.editingCard?.url && !this.editingCard?.title) return;
          const url = this.editingCard.url;
          const name = this.editingCard.title;
          // Si hay URL, sólo la mandamos si parece http(s) o path interno.
          // Si no, mandamos sólo el name.
          const params = new URLSearchParams();
          if (url && /^https?:\/\//.test(url)) params.set('url', url);
          if (name && name.trim()) params.set('name', name.trim());
          if (!params.toString()) return;
          this.autofillBusy = true;
          try {
            const res = await fetch(`/api/fetch-card-info?${params.toString()}`);
            if (!res.ok) {
              const e = await res.json().catch(() => ({}));
              window.umbralAdmin.toast(e.error || `Error HTTP ${res.status}`, 'error');
              return;
            }
            const data = await res.json();
            let filled = 0;
            if (data.title && (!this.editingCard.title || this.editingCard.title === 'Nueva tarjeta' || this.editingCard.title.trim() === '')) {
              this.editingCard.title = data.title; filled++;
            }
            if (data.description && !this.editingCard.description) {
              this.editingCard.description = data.description; filled++;
            }
            // La imagen: si vino una, la subimos como asset vía el endpoint
            // /api/upload-from-url (que hace el download server-side, evitando
            // el CSP `connect-src 'self'` del browser). Si falla, no tocamos
            // el ícono — la card queda sin imagen pero con title/description.
            if (data.image) {
              try {
                const upRes = await fetch('/api/upload-from-url', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json', 'x-csrf-token': window.umbralAdmin.csrf },
                  body: JSON.stringify({ url: data.image, kind: 'icon' }),
                });
                // BUGFIX (4xx limpio, no más 502 en consola): /api/upload-from-url
                // ahora devuelve 200 con {ok:false, reason:'not_found'} cuando el
                // origen responde 4xx (ej: 404 por favicon inexistente, 403 por
                // hotlink protection). Eso evita que la consola se llene de
                // "502 Bad Gateway" cada vez que un sitio no expone og:image.
                if (upRes.ok) {
                  const up = await upRes.json();
                  if (up.ok && up.url) {
                    this.editingCard.icon = up.url; filled++;
                  } else {
                    console.warn('[umbral] upload-from-url skipped:', up.reason || 'unknown');
                  }
                } else {
                  const err = await upRes.json().catch(() => ({}));
                  console.warn('[umbral] upload-from-url failed:', err.error || upRes.status);
                }
              } catch (err) {
                console.warn('[umbral] upload-from-url error:', err);
              }
            }
            const sourceLabel = ({ scrape: 'scrape del sitio', brave: 'Brave', tavily: 'Tavily', wikipedia: 'Wikipedia', duckduckgo: 'DuckDuckGo', none: 'ninguna fuente' } as Record<string, string>)[data.source] || data.source;
            if (filled > 0) {
              window.umbralAdmin.toast(`Autocompletado: ${filled} campo(s) desde ${sourceLabel}`, 'success');
            } else {
              window.umbralAdmin.toast(`No se encontró info útil (${sourceLabel}). Cargá título/desc a mano.`, 'info');
            }
            this.markDirty();
          } catch (err) {
            window.umbralAdmin.toast(`Error: ${err.message}`, 'error');
          } finally {
            this.autofillBusy = false;
          }
        },
        // Disparado en blur del input URL. Sólo auto-completar si el form
        // está prácticamente vacío (no pisar lo que el user ya tipeó).
        maybeAutofillFromUrl() {
          if (!this.editingCard?.url) return;
          const ec = this.editingCard;
          const isEmpty = (!ec.title || ec.title === 'Nueva tarjeta' || !ec.title.trim())
            && !ec.description
            && (!ec.icon || ec.icon === this.builtinIcons[0]);
          if (isEmpty) this.autofillFromUrl();
        },
        async improveWithAI() {
          if (!this.editingCard?.title) return;
          this.aiBusy = true;
          try {
            const res = await fetch('/api/ai/format-card', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                title: this.editingCard.title,
                description: this.editingCard.description,
                url: this.editingCard.url,
              }),
            });
            if (!res.ok) {
              const e = await res.json().catch(() => ({}));
              window.umbralAdmin.toast(e.error || `Error HTTP ${res.status}`, 'error');
              return;
            }
            const data = await res.json();
            if (data.title) this.editingCard.title = data.title;
            if (data.description !== undefined) this.editingCard.description = data.description;
            window.umbralAdmin.toast('Mejorado con IA. Revisá antes de guardar.', 'success');
          } catch (err) {
            window.umbralAdmin.toast(`Error: ${err.message}`, 'error');
          } finally {
            this.aiBusy = false;
          }
        },
        removeCard(idx) {
          const target = this.filteredCards()[idx];
          if (target && this.isSystemCard(target)) {
            window.umbralAdmin.toast('Esta tarjeta es del sistema (apunta a la documentación de Umbral en /docs) y no se puede borrar. Si no la querés ver, desactivala con el switch "Activa".', 'error');
            return;
          }
          const id = target.id;
          if (!confirm('¿Borrar esta tarjeta?')) return;
          this.cfg.cards = this.cfg.cards.filter(c => c.id !== id);
          this.markDirty();
        },
        // ── System cards ───────────────────────────────────────────
        // La card de docs (id='docs' o url='/docs*') la crea el sistema y la
        // protege a nivel server. La UI tampoco expone Editar/Borrar — pero
        // defendemos también acá por si alguien la llama por código.
        // Heurística: cualquier card con id 'docs' o url que apunte a /docs
        // (incluyendo /docs/algo) es system. El user puede "ocultarla"
        // con el toggle "Activa", pero no editarla ni borrarla.
        isSystemCard(card) {
          if (!card) return false;
          if (card.id === 'docs') return true;
          const u = (card.url || '').toLowerCase();
          return u === '/docs' || u.startsWith('/docs/') || u.startsWith('/docs?');
        },

        addCategory() {
          this.cfg.categories.push({ id: 'cat-' + Date.now().toString(36), name: 'Nueva', icon: 'folder' });
          this.markDirty();
        },
        removeCategory(idx) {
          if (this.cfg.categories.length <= 1) {
            window.umbralAdmin.toast('No podés borrar la última categoría (las tarjetas necesitan una)', 'error');
            return;
          }
          if (!confirm('¿Borrar esta categoría? Las tarjetas que la usen se reasignan a la primera restante.')) return;
          const id = this.cfg.categories[idx].id;
          this.cfg.categories.splice(idx, 1);
          // Reasignar cards huérfanas a la primera categoría que queda. Si por
          // alguna razón quedó vacía (no debería pasar con el check de arriba),
          // caemos a string vacío → el save fallará con un error claro del
          // schema (category: min(1)).
          const fallback = this.cfg.categories[0]?.id || '';
          this.cfg.cards.forEach(c => { if (c.category === id) c.category = fallback; });
          this.markDirty();
        },

        async saveAll() {
          this.busy = true;
          try {
            // Sync textarea → array before sending.
            this.cfg.security.network.trustedProxies = (this.cfg.security.network.trustedProxiesText || '')
              .split('\n').map((s) => s.trim()).filter(Boolean);
            // BUGFIX (PUT 400 reportado por el user): defense-in-depth para
            // descripciones de tarjetas largas. El server ya clampea en el
            // schema, pero hacerlo acá también evita que un save "limpio" del
            // cliente termine con la descripción truncada a 200 silenciosa-
            // mente. Mostramos un toast informativo si truncamos algo, así
            // el user sabe que el server le acortó la descripción y puede
            // revisarla.
            let clampedCount = 0;
            for (const card of this.cfg.cards) {
              if (typeof card.description === 'string' && card.description.length > 200) {
                card.description = card.description.slice(0, 200);
                clampedCount++;
              }
            }
            const updated = await window.umbralAdmin.api('PUT', '/api/config', this.cfg);
            this.cfg = structuredClone(updated);
            this.original = structuredClone(updated);
            this.dirty = false;
            if (clampedCount > 0) {
              window.umbralAdmin.toast(
                `Configuración guardada (${clampedCount} descripción${clampedCount > 1 ? 'es' : ''} truncada${clampedCount > 1 ? 's' : ''} a 200 chars)`,
                'info',
              );
            } else {
              window.umbralAdmin.toast('Configuración guardada', 'success');
            }
            await this.refreshAssets();
          } catch (e) {
            window.umbralAdmin.toast('Error: ' + e.message, 'error');
          } finally {
            this.busy = false;
          }
        },

        async reloadConfig() {
          if (this.dirty && !confirm('Hay cambios sin guardar. ¿Recargar igual?')) return;
          try {
            const cfg = await window.umbralAdmin.api('GET', '/api/config');
            this.cfg = structuredClone(cfg);
            this.original = structuredClone(cfg);
            this.dirty = false;
            window.umbralAdmin.toast('Recargado', 'success');
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
        },

        async handleFileSelect(e) {
          await this.uploadFiles(e.target.files);
          e.target.value = '';
        },
        async handleFileDrop(e) {
          this.uploaderDragover = false;
          await this.uploadFiles(e.dataTransfer.files);
        },
        async uploadFiles(files) {
          for (const file of files) {
            try {
              const fd = new FormData();
              fd.append('file', file);
              fd.append('kind', this.uploadKind);
              const res = await fetch('/api/upload', {
                method: 'POST',
                headers: { 'x-csrf-token': window.umbralAdmin.csrf },
                body: fd,
              });
              if (res.status === 401) { window.location.href = '/admin'; return; }
              const data = await res.json();
              if (!res.ok) { window.umbralAdmin.toast(file.name + ': ' + (data.error || 'Error'), 'error'); continue; }
              window.umbralAdmin.toast('Subido: ' + data.storedName + ' (' + (data.bytes/1024).toFixed(1) + ' KB)', 'success');
            } catch (err) {
              window.umbralAdmin.toast(file.name + ': ' + err.message, 'error');
            }
          }
          await this.refreshAssets();
        },

        async deleteAsset(name) {
          if (!confirm('¿Borrar ' + name + '?')) return;
          try {
            await window.umbralAdmin.api('DELETE', '/api/assets', { name });
            window.umbralAdmin.toast('Borrado', 'success');
            await this.refreshAssets();
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
        },

        copyToClipboard(text) {
          navigator.clipboard?.writeText(text).then(
            () => window.umbralAdmin.toast('URL copiada', 'success'),
            () => window.umbralAdmin.toast('No se pudo copiar', 'error')
          );
        },

        async checkAllStatus() {
          this.checkingStatus = true;
          this.statusResults = [];
          try {
            const data = await window.umbralAdmin.api('POST', '/api/status', { ids: this.cfg.cards.filter(c=>c.enabled).map(c=>c.id) });
            this.statusResults = data.results || [];
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
          finally { this.checkingStatus = false; }
        },

        async changePassword() {
          if (this.pwForm.next !== this.pwForm.confirm) {
            window.umbralAdmin.toast('Las contraseñas no coinciden', 'error');
            return;
          }
          try {
            const data = await window.umbralAdmin.api('POST', '/api/password', {
              currentPassword: this.pwForm.current,
              newPassword: this.pwForm.next,
            });
            if (data && data.csrfToken) {
              window.umbralAdmin.csrf = data.csrfToken;
              document.body.dataset.csrf = data.csrfToken;
            }
            this.pwForm = { current: '', next: '', confirm: '' };
            window.umbralAdmin.toast('Contraseña cambiada', 'success');
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
        },

        async exportConfig() {
          try {
            const cfg = await window.umbralAdmin.api('GET', '/api/config');
            const blob = new Blob([JSON.stringify(cfg, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `umbral-config-${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            window.umbralAdmin.toast('Exportado', 'success');
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
        },

        async importConfig(e) {
          const file = e.target.files?.[0];
          if (!file) return;
          // Cap defensivo. El server también valida (1MB en middleware), pero
          // un archivo de 100MB en el browser congela la UI y se lleva la RAM.
          const MAX_IMPORT_BYTES = 1024 * 1024;
          if (file.size > MAX_IMPORT_BYTES) {
            window.umbralAdmin.toast(`Archivo demasiado grande (${(file.size/1024).toFixed(0)} KB, máx ${MAX_IMPORT_BYTES/1024} KB)`, 'error');
            e.target.value = ''; return;
          }
          if (!confirm('Importar reemplazará TODA la configuración actual. ¿Continuar?')) {
            e.target.value = ''; return;
          }
          try {
            const text = await file.text();
            const data = JSON.parse(text);
            await window.umbralAdmin.api('PUT', '/api/import', data);
            window.umbralAdmin.toast('Importado. Recargando…', 'success');
            setTimeout(() => location.reload(), 800);
          } catch (err) {
            window.umbralAdmin.toast('Error: ' + err.message, 'error');
          } finally { e.target.value = ''; }
        },

        async resetConfig() {
          const confirmText = prompt('Esto restaurará la configuración a defaults. Escribí RESET para confirmar:');
          if (confirmText !== 'RESET') return;
          try {
            const cfg = await window.umbralAdmin.api('DELETE', '/api/config');
            this.cfg = structuredClone(cfg);
            this.original = structuredClone(cfg);
            this.dirty = false;
            window.umbralAdmin.toast('Reseteado', 'success');
            await this.refreshAssets();
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
        },

        async checkHealth() {
          try {
            this.healthInfo = await window.umbralAdmin.api('GET', '/api/health');
          } catch (e) { window.umbralAdmin.toast(e.message, 'error'); }
        },

        updateFontUrl() {
          const family = (this.cfg.theme.fontFamily || '').trim();
          if (!family || family === 'system-ui') {
            this.cfg.theme.fontUrl = '';
          } else {
            // fontFamily ya está validado por el schema (regex SAFE_FONT_FAMILY),
            // pero encodeamos por las dudas. Sólo espacios → '+'.
            const encoded = family.replace(/ /g, '+');
            this.cfg.theme.fontUrl = `https://fonts.googleapis.com/css2?family=${encoded}:wght@400;500;600;700&display=swap`;
          }
          this.markDirty();
        },

        previewStyle() {
          const t = this.cfg.theme;
          if (t.background.type === 'image') {
            return `background-image:url('${t.background.value}');background-size:cover;${t.background.blur>0?`filter:blur(${t.background.blur}px)`:''}`;
          }
          return `background:${t.background.value};${t.background.blur>0?`filter:blur(${t.background.blur}px)`:''}`;
        },

        resolveIcon(icon) {
          if (!icon) return '';
          if (icon.startsWith('/') || icon.startsWith('http')) return icon;
          if (icon.includes('.')) return '/api/assets/' + icon;
          return '/icons/' + icon + '.svg';
        },
      }));
    });
    Alpine.start();
  </script>

  <style is:inline>
    [x-cloak] { display: none !important; }
    .dirty-badge { color: #fbbf24; font-size: 0.85rem; }
    .muted { color: #94a3b8; font-size: 0.85rem; }
    /* Help icon "?" al lado de cada label avanzado. Inline-block, no afecta
       el flow del label. Hover lo agranda un toque para feedback. */
    .help-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 18px; height: 18px; margin-left: 0.35rem; padding: 0;
      border-radius: 50%; border: 1px solid var(--border);
      background: var(--surface); color: var(--text-muted);
      font-size: 0.7rem; font-weight: 600; line-height: 1;
      cursor: pointer; vertical-align: middle;
      transition: background 0.12s, color 0.12s, transform 0.12s;
    }
    .help-icon:hover { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); transform: scale(1.1); }
    /* Modal de help: ancho cómodo para leer bloques de texto largos. */
    .help-modal { max-width: 640px; max-height: 80vh; overflow-y: auto; }
    .help-body code { background: var(--code-bg); padding: 0.05rem 0.3rem; border-radius: 3px; font-size: 0.85em; }
    .help-body strong { color: var(--text); }
    /* Colores para el resultado del test de IA. */
    .help-ok { color: #10b981; }
    .help-err { color: #f87171; }
    /* System card: la de docs (/docs) no se puede editar ni borrar. */
    .card-item.card-system { opacity: 0.85; }
    .system-badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      padding: 0.2rem 0.55rem; border-radius: 999px;
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text-muted); font-size: 0.72rem; font-weight: 500;
    }
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(0,0,0,0.6);
      display: flex; align-items: center; justify-content: center; z-index: 100;
      padding: 1rem; overflow-y: auto;
    }
    .modal {
      background: #1e293b; border: 1px solid #334155; border-radius: 8px;
      padding: 1.5rem; width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto;
    }
  </style>
</AdminLayout>
