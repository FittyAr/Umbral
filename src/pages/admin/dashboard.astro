---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { getConfig } from '~/lib/config';
import { getAvailableIconNames } from '~/lib/icon-pack-names.ts';
import { AI_PROVIDERS, DEFAULT_AI_SYSTEM_PROMPT, findPresetByBaseUrl } from './ai-providers';
import { getHelpTexts } from '~/i18n/help/index.ts';
import { renderMarkdownSync } from '~/lib/markdown.ts';
import { AI_LANGUAGES, DEFAULT_AI_SYSTEM_PROMPTS } from '~/lib/ai-prompts';
import { FEATURE_META, FEATURE_NAMES, isFeatureEnabled } from '~/lib/features';
import { APP_PRESETS } from '~/lib/presets';
import { PREDEFINED_ICON_PACKS } from '~/lib/icon-packs';
import { BUILTIN_THEME_PRESETS } from '~/lib/theme-presets';
import ThemePanel from '~/components/admin/theme/ThemePanel.astro';
import LayoutPanel from '~/components/admin/layout/LayoutPanel.astro';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';
import AdvancedPanel from '~/components/admin/advanced/AdvancedPanel.astro';
import AiPanel from '~/components/admin/ai/AiPanel.astro';
import AssetsPanel from '~/components/admin/assets/AssetsPanel.astro';
import AuditPanel from '~/components/admin/audit/AuditPanel.astro';
import BrandingPanel from '~/components/admin/branding/BrandingPanel.astro';
import CardsPanel from '~/components/admin/cards/CardsPanel.astro';
import CategoriesPanel from '~/components/admin/categories/CategoriesPanel.astro';
import HardeningPanel from '~/components/admin/hardening/HardeningPanel.astro';
import IconPacksPanel from '~/components/admin/iconpacks/IconPacksPanel.astro';
import MaintenancePanel from '~/components/admin/maintenance/MaintenancePanel.astro';
import MetricsPanel from '~/components/admin/metrics/MetricsPanel.astro';
import OidcPanel from '~/components/admin/oidc/OidcPanel.astro';
import PortalsPanel from '~/components/admin/portals/PortalsPanel.astro';
import SecurityPanel from '~/components/admin/security/SecurityPanel.astro';
import StatusPanel from '~/components/admin/status/StatusPanel.astro';
import TokensPanel from '~/components/admin/tokens/TokensPanel.astro';
import WebhooksPanel from '~/components/admin/webhooks/WebhooksPanel.astro';
import CardEditorModal from '~/components/admin/modals/CardEditorModal.astro';
import HelpModal from '~/components/admin/modals/HelpModal.astro';
import PresetsModal from '~/components/admin/modals/PresetsModal.astro';
import TokenCreatedModal from '~/components/admin/modals/TokenCreatedModal.astro';
import TotpSetupModal from '~/components/admin/modals/TotpSetupModal.astro';

// Modo demo (UMBRAL_DEMO=true en build): el visitor del demo entra directo
// al dashboard. El AdminLayout ya respeta esta flag y forwardea isAuthed=true.
// En producción real, el middleware exige autenticación.
const isDemoBuild = import.meta.env.UMBRAL_DEMO === 'true' || import.meta.env.UMBRAL_DEMO === '1';
const isAuthed = isDemoBuild ? true : (Astro.locals.auth?.isAuthenticated ?? false);
if (!isAuthed) {
  return Astro.redirect('/admin');
}
const csrfToken = isDemoBuild ? 'demo-csrf-token' : (Astro.locals.auth?.csrfToken ?? '');
const config = await getConfig();
const availableIcons = await getAvailableIconNames();

// i18n del admin: traducimos títulos de tabs y la sección Features.
// Si la feature i18n está apagada, defaults históricos en español.
const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = t(locale);

const helpCatalog = getHelpTexts(locale);
const HELP_TEXTS = Object.fromEntries(
  Object.entries(helpCatalog).map(([key, val]) => [
    key,
    {
      title: val.title,
      short: val.short,
      bodyHtml: renderMarkdownSync(val.body),
    },
  ]),
);

// Metadata de features para la UI del tab Avanzado. Cada item tiene label,
// short, body, wave, experimental y deps — la sección "Features" lo lee
// directo para renderizar los switches. Lo serializamos con `enabled`
// calculado server-side para que el form muestre el estado actual apenas
// carga (sin esperar a que Alpine se hidrate).
const FEATURE_LIST = FEATURE_NAMES.map((name) => ({
  name,
  label: FEATURE_META[name].label,
  short: FEATURE_META[name].short,
  body: FEATURE_META[name].body,
  wave: FEATURE_META[name].wave,
  experimental: FEATURE_META[name].experimental,
  deps: FEATURE_META[name].deps ?? [],
  enabled: isFeatureEnabled(config, name),
}));

const THEME_PRESET_I18N = {
  variantDark: trf('admin.theme.preset.variant.dark'),
  variantLight: trf('admin.theme.preset.variant.light'),
  applyCustom: trf('admin.theme.preset.apply'),
  names: Object.fromEntries(BUILTIN_THEME_PRESETS.map((p) => [p.id, trf(p.nameKey)])),
  descs: Object.fromEntries(BUILTIN_THEME_PRESETS.map((p) => [p.id, trf(p.descriptionKey)])),
};
---
<AdminLayout title="Dashboard" csrfToken={csrfToken} isAuthed={true}>
  <div class="admin-wrap">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h1 style="margin:0;font-size:1.4rem">{useI18n ? trf('admin.dashboard.title') : 'Panel de configuración'}</h1>
    </div>

    <div class="tabs">
      <button class="tab" :class="tab==='branding' && 'active'" @click="tab='branding'" x-text="tabBranding()">Branding</button>
      <button class="tab" :class="tab==='theme' && 'active'" @click="tab='theme'" x-text="tabTheme()">Tema</button>
      <button class="tab" :class="tab==='layout' && 'active'" @click="tab='layout'" x-text="tabLayout()">Layout</button>
      <button class="tab" :class="tab==='categories' && 'active'" @click="tab='categories'" x-text="tabCategories()">Categorías</button>
      <button class="tab" :class="tab==='cards' && 'active'" @click="tab='cards'" x-text="tabCards()">Tarjetas</button>
      <button class="tab" :class="tab==='assets' && 'active'" @click="tab='assets'" x-text="tabAssets()">Assets</button>
      <button class="tab" :class="tab==='hardening' && 'active'" @click="tab='hardening'" x-text="tabHardening()">Hardening</button>
      <button class="tab" :class="tab==='security' && 'active'" @click="tab='security'" x-text="tabPassword()">Password</button>

      <!-- FEATURE TABS (pestañas independientes cuando la feature está habilitada) -->
      <button class="tab" x-show="isFeatureOn('status')" x-cloak :class="tab==='status' && 'active'" @click="tab='status'" x-text="tabStatus()">Status</button>
      <button class="tab" x-show="isFeatureOn('ai')" x-cloak :class="tab==='ai' && 'active'" @click="tab='ai'" x-text="tabAi()">IA</button>
      <button class="tab" x-show="isFeatureOn('webhooks')" x-cloak :class="tab==='webhooks' && 'active'" @click="tab='webhooks'" x-text="tabWebhooks()">Webhooks</button>
      <button class="tab" x-show="isFeatureOn('maintenanceWindows')" x-cloak :class="tab==='maintenance' && 'active'" @click="tab='maintenance'" x-text="tabMaintenance()">Mantenimiento</button>
      <button class="tab" x-show="isFeatureOn('auditLogViewer')" x-cloak :class="tab==='audit' && 'active'" @click="tab='audit'" x-text="tabAudit()">Auditoría</button>
      <button class="tab" x-show="isFeatureOn('metrics')" x-cloak :class="tab==='metrics' && 'active'" @click="tab='metrics'" x-text="tabMetrics()">Métricas</button>
      <button class="tab" x-show="isFeatureOn('oidc')" x-cloak :class="tab==='oidc' && 'active'" @click="tab='oidc'" x-text="tabOidc()">OIDC / SSO</button>
      <button class="tab" x-show="isFeatureOn('apiTokens')" x-cloak :class="tab==='tokens' && 'active'" @click="tab='tokens'" x-text="tabTokens()">Tokens API</button>
      <button class="tab" x-show="isFeatureOn('multiPortal')" x-cloak :class="tab==='portals' && 'active'" @click="tab='portals'" x-text="tabPortals()">Multi-Portal</button>
      <button class="tab" x-show="isFeatureOn('iconPacks')" x-cloak :class="tab==='iconpacks' && 'active'" @click="tab='iconpacks'; loadIconPacks()" x-text="tabIconPacks()">Íconos Git</button>

      <button class="tab" :class="tab==='advanced' && 'active'" @click="tab='advanced'" x-text="tabAdvanced()">Avanzado</button>
    </div>

    <!-- Un panel por tab. Cada uno lleva su propio `:class="tab==='x'"`, así
         que el orden acá es sólo el orden de los tabs en la barra. Los que
         dependen de una feature se esconden desde el binding del panel. -->
    <BrandingPanel useI18n={useI18n} tr={trf} />
    <ThemePanel useI18n={useI18n} tr={trf} />
    <LayoutPanel useI18n={useI18n} tr={trf} />
    <CategoriesPanel useI18n={useI18n} tr={trf} />
    <CardsPanel useI18n={useI18n} tr={trf} />
    <AssetsPanel useI18n={useI18n} tr={trf} />
    <StatusPanel useI18n={useI18n} tr={trf} />
    <HardeningPanel useI18n={useI18n} tr={trf} />
    <!-- El tab "Password" es el panel de seguridad: password + multi-usuario. -->
    <SecurityPanel useI18n={useI18n} tr={trf} />
    <AiPanel useI18n={useI18n} tr={trf} />
    <WebhooksPanel useI18n={useI18n} tr={trf} />
    <MaintenancePanel useI18n={useI18n} tr={trf} />
    <AuditPanel useI18n={useI18n} tr={trf} />
    <MetricsPanel useI18n={useI18n} tr={trf} />
    <OidcPanel useI18n={useI18n} tr={trf} />
    <TokensPanel useI18n={useI18n} tr={trf} />
    <PortalsPanel useI18n={useI18n} tr={trf} />
    <IconPacksPanel useI18n={useI18n} tr={trf} />
    <AdvancedPanel useI18n={useI18n} tr={trf} />

    <!-- Modales. Cada uno se abre solo, con su propio `template x-if` contra el
         estado de Alpine, así que acá no hay condición ni orden que importe. -->
    <CardEditorModal useI18n={useI18n} tr={trf} />
    <HelpModal useI18n={useI18n} tr={trf} />
    <PresetsModal useI18n={useI18n} tr={trf} />
    <TotpSetupModal useI18n={useI18n} tr={trf} />
    <TokenCreatedModal useI18n={useI18n} tr={trf} />
  </div>

  <!-- Alpine.js + Sortable + dashboard logic -->
  <script is:inline define:vars={{ initialConfig: config, availableIcons, appPresets: APP_PRESETS, predefinedIconPacks: PREDEFINED_ICON_PACKS, builtinThemePresets: BUILTIN_THEME_PRESETS, themePresetI18n: THEME_PRESET_I18N, AI_PROVIDERS, DEFAULT_AI_SYSTEM_PROMPT, HELP_TEXTS, AI_LANGUAGES, DEFAULT_AI_SYSTEM_PROMPTS, FEATURE_LIST, I18N: useI18n ? { dirty: trf('admin.dashboard.dirty'), reload: trf('admin.dashboard.reload'), save: trf('admin.dashboard.save'), saving: trf('admin.dashboard.saving'), saved: trf('admin.dashboard.saved'), savedClamped: trf('admin.dashboard.savedClamped'), reloaded: trf('admin.dashboard.reloaded'), error: trf('admin.dashboard.error'), tabs: { branding: trf('admin.tab.branding'), theme: trf('admin.tab.theme'), layout: trf('admin.tab.layout'), categories: trf('admin.tab.categories'), cards: trf('admin.tab.cards'), assets: trf('admin.tab.assets'), status: trf('admin.tab.status'), hardening: trf('admin.tab.hardening'), password: trf('admin.tab.password'), ai: trf('admin.tab.ai'), webhooks: trf('admin.tab.webhooks'), maintenance: trf('admin.tab.maintenance'), audit: trf('admin.tab.audit'), metrics: trf('admin.tab.metrics'), oidc: trf('admin.tab.oidc'), tokens: trf('admin.tab.tokens'), portals: trf('admin.tab.portals'), iconPacks: trf('admin.tab.iconPacks'), advanced: trf('admin.tab.advanced'), }, featuresTitle: trf('admin.features.title'), featuresIntro: trf('admin.features.intro'), webhooks: { title: trf('admin.webhooks.title'), intro: trf('admin.webhooks.intro'), add: trf('admin.webhooks.add'), testNew: trf('admin.webhooks.testNew'), }, maintenance: { title: trf('admin.maintenance.title'), intro: trf('admin.maintenance.intro'), add: trf('admin.maintenance.add'), }, audit: { title: trf('admin.audit.title'), reset: trf('admin.audit.reset'), download: trf('admin.audit.download'), loading: trf('admin.audit.loading'), empty: trf('admin.audit.empty'), downloadError: trf('admin.audit.downloadError'), }, metrics: { title: trf('admin.metrics.title'), intro: trf('admin.metrics.intro'), reload: trf('admin.metrics.reload'), loading: trf('admin.metrics.loading'), }, users: { intro: trf('admin.users.intro'), accessModeHelp: trf('admin.users.accessModeHelp'), }, card: { markdown: trf('admin.card.markdown'), refreshPreview: trf('admin.card.refreshPreview'), previewLabel: trf('admin.card.previewLabel'), tags: trf('admin.card.tags'), tagsPlaceholder: trf('admin.card.tagsPlaceholder'), tagsHelp: trf('admin.card.tagsHelp'), tagsAdd: trf('admin.card.tagsAdd'), pinned: trf('admin.card.pinned'), span: trf('admin.card.span'), spanSingle: trf('admin.card.spanSingle'), spanMultiple: trf('admin.card.spanMultiple'), spanHint: trf('admin.card.spanHint'), }, help: { tooltip: trf('admin.help.tooltip'), }, iconPicker: { noPacks: trf('admin.iconPicker.emptyNoPacks'), featureOff: trf('admin.iconPicker.emptyFeatureOff'), goIconPacks: trf('admin.iconPicker.goIconPacks'), goFeatures: trf('admin.iconPicker.goFeatures'), }, theme: { title: trf('admin.theme.title'), sectionPresets: trf('admin.theme.section.presets'), sectionBackground: trf('admin.theme.section.background'), sectionColors: trf('admin.theme.section.colors'), sectionTypography: trf('admin.theme.section.typography'), sectionCards: trf('admin.theme.section.cards'), sectionWidgets: trf('admin.theme.section.widgets'), sectionAnimations: trf('admin.theme.section.animations'), animationsIntro: trf('admin.theme.animations.intro'), cardEntrance: trf('admin.theme.animations.cardEntrance'), cardEntranceDuration: trf('admin.theme.animations.cardEntranceDuration'), cardEntranceStagger: trf('admin.theme.animations.cardEntranceStagger'), categoryEntrance: trf('admin.theme.animations.categoryEntrance'), entranceEasing: trf('admin.theme.animations.entranceEasing'), entranceTrigger: trf('admin.theme.animations.entranceTrigger'), entranceDistance: trf('admin.theme.animations.entranceDistance'), cardHover: trf('admin.theme.animations.cardHover'), hoverDuration: trf('admin.theme.animations.hoverDuration'), headerEffect: trf('admin.theme.animations.headerEffect'), titleTypewriter: trf('admin.theme.animations.titleTypewriter'), counters: trf('admin.theme.animations.counters'), respectReducedMotion: trf('admin.theme.animations.respectReducedMotion'), sectionAdvanced: trf('admin.theme.section.advanced'), presetsIntro: trf('admin.theme.presets.intro'), saveCustomPreset: trf('admin.theme.preset.saveCustom'), resetDefaults: trf('admin.theme.preset.reset'), previewTitle: trf('admin.theme.preview.title'), openPreviewTab: trf('admin.theme.preview.openTab'), gradientBuilder: trf('admin.theme.background.gradientBuilder'), advancedCss: trf('admin.theme.background.advancedCss'), widgetsIntro: trf('admin.theme.widgets.intro'), advancedIntro: trf('admin.theme.advanced.intro'), deriveAccent: trf('admin.theme.advanced.deriveAccent'), exportTheme: trf('admin.theme.advanced.export'), importTheme: trf('admin.theme.advanced.import'), tokenSearchPlaceholder: trf('admin.theme.advanced.tokenSearch'), presetApplied: trf('admin.theme.preset.applied'), presetSaved: trf('admin.theme.preset.saved'), themeImported: trf('admin.theme.advanced.imported'), themeExported: trf('admin.theme.advanced.exported'), }, layout: { title: trf('admin.layout.title'), sectionGrid: trf('admin.layout.section.grid'), sectionCards: trf('admin.layout.section.cards'), sectionBehavior: trf('admin.layout.section.behavior'), breakpointDesktop: trf('admin.layout.breakpoint.desktop'), breakpointTablet: trf('admin.layout.breakpoint.tablet'), breakpointMobile: trf('admin.layout.breakpoint.mobile'), columnsDesktop: trf('admin.layout.columnsDesktop'), columnsTablet: trf('admin.layout.columnsTablet'), columnsMobile: trf('admin.layout.columnsMobile'), gap: trf('admin.layout.gap'), categoryGap: trf('admin.layout.categoryGap'), ghostCategoryGap: trf('admin.layout.ghostCategoryGap'), maxWidth: trf('admin.layout.maxWidth'), gridAlign: trf('admin.layout.gridAlign'), gridAlignCenter: trf('admin.layout.gridAlign.center'), gridAlignLeft: trf('admin.layout.gridAlign.left'), cardSize: trf('admin.layout.cardSize'), cardRadius: trf('admin.layout.cardRadius'), showDescriptions: trf('admin.layout.showDescriptions'), compact: trf('admin.layout.compact'), healthCheckInterval: trf('admin.layout.healthCheckInterval'), healthCheckHint: trf('admin.layout.healthCheckHint'), previewTitle: trf('admin.layout.preview.title'), previewMobile: trf('admin.layout.preview.mobile'), previewTablet: trf('admin.layout.preview.tablet'), previewDesktop: trf('admin.layout.preview.desktop'), }, cards: { filterPlaceholder: trf('admin.cards.filterPlaceholder'), new: trf('admin.cards.new'), fromPreset: trf('admin.cards.fromPreset'), filterDragDisabled: trf('admin.cards.filterDragDisabled'), orphanGroup: trf('admin.cards.orphanGroup'), ungroupedGroup: trf('admin.cards.ungroupedGroup'), ungroupedGap: trf('admin.cards.ungroupedGap'), noteBadge: trf('admin.cards.noteBadge'), expandGroup: trf('admin.cards.expandGroup'), collapseGroup: trf('admin.cards.collapseGroup'), addToGroup: trf('admin.cards.addToGroup'), dragHandle: trf('admin.cards.dragHandle'), untitled: trf('admin.cards.untitled'), categorySelect: trf('admin.cards.categorySelect'), enabled: trf('admin.cards.enabled'), edit: trf('admin.cards.edit'), delete: trf('admin.cards.delete'), systemBadge: trf('admin.cards.systemBadge'), systemBadgeTitle: trf('admin.cards.systemBadgeTitle'), groupEmpty: trf('admin.cards.groupEmpty'), emptyState: trf('admin.cards.emptyState'), }, } : null }}>
    // Mirror trustedProxies (array) into a text form so the textarea can edit it.
    initialConfig.security.network.trustedProxiesText = (initialConfig.security.network.trustedProxies || []).join('\n');
    // Si el config legacy no tiene `features`, lo inicializamos como objeto
    // vacío (cada feature tendrá default {enabled:false} al renderizar).
    if (!initialConfig.features) initialConfig.features = {};
    if (!initialConfig.oidc) initialConfig.oidc = { providers: [] };
    if (!initialConfig.apiTokens) initialConfig.apiTokens = { items: [] };
    if (!initialConfig.portals) initialConfig.portals = { defaultPortal: 'default', items: [] };
    // expose config to adminApp data
    window.__initialConfig = initialConfig;
    window.__availableIcons = availableIcons;
    window.__appPresets = appPresets;
    window.__predefinedIconPacks = predefinedIconPacks;
    window.__aiProviders = AI_PROVIDERS;
    window.__defaultAiSystemPrompt = DEFAULT_AI_SYSTEM_PROMPT;
    window.__helpTexts = HELP_TEXTS;
    window.__aiLanguages = AI_LANGUAGES;
    window.__defaultAiSystemPrompts = DEFAULT_AI_SYSTEM_PROMPTS;
    window.__featureList = FEATURE_LIST;
    window.__builtinThemePresets = builtinThemePresets;
    window.__themePresetI18n = themePresetI18n;
    window.__i18n = I18N;
  </script>
  <script>
    import Alpine from 'alpinejs';
    import Sortable from 'sortablejs';
    import { installSortableGuard } from '~/lib/sortable-guard';
    import * as themeClient from '~/lib/theme-admin-client';
    import * as layoutClient from '~/lib/layout-admin-client';
    import {
      cardGroups as buildCardGroups,
      adminCardsLayout as buildAdminCardsLayout,
      moveCardToCategory,
      moveCardToUngrouped,
      syncOrderFromDom,
      realCategories as filterRealCategories,
      reorderRealCategories,
      createGhostCategory,
      ORPHAN_CATEGORY_ID,
      GAP_CATEGORY_ID,
      UNGROUPED_SELECT_ID,
    } from '~/lib/cards-admin';
    import { isSystemCard as checkSystemCard, restoreSystemCardProtectedFields, SYSTEM_DOCS_ICON, SYSTEM_DOCS_ICON_PATH } from '~/lib/system-card';
    import { clampCardSpan, MAX_CARD_SPAN } from '~/lib/card-span';
    import { createInstalledIconLookup } from '~/lib/icon-url';
    import { applyThemePreset, getBuiltinPreset, getPresetVariant } from '~/lib/theme-presets';
    import { mergeThemePartial, deriveTokensFromAccent, TOKEN_KEY_MAP, applyThemePartialInPlace, replaceThemeInPlace, computeThemeVars, contrastRatio, colorToHexApprox } from '~/lib/theme-tokens';
    installSortableGuard(Sortable);
    window.Alpine = Alpine;
    window.Sortable = Sortable;
    window.__themeClient = themeClient;
    window.__layoutClient = layoutClient;
    window.__mergeThemePartial = mergeThemePartial;
    window.__applyThemePartialInPlace = applyThemePartialInPlace;
    window.__replaceThemeInPlace = replaceThemeInPlace;
    window.__deriveTokensFromAccent = deriveTokensFromAccent;
    window.__TOKEN_KEY_MAP = TOKEN_KEY_MAP;
    window.__applyThemePreset = applyThemePreset;
    window.__getBuiltinPreset = getBuiltinPreset;
    window.__getPresetVariant = getPresetVariant;
    window.__computeThemeVars = computeThemeVars;
    window.__contrastRatio = contrastRatio;
    window.__colorToHexApprox = colorToHexApprox;

    Alpine.data('adminApp', () => ({
        tab: 'cards',
        themeSection: 'presets',
        layoutBreakpoint: 'desktop',
        layoutPreviewViewport: 'desktop',
        collapsedCardGroups: {},
        _cardSortables: [],
        _cardsDragging: false,
        _cardsDragLayout: null,
        ungroupedSelectId: UNGROUPED_SELECT_ID,
        ungroupedGapId: GAP_CATEGORY_ID,
        themePreviewMode: 'auto',
        themePreviewRev: 0,
        themeAdvancedMode: 'dark',
        themeBgEditMode: 'dark',
        themeTextEditMode: 'dark',
        themeUseAdvancedCss: false,
        themeGradientAngle: 135,
        themeGradientStops: [
          { color: '#0f172a', pos: 0 },
          { color: '#1e3a8a', pos: 50 },
          { color: '#0f172a', pos: 100 },
        ],
        themeTokenSearch: '',
        cfg: window.__initialConfig || null,
        original: null,
        dirty: false,
        busy: false,
        assets: [],
        uploadKind: 'icon',
        uploaderDragover: false,
        cardFilter: '',
        editingCard: null,
        editingIndex: -1,
        // Markdown (opt-in: features.markdown). El toggle aparece en el
        // form sólo si la feature está activa. descriptionFormat default
        // a 'plain' para cards nuevos; el user puede flippearlo.
        markdownEnabled: window.__featureList?.find?.((f) => f.name === 'markdown')?.enabled === true,
        // isDemoMode: el build se hizo con UMBRAL_DEMO=true (GitHub Pages).
        // Lo usamos para condicionar UI: el switch de QR queda bloqueado
        // (porque requiere el backend Node) y se muestra un banner
        // explicativo al lado de la feature.
        isDemoMode: typeof window !== 'undefined' && window.__UMBRAL_DEMO__ === true,
        markdownPreview: '',
        markdownPreviewDirty: true,
        // i18n methods (Alpine 3: se llaman con `()` en el HTML)
        markdownLabel() { return this.i18n?.card?.markdown || 'Markdown'; },
        refreshPreviewLabel() { return this.i18n?.card?.refreshPreview || 'Refresh preview'; },
        previewLabel() { return this.i18n?.card?.previewLabel || 'Preview'; },
        editingKey: 0,
        cardFormDirty: false,
        autofillBusy: false,
        aiBusy: false,
        aiTestResult: '',
        aiTestOk: false,
        statusResults: [],
        checkingStatus: false,
        healthInfo: null,
        selectedAsset: null,
        availableIcons: window.__availableIcons || [],
        iconPickerSearch: '',
        iconPickerPack: 'all',
        iconPickerLimit: 120,
        iconPickerTab: 'icons',

        resetIconPicker() {
          this.iconPickerSearch = '';
          this.iconPickerPack = 'all';
          this.iconPickerLimit = 120;
          this.iconPickerTab = 'icons';
        },

        async refreshIconCatalog() {
          if (!this.isFeatureOn('iconPacks')) return;
          try {
            const res = await window.umbralAdmin.api('GET', '/api/icon-packs');
            if (res.availableIcons) {
              this.availableIcons = res.availableIcons;
            }
          } catch {
            // usar catálogo en caché
          }
        },

        async prepareCardEditor() {
          this.resetIconPicker();
          await Promise.all([
            this.refreshIconCatalog(),
            this.assets.length === 0 ? this.refreshAssets() : Promise.resolve(),
          ]);
        },

        iconPickerPacks() {
          const packs = new Set();
          for (const i of this.availableIcons) {
            const slash = i.indexOf('/');
            if (slash > 0) packs.add(i.slice(0, slash));
          }
          return [...packs].sort();
        },

        iconPickerPackOptions() {
          return this.iconPickerPacks();
        },

        filteredIconPickerIcons() {
          let list = this.availableIcons;
          if (this.iconPickerPack !== 'all') {
            list = list.filter((i) => i.startsWith(this.iconPickerPack + '/'));
          }
          const q = this.iconPickerSearch.toLowerCase().trim();
          if (q) list = list.filter((i) => i.toLowerCase().includes(q));
          return list;
        },

        visibleIconPickerIcons() {
