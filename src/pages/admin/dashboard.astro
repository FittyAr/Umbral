          const pass = this.i18n?.theme?.contrastPass || 'AA ✓';
          const fail = this.i18n?.theme?.contrastFail || 'Bajo contraste';
          const label = ratio >= 4.5 ? pass : fail;
          return `${ratio.toFixed(1)}:1 · ${label}`;
