        updateFontUrl() {
          const t = this.cfg.theme;
          if (t.useGoogleFonts && t.fontFamily && t.fontFamily !== 'system-ui') {
            t.fontUrl = window.__themeClient.googleFontUrl(t.fontFamily, t.fontWeight || '400');
          } else {
            t.fontUrl = '';
          }
          this.markDirty();
