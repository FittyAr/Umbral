    window.__getBuiltinPreset = getBuiltinPreset;
    window.__getPresetVariant = getPresetVariant;
    window.__computeThemeVars = computeThemeVars;
    window.__contrastRatio = contrastRatio;
    window.__colorToHexApprox = colorToHexApprox;

    Alpine.data('adminApp', () => ({
        tab: 'cards',
        themeSection: 'presets',
        themePreviewMode: 'auto',
        themePreviewRev: 0,
        themeAdvancedMode: 'dark',
        themeBgEditMode: 'dark',
        themeTextEditMode: 'dark',
        themeUseAdvancedCss: false,
        themeGradientAngle: 135,
        themeGradientStops: [
          { color: '#0f172a', pos: 0 },
          { color: '#1e3a8a', pos: 50 },
          { color: '#0f172a', pos: 100 },
        ],
        themeTokenSearch: '',
        cfg: window.__initialConfig || null,
        original: null,
        dirty: false,
        busy: false,
        assets: [],
        uploadKind: 'icon',
        uploaderDragover: false,
        cardFilter: '',
        editingCard: null,
        editingIndex: -1,
        // Markdown (opt-in: features.markdown). El toggle aparece en el
        // form sólo si la feature está activa. descriptionFormat default
        // a 'plain' para cards nuevos; el user puede flippearlo.
        markdownEnabled: window.__featureList?.find?.((f) => f.name === 'markdown')?.enabled === true,
        // isDemoMode: el build se hizo con UMBRAL_DEMO=true (GitHub Pages).
        // Lo usamos para condicionar UI: el switch de QR queda bloqueado
        // (porque requiere el backend Node) y se muestra un banner
        // explicativo al lado de la feature.
        isDemoMode: typeof window !== 'undefined' && window.__UMBRAL_DEMO__ === true,
        markdownPreview: '',
        markdownPreviewDirty: true,
        // i18n methods (Alpine 3: se llaman con `()` en el HTML)
        markdownLabel() { return this.i18n?.card?.markdown || 'Markdown'; },
        refreshPreviewLabel() { return this.i18n?.card?.refreshPreview || 'Refresh preview'; },
        previewLabel() { return this.i18n?.card?.previewLabel || 'Preview'; },
        editingKey: 0,
        cardFormDirty: false,
        autofillBusy: false,
        aiBusy: false,
        aiTestResult: '',
