        applyThemePresetById(id, variant = 'dark') {
          const builtin = window.__getBuiltinPreset?.(id);
          const custom = (this.cfg.theme.customPresets || []).find((p) => p.id === id);
          if (custom) {
            window.__applyThemePartialInPlace(this.cfg.theme, custom.theme);
          } else if (builtin) {
            window.__applyThemePartialInPlace(this.cfg.theme, { ...builtin.theme, colorMode: variant });
          } else return;
          if (!custom) this.themePreviewMode = variant;
