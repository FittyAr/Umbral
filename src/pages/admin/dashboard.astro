---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { getConfig } from '~/lib/config';
import { getAvailableIconNames } from '~/lib/icon-pack-names.ts';
import { FEATURE_META, FEATURE_NAMES, isFeatureEnabled } from '~/lib/features';
import { ADMIN_LABELS } from '~/lib/admin-labels';
import { BUILTIN_THEME_PRESETS } from '~/lib/theme-presets';
import ThemePanel from '~/components/admin/theme/ThemePanel.astro';
import LayoutPanel from '~/components/admin/layout/LayoutPanel.astro';
import { t, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';
import AdvancedPanel from '~/components/admin/advanced/AdvancedPanel.astro';
import AiPanel from '~/components/admin/ai/AiPanel.astro';
import AssetsPanel from '~/components/admin/assets/AssetsPanel.astro';
import AuditPanel from '~/components/admin/audit/AuditPanel.astro';
import BrandingPanel from '~/components/admin/branding/BrandingPanel.astro';
import CardsPanel from '~/components/admin/cards/CardsPanel.astro';
import CategoriesPanel from '~/components/admin/categories/CategoriesPanel.astro';
import HardeningPanel from '~/components/admin/hardening/HardeningPanel.astro';
import IconPacksPanel from '~/components/admin/iconpacks/IconPacksPanel.astro';
import MaintenancePanel from '~/components/admin/maintenance/MaintenancePanel.astro';
import MetricsPanel from '~/components/admin/metrics/MetricsPanel.astro';
import OidcPanel from '~/components/admin/oidc/OidcPanel.astro';
import PortalsPanel from '~/components/admin/portals/PortalsPanel.astro';
import SecurityPanel from '~/components/admin/security/SecurityPanel.astro';
import StatusPanel from '~/components/admin/status/StatusPanel.astro';
import TokensPanel from '~/components/admin/tokens/TokensPanel.astro';
import WebhooksPanel from '~/components/admin/webhooks/WebhooksPanel.astro';
import CardEditorModal from '~/components/admin/modals/CardEditorModal.astro';
import HelpModal from '~/components/admin/modals/HelpModal.astro';
import PresetsModal from '~/components/admin/modals/PresetsModal.astro';
import TokenCreatedModal from '~/components/admin/modals/TokenCreatedModal.astro';
import TotpSetupModal from '~/components/admin/modals/TotpSetupModal.astro';

// Modo demo (UMBRAL_DEMO=true en build): el visitor del demo entra directo
// al dashboard. El AdminLayout ya respeta esta flag y forwardea isAuthed=true.
// En producción real, el middleware exige autenticación.
const isDemoBuild = import.meta.env.UMBRAL_DEMO === 'true' || import.meta.env.UMBRAL_DEMO === '1';
const isAuthed = isDemoBuild ? true : (Astro.locals.auth?.isAuthenticated ?? false);
if (!isAuthed) {
  return Astro.redirect('/admin');
}
const csrfToken = isDemoBuild ? 'demo-csrf-token' : (Astro.locals.auth?.csrfToken ?? '');
const config = await getConfig();
// El dashboard sólo necesita `auth.users` y `auth.singlePasswordEnabled` para
// el panel de usuarios; el hash del super-admin y el CSRF de la config no
// tienen razón de estar en el HTML. `saveConfig` ignora ambos campos en un
// PUT, así que sacarlos no rompe el round-trip del formulario.
const clientConfig = {
  ...config,
  auth: {
    users: config.auth?.users ?? [],
    singlePasswordEnabled: config.auth?.singlePasswordEnabled ?? true,
  },
};
// El catálogo de íconos se pide a `/api/icon-names` cuando el admin arranca.
// El build estático del demo no tiene ese endpoint, así que ahí (y sólo ahí)
// sigue viajando inline.
const demoAvailableIcons = isDemoBuild ? await getAvailableIconNames() : null;
// i18n del admin: traducimos títulos de tabs y la sección Features.
// Si la feature i18n está apagada, defaults históricos en español.
const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = t(locale);

// Metadata de features para la UI del tab Avanzado. Cada item tiene label,
// short, body, wave, experimental y deps — la sección "Features" lo lee
// directo para renderizar los switches. Lo serializamos con `enabled`
// calculado server-side para que el form muestre el estado actual apenas
// carga (sin esperar a que Alpine se hidrate).
const FEATURE_LIST = FEATURE_NAMES.map((name) => ({
  name,
  label: FEATURE_META[name].label,
  short: FEATURE_META[name].short,
  body: FEATURE_META[name].body,
  wave: FEATURE_META[name].wave,
  experimental: FEATURE_META[name].experimental,
  deps: FEATURE_META[name].deps ?? [],
  enabled: isFeatureEnabled(config, name),
}));

// Los labels del cliente: sólo los textos traducidos, resueltos desde la tabla
// única de `admin-labels.ts`. Si la feature i18n está apagada, no se emite
// nada y cada label cae a su texto en español.
const I18N_LABELS = useI18n
  ? Object.fromEntries(Object.entries(ADMIN_LABELS).map(([name, [key]]) => [name, trf(key)]))
  : null;

const THEME_PRESET_I18N = {
  variantDark: trf('admin.theme.preset.variant.dark'),
  variantLight: trf('admin.theme.preset.variant.light'),
  applyCustom: trf('admin.theme.preset.apply'),
  names: Object.fromEntries(BUILTIN_THEME_PRESETS.map((p) => [p.id, trf(p.nameKey)])),
  descs: Object.fromEntries(BUILTIN_THEME_PRESETS.map((p) => [p.id, trf(p.descriptionKey)])),
};
---
<AdminLayout title="Dashboard" csrfToken={csrfToken} isAuthed={true}>
  <div class="admin-wrap">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h1 style="margin:0;font-size:1.4rem">{useI18n ? trf('admin.dashboard.title') : 'Panel de configuración'}</h1>
    </div>

    <div class="tabs">
      <button class="tab" :class="tab==='branding' && 'active'" @click="tab='branding'" x-text="tabBranding()">Branding</button>
      <button class="tab" :class="tab==='theme' && 'active'" @click="tab='theme'" x-text="tabTheme()">Tema</button>
      <button class="tab" :class="tab==='layout' && 'active'" @click="tab='layout'" x-text="tabLayout()">Layout</button>
      <button class="tab" :class="tab==='categories' && 'active'" @click="tab='categories'" x-text="tabCategories()">Categorías</button>
      <button class="tab" :class="tab==='cards' && 'active'" @click="tab='cards'" x-text="tabCards()">Tarjetas</button>
      <button class="tab" :class="tab==='assets' && 'active'" @click="tab='assets'" x-text="tabAssets()">Assets</button>
      <button class="tab" :class="tab==='hardening' && 'active'" @click="tab='hardening'" x-text="tabHardening()">Hardening</button>
      <button class="tab" :class="tab==='security' && 'active'" @click="tab='security'" x-text="tabPassword()">Password</button>

      <!-- FEATURE TABS (pestañas independientes cuando la feature está habilitada) -->
      <button class="tab" x-show="isFeatureOn('status')" x-cloak :class="tab==='status' && 'active'" @click="tab='status'" x-text="tabStatus()">Status</button>
      <button class="tab" x-show="isFeatureOn('ai')" x-cloak :class="tab==='ai' && 'active'" @click="tab='ai'" x-text="tabAi()">IA</button>
      <button class="tab" x-show="isFeatureOn('webhooks')" x-cloak :class="tab==='webhooks' && 'active'" @click="tab='webhooks'" x-text="tabWebhooks()">Webhooks</button>
      <button class="tab" x-show="isFeatureOn('maintenanceWindows')" x-cloak :class="tab==='maintenance' && 'active'" @click="tab='maintenance'" x-text="tabMaintenance()">Mantenimiento</button>
      <button class="tab" x-show="isFeatureOn('auditLogViewer')" x-cloak :class="tab==='audit' && 'active'" @click="tab='audit'" x-text="tabAudit()">Auditoría</button>
      <button class="tab" x-show="isFeatureOn('metrics')" x-cloak :class="tab==='metrics' && 'active'" @click="tab='metrics'" x-text="tabMetrics()">Métricas</button>
      <button class="tab" x-show="isFeatureOn('oidc')" x-cloak :class="tab==='oidc' && 'active'" @click="tab='oidc'" x-text="tabOidc()">OIDC / SSO</button>
      <button class="tab" x-show="isFeatureOn('apiTokens')" x-cloak :class="tab==='tokens' && 'active'" @click="tab='tokens'" x-text="tabTokens()">Tokens API</button>
      <button class="tab" x-show="isFeatureOn('multiPortal')" x-cloak :class="tab==='portals' && 'active'" @click="tab='portals'" x-text="tabPortals()">Multi-Portal</button>
      <button class="tab" x-show="isFeatureOn('iconPacks')" x-cloak :class="tab==='iconpacks' && 'active'" @click="tab='iconpacks'; loadIconPacks()" x-text="tabIconPacks()">Íconos Git</button>

      <button class="tab" :class="tab==='advanced' && 'active'" @click="tab='advanced'" x-text="tabAdvanced()">Avanzado</button>
    </div>

    <!-- Un panel por tab. Cada uno lleva su propio `:class="tab==='x'"`, así
         que el orden acá es sólo el orden de los tabs en la barra. Los que
         dependen de una feature se esconden desde el binding del panel. -->
    <BrandingPanel useI18n={useI18n} tr={trf} />
    <ThemePanel useI18n={useI18n} tr={trf} />
    <LayoutPanel useI18n={useI18n} tr={trf} />
    <CategoriesPanel useI18n={useI18n} tr={trf} />
    <CardsPanel useI18n={useI18n} tr={trf} />
    <AssetsPanel useI18n={useI18n} tr={trf} />
    <StatusPanel useI18n={useI18n} tr={trf} />
    <HardeningPanel useI18n={useI18n} tr={trf} />
    <!-- El tab "Password" es el panel de seguridad: password + multi-usuario. -->
    <SecurityPanel useI18n={useI18n} tr={trf} />
    <AiPanel useI18n={useI18n} tr={trf} />
    <WebhooksPanel useI18n={useI18n} tr={trf} />
    <MaintenancePanel useI18n={useI18n} tr={trf} />
    <AuditPanel useI18n={useI18n} tr={trf} />
    <MetricsPanel useI18n={useI18n} tr={trf} />
    <OidcPanel useI18n={useI18n} tr={trf} />
    <TokensPanel useI18n={useI18n} tr={trf} />
    <PortalsPanel useI18n={useI18n} tr={trf} />
    <IconPacksPanel useI18n={useI18n} tr={trf} />
    <AdvancedPanel useI18n={useI18n} tr={trf} />

    <!-- Modales. Cada uno se abre solo, con su propio `template x-if` contra el
         estado de Alpine, así que acá no hay condición ni orden que importe. -->
    <CardEditorModal useI18n={useI18n} tr={trf} />
    <HelpModal useI18n={useI18n} tr={trf} />
    <PresetsModal useI18n={useI18n} tr={trf} />
    <TotpSetupModal useI18n={useI18n} tr={trf} />
    <TokenCreatedModal useI18n={useI18n} tr={trf} />
  </div>

  <!-- Alpine.js + Sortable + dashboard logic -->
  <script is:inline define:vars={{ initialConfig: clientConfig, demoAvailableIcons, themePresetI18n: THEME_PRESET_I18N, helpLocale: locale, FEATURE_LIST, labels: I18N_LABELS }}>
    // Mirror trustedProxies (array) into a text form so the textarea can edit it.
    initialConfig.security.network.trustedProxiesText = (initialConfig.security.network.trustedProxies || []).join('\n');
    // Si el config legacy no tiene `features`, lo inicializamos como objeto
    // vacío (cada feature tendrá default {enabled:false} al renderizar).
    if (!initialConfig.features) initialConfig.features = {};
    if (!initialConfig.oidc) initialConfig.oidc = { providers: [] };
    if (!initialConfig.apiTokens) initialConfig.apiTokens = { items: [] };
    if (!initialConfig.portals) initialConfig.portals = { defaultPortal: 'default', items: [] };
    // expose config to adminApp data
    window.__initialConfig = initialConfig;
    if (demoAvailableIcons) window.__availableIcons = demoAvailableIcons;
    window.__helpLocale = helpLocale;
    window.__featureList = FEATURE_LIST;
    window.__themePresetI18n = themePresetI18n;
    window.__labels = labels;
  </script>
  <script>
    import Alpine from 'alpinejs';
    import Sortable from 'sortablejs';
    import { installSortableGuard } from '~/lib/sortable-guard';
    import { isSystemCard as checkSystemCard, restoreSystemCardProtectedFields } from '~/lib/system-card';
    // Fragmentos del objeto Alpine, uno por dominio. Ver src/scripts/admin/.
    import { createOidcState } from '~/scripts/admin/oidc';
    import { createTokensState } from '~/scripts/admin/tokens';
    import { createPortalsState } from '~/scripts/admin/portals';
    import { createTotpState } from '~/scripts/admin/totp';
    import { createMetricsState } from '~/scripts/admin/metrics';
    import { createWebhooksState } from '~/scripts/admin/webhooks';
    import { createMaintenanceState } from '~/scripts/admin/maintenance';
    import { createAuditState } from '~/scripts/admin/audit';
    import { createUsersState } from '~/scripts/admin/users';
    import { createLabelsState } from '~/scripts/admin/labels';
    import { createThemeState } from '~/scripts/admin/theme';
    import { createIconPacksState } from '~/scripts/admin/icon-packs';
    import { createAssetsState } from '~/scripts/admin/assets';
    import { createStatusState } from '~/scripts/admin/status';
    import { createCardsState } from '~/scripts/admin/cards';
    import { createAiState } from '~/scripts/admin/ai';
    import { createHelpState } from '~/scripts/admin/help';
    import { createLayoutState } from '~/scripts/admin/layout';
    import { createPasswordState } from '~/scripts/admin/password';
    import { createBackupState } from '~/scripts/admin/backup';
    installSortableGuard(Sortable);
    window.Alpine = Alpine;
    window.Sortable = Sortable;

    Alpine.data('adminApp', () => ({
        tab: 'cards',
        themeSection: 'presets',
        ...createLayoutState(),
        ...createCardsState(),
        ...createThemeState(),
        ...createLabelsState(),
        ...createAiState(),
        ...createHelpState(),
        ...createStatusState(),
        ...createOidcState(),
        ...createTokensState(),
        ...createPortalsState(),
        ...createTotpState(),
        ...createMetricsState(),
        ...createUsersState(),
        ...createWebhooksState(),
        ...createMaintenanceState(),
        ...createAuditState(),
        cfg: window.__initialConfig || null,
        original: null,
        dirty: false,
        busy: false,
        ...createAssetsState(),
        // isDemoMode: el build se hizo con UMBRAL_DEMO=true (GitHub Pages).
        // Lo usamos para condicionar UI: el switch de QR queda bloqueado
        // (porque requiere el backend Node) y se muestra un banner
        // explicativo al lado de la feature.
        isDemoMode: typeof window !== 'undefined' && window.__UMBRAL_DEMO__ === true,
        featureList: window.__featureList || [],
        csrfToken: (document.body.dataset.csrf || ''),
        ...createPasswordState(),
        async init() {
          this.cfg = JSON.parse(JSON.stringify(window.__initialConfig));
          this.original = JSON.parse(JSON.stringify(window.__initialConfig));
          // Sin await: la lista de tarjetas es el tab inicial y necesita el
          // catálogo para dibujar sus íconos, pero el resto del init no
          // depende de él.
          this.ensureAvailableIcons();
          // Banner de password inseguro (default). Llamamos al endpoint
          // /api/auth/check-default-password; si isDefault=true, mostramos
          // un banner rojo en la parte superior del dashboard con un link
          // al tab Password. El server ya validó que el password es uno
          // de los default comunes (admin, changeme, etc).
          try {
            const r = await window.umbralAdmin.api('GET', '/api/auth/check-default-password');
            if (r?.isDefault) this.showDefaultPasswordBanner();
          } catch { /* silent — banner es nice-to-have */ }
          // BUGFIX (regresión reportada por el user): si el server arrancó
          // con un config viejo (sin `ai` ni otras secciones nuevas) y por
          // algún motivo el cache devolvió un cfg sin `ai`, Alpine tira
          // "Cannot read properties of undefined (reading 'enabled')" en
          // cada binding del tab IA. Rellenamos con defaults del lado del
          // cliente como red de seguridad: el server también lo hace (ver
          // loadFresh), pero esto evita la cascada de errores en lo que el
          // cache se refresca.
          if (!this.cfg.ai) this.cfg.ai = { enabled: false, provider: 'openai-compatible', baseUrl: 'https://api.openai.com/v1', apiKey: '', model: 'gpt-4o-mini', systemPrompt: '', language: 'es' };
          // Mismo fallback para externalSearch.
          if (!this.cfg.externalSearch) this.cfg.externalSearch = { braveApiKey: '', tavilyApiKey: '' };
          // Por si el cache tiene un cfg.ai sin el campo `language` (cards
          // viejas previas a este commit), lo rellenamos con 'es' (default).
          if (!this.cfg.ai.language) this.cfg.ai.language = 'es';
          // Mismo fallback para los widgets nuevos del theme (no deberían
          // faltar porque el schema llena defaults, pero por si el cache
          // quedó stale durante un rolling update).
          if (typeof this.cfg.theme.showClock !== 'boolean') this.cfg.theme.showClock = false;
          if (typeof this.cfg.theme.showRefresh !== 'boolean') this.cfg.theme.showRefresh = false;
          if (typeof this.cfg.theme.showStatusBar !== 'boolean') this.cfg.theme.showStatusBar = false;
          if (typeof this.cfg.theme.groupLayout !== 'string') this.cfg.theme.groupLayout = 'vertical';
          this.ensureThemeDefaults();
          this.parseGradientFromBackground();
          this.syncThemePreviewStorage();
          if (typeof this.cfg.layout.healthCheckInterval !== 'number') this.cfg.layout.healthCheckInterval = 60;
          this.iconPacks = this.seedIconPacksCatalog();
          // Defer refreshAssets until after the page's umbralAdmin is defined.
          // AdminLayout's inline script defines it; this module script may run
          // before or after that depending on Vite's module loading order.
          if (window.umbralAdmin) {
            await this.refreshAssets();
          } else {
            // Retry a few times in case the inline script hasn't parsed yet.
            for (let i = 0; i < 5 && !window.umbralAdmin; i++) {
              await new Promise((r) => setTimeout(r, 20));
            }
            if (window.umbralAdmin) await this.refreshAssets();
          }
          this.$nextTick(() => this.initSortable());
          // Auto-mark dirty on any cfg change. x-model alone doesn't fire markDirty,
          // so we deep-watch cfg and re-check after each mutation. Cheap because
          // we only stringify when something actually changes.
          this.$watch(() => JSON.stringify(this.cfg), () => {
            this.markDirty();
            this.syncThemePreviewStorage();
          });
          this.$watch('themePreviewMode', () => {
            this.syncThemePreviewStorage();
          });
          // Las animaciones no se pueden "ver" en un CSS que ya está aplicado:
          // hay que volver a montar los elementos para que arranquen de nuevo.
          // Bumpear la revisión del preview lo hace, así cada cambio de un
          // control se reproduce al toque en la miniatura.
          this.$watch(() => JSON.stringify(this.cfg.theme.animations), () => {
            this.themePreviewRev++;
          });
          // Auto-detectar el preset de IA según el baseUrl actual. Si el user
          // tenía OpenAI y eligió OpenAI en el preset, o si su config actual
          // matchea un preset, lo dejamos pre-seleccionado.
          this.aiPreset = this.currentPresetId();
          // Si el user cambia baseUrl a mano, sincronizamos el dropdown.
          this.$watch('cfg.ai.baseUrl', () => {
            const matched = this.currentPresetId();
            if (matched !== this.aiPreset) this.aiPreset = matched;
          });
          // Markdown preview: refresh debounced cuando cambia la descripción
          // o el format. Si la feature está apagada, no hace nada.
          if (this.markdownEnabled) {
            let mdTimer = null;
            const schedule = () => {
              if (mdTimer) clearTimeout(mdTimer);
              mdTimer = setTimeout(() => this.refreshMarkdownPreview(), 300);
            };
            this.$watch('editingCard.description', () => {
              if (this.editingCard?.descriptionFormat === 'markdown') schedule();
            });
            this.$watch('editingCard.descriptionFormat', () => schedule());
          }
          // Audit log: cargar cuando el user abre el tab Auditoría y la
          // feature está activa. Una sola carga — el user puede refrescar
          // manualmente con los filtros.
          this.$watch('tab', (t) => {
            if (t === 'cards') {
              this.$nextTick(() => this.initCardSortables());
            }
            if (t === 'audit' && this.auditEntries.length === 0 && !this.auditLoading) {
              this.loadAuditActions();
              this.reloadAudit();
            }
            if (t === 'metrics' && this.metricsRows.length === 0 && !this.metricsLoading) {
              this.loadMetrics();
            }
            if (t === 'ai') {
              this.ensureAiMeta();
            }
            if (t === 'iconpacks' && this.iconPacks.length === 0 && !this.iconPacksLoading) {
              this.loadIconPacks();
            }
          });
          if (this.tab === 'iconpacks' && this.iconPacks.length === 0 && !this.iconPacksLoading) {
            this.loadIconPacks();
          }
          this.$watch('cardFilter', () => {
            if (this.tab === 'cards') {
              this.$nextTick(() => this.initCardSortables());
            }
          });
          setInterval(() => { this.themePreviewClockTick++; }, 1000);
        },

        markDirty() { this.dirty = JSON.stringify(this.cfg) !== JSON.stringify(this.original); },

        async saveAll() {
          this.busy = true;
          try {
            const payload = JSON.parse(JSON.stringify(this.cfg));
            if (this.original?.cards) {
              for (const card of payload.cards || []) {
                if (!checkSystemCard(card)) continue;
                const orig = this.original.cards.find((c) => c.id === card.id);
                if (orig) restoreSystemCardProtectedFields(card, orig);
              }
            }
            if (payload.security?.network) {
              payload.security.network.trustedProxies = (payload.security.network.trustedProxiesText || '')
                .split('\n').map((s) => s.trim()).filter(Boolean);
              delete payload.security.network.trustedProxiesText;
            }
            if (this.cfg.security?.network) {
              this.cfg.security.network.trustedProxies = (this.cfg.security.network.trustedProxiesText || '')
                .split('\n').map((s) => s.trim()).filter(Boolean);
            }
            const markdownOn = this.cfg?.features?.markdown?.enabled === true;
            let clampedCount = 0;
            for (const card of payload.cards || []) {
              if (typeof card.description !== 'string') continue;
              if (!markdownOn) {
                if (card.descriptionFormat !== 'plain') {
                  card.descriptionFormat = 'plain';
                }
                if (card.description.length > 200) {
                  card.description = card.description.slice(0, 200);
                  clampedCount++;
                }
              } else {
                const limit = card.descriptionFormat === 'markdown' ? 1000 : 200;
                if (card.description.length > limit) {
                  card.description = card.description.slice(0, limit);
                  clampedCount++;
                }
              }
            }
            const updated = await window.umbralAdmin.api('PUT', '/api/config', payload);
            if (updated.security?.network) {
              updated.security.network.trustedProxiesText = (updated.security.network.trustedProxies || []).join('\n');
            }
            this.cfg = JSON.parse(JSON.stringify(updated));
            this.original = JSON.parse(JSON.stringify(updated));
            this.dirty = false;
            if (clampedCount > 0) {
              const tmpl = this.l('toastSavedClamped');
              window.umbralAdmin.toast(tmpl.replace('{n}', String(clampedCount)), 'info');
            } else {
              window.umbralAdmin.toast(this.l('toastSaved'), 'success');
            }
            if (this.isFeatureOn('iconPacks')) {
              await this.loadIconPacks();
            }
            await this.refreshAssets();
          } catch (e) {
            const tmpl = this.l('toastError');
            window.umbralAdmin.toast(tmpl.replace('{message}', e.message), 'error');
          } finally {
            this.busy = false;
          }
        },

        async reloadConfig() {
          if (this.dirty && !confirm('Hay cambios sin guardar. ¿Recargar igual?')) return;
          try {
            const cfg = await window.umbralAdmin.api('GET', '/api/config');
            this.cfg = JSON.parse(JSON.stringify(cfg));
            this.original = JSON.parse(JSON.stringify(cfg));
            this.dirty = false;
            window.umbralAdmin.toast(this.l('toastReloaded'), 'success');
          } catch (e) {
            const tmpl = this.l('toastError');
            window.umbralAdmin.toast(tmpl.replace('{message}', e.message), 'error');
          }
        },

        // ── Feature flags ────────────────────────────────────────
        // Helpers para el switch de la sección Features (tab Avanzado).
        // El switch togglea el flag en cfg.features[name].enabled y marca
        // `dirty` para que "Guardar cambios" persista. El backend también
        // valida y loguea cada toggle en el audit log con diff.
        isFeatureOn(name) {
          const features = (this.cfg ?? window.__initialConfig)?.features;
          if (!features) return false;
          const flag = features[name];
          return flag && typeof flag === 'object' && flag.enabled === true;
        },

        async toggleFeature(name, enabled) {
          if (!this.cfg.features) this.cfg.features = {};
          if (!this.cfg.features[name]) {
            this.cfg.features[name] = { enabled: false };
          }
          this.cfg.features[name].enabled = enabled;
          if (name === 'ai') {
            if (!this.cfg.ai) this.cfg.ai = { enabled, provider: 'openai-compatible', baseUrl: 'https://api.openai.com/v1', apiKey: '', model: 'gpt-4o-mini', systemPrompt: '', language: 'es' };
            else this.cfg.ai.enabled = enabled;
          }
          this.dirty = true;
        },

        ...createBackupState(),
        ...createIconPacksState(),
        helpTooltipLabel() {
          return this.l('helpTooltip');
        },
    }));

    Alpine.start();
  </script>

