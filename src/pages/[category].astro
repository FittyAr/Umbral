---
import PublicLayout from '~/layouts/PublicLayout.astro';
import CategoryGroup from '~/components/CategoryGroup.astro';
import ModeToggle from '~/components/ModeToggle.astro';
import Search from '~/components/Search.astro';
import Logo from '~/components/Logo.astro';
import Clock from '~/components/Clock.astro';
import RefreshButton from '~/components/RefreshButton.astro';
import StatusBar from '~/components/StatusBar.astro';
import LanguageSwitcher from '~/components/LanguageSwitcher.astro';
import { getConfig } from '~/lib/config';
import { resolveIconUrl } from '~/lib/icon-url';
import { isFeatureEnabled } from '~/lib/features';
import { getActiveWindowsForCards } from '~/lib/maintenance';
import { buildHealthLabels } from '~/lib/health-labels';
import { t as tr, resolveLocale, readLocaleCookie, type Locale } from '~/i18n';

export const prerender = false;

const { category } = Astro.params;
const config = await getConfig();
const t = config.theme;
const l = config.layout;

const useI18n = isFeatureEnabled(config, 'i18n');
const locale: Locale = useI18n
  ? resolveLocale(Astro.request, config, readLocaleCookie(Astro.request))
  : 'es';
const trf = tr(locale);

// Sólo las categorías marcadas como subpágina tienen página propia.
const cat = config.categories.find((c) => c.id === category && c.isSubpage);
if (!cat) {
  return new Response(null, { status: 404 });
}

const cards = config.cards
  .filter((c) => c.category === cat.id && c.enabled)
  // pinned primero, después order ASC. Mismo criterio que la portada
  // (opt-in: features.pinned; si está apagada el server fuerza pinned=false).
  .sort((a, b) => {
    if (a.pinned && !b.pinned) return -1;
    if (!a.pinned && b.pinned) return 1;
    return a.order - b.order;
  });

const cardMaintenance = await getActiveWindowsForCards(cards.map((c) => c.id));
const qrEnabled = isFeatureEnabled(config, 'qr');
const metricsEnabled = isFeatureEnabled(config, 'metrics');
const markdownEnabled = isFeatureEnabled(config, 'markdown');
const iconTint = t.iconTint ?? 'original';
const noteBadge = trf('home.card.noteBadge');
const logoUrl = resolveIconUrl(config.branding.logo);
const healthLabels = buildHealthLabels(useI18n, trf);
const pageTitle = `${cat.name} — ${config.branding.companyName}`;
const base = import.meta.env.BASE_URL || '/';
---
<PublicLayout config={config} title={pageTitle}>
  <main
    class="page-wrap"
    data-grid-align={l.gridAlign}
    data-compact={l.compact ? 'true' : 'false'}
    data-health-config
    data-health-interval={String(l.healthCheckInterval)}
    data-health-metrics={metricsEnabled ? 'true' : 'false'}
    data-health-checking={healthLabels.checking}
    data-health-ok={healthLabels.ok}
    data-health-bad={healthLabels.bad}
    data-health-fetch-error={healthLabels.fetchError}
  >
    <header class="header">
      <div class="subpage-header-group">
        <a href={base} class="subpage-back-link" title={useI18n ? trf('home.subpage.back') : 'Volver a la portada principal'}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          <span>{useI18n ? trf('home.subpage.back') : 'Portada principal'}</span>
        </a>
        <span class="subpage-header-sep" aria-hidden="true">|</span>
        <Logo src={logoUrl} alt={config.branding.companyName} fallbackName={config.branding.companyName} />
        <h1 class="header-title">{config.branding.companyName}</h1>
      </div>

      {t.showClock && <Clock config={config} request={Astro.request} />}
      <Search config={config} request={Astro.request} />
      {t.showRefresh && <RefreshButton config={config} request={Astro.request} />}
      {useI18n && <LanguageSwitcher config={config} current={locale} />}
      <ModeToggle useI18n={useI18n} tr={trf} />
    </header>

    <div class="subpage-breadcrumb">
      <a href={base}>{useI18n ? trf('home.subpage.home') : 'Inicio'}</a>
      <span>/</span>
      <span>{cat.name}</span>
    </div>

    <CategoryGroup
      catId={cat.id}
      cat={cat}
      cards={cards}
      layout={l}
      cardStyle={t.cardStyle}
      cardMaintenance={cardMaintenance}
      qrEnabled={qrEnabled}
      noteBadge={noteBadge}
      iconTint={iconTint}
      markdownEnabled={markdownEnabled}
      useI18n={useI18n}
      trf={trf}
      pageTitle
    />

    {t.showStatusBar && <StatusBar config={config} />}
  </main>
</PublicLayout>

<script>
  // Misma lógica que la portada, mismos módulos. Antes esto eran ~240 líneas
  // copiadas, y la copia había divergido: textos de salud sin traducir y el
  // refresh pegándole a `/api/config` absoluto (roto bajo subpath).
  import { initCategoryLocks } from '~/scripts/public/category-lock';
  import { initHealthDots } from '~/scripts/public/health-dots';

  initCategoryLocks();
  initHealthDots();
</script>
