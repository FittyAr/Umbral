# Copy to .env and customize. Used by docker-compose.
#
# En legacy/ usamos el mismo .env.example que en la raíz para mantener el
# patrón de trabajo del proyecto: cada instalación tiene su propio .env al
# lado del docker-compose.yml que la corre.

# External port (host): container port 4321
PORT=3000

# SESSION_SECRET must be at least 32 chars in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-please-this-is-32-chars-or-more

# Initial admin password. Hashed and stored on first boot.
# Leave empty to fall back to default "admin" (warning logged).
INITIAL_PASSWORD=

# Full base URL (optional). When set with https://, cookies get Secure flag.
# BASE_URL=https://home.example.internal
